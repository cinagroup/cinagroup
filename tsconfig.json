{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": [".astro/types.d.ts", "astro.config.ts", "src/**/*", "vendor/**/*"],
  "exclude": ["dist/", "node_modules/", ".astro/"]
}
