{
  "enabled": true,
  "encryption": {
    "enabled": true,
    "algorithm": "aes-256-cbc",
    "password_env": "MEMORY_BACKUP_PASSWORD"
  },
  "destinations": {
    "local": {
      "enabled": true,
      "path": "/root/.openclaw/workspace/.backups/memory"
    },
    "github": {
      "enabled": false,
      "repo": "username/memory-backup",
      "branch": "main",
      "path": "backups/"
    },
    "s3": {
      "enabled": false,
      "bucket": "my-memory-backup",
      "region": "us-east-1",
      "path": "openclaw/memory/"
    },
    "webdav": {
      "enabled": false,
      "url": "https://dav.example.com",
      "path": "/openclaw/memory"
    }
  },
  "retention": {
    "daily": 7,
    "weekly": 4,
    "monthly": 12
  },
  "schedule": {
    "auto_backup": true,
    "interval_hours": 24
  }
}
