---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(23 23 23);
    --aw-color-secondary: rgb(77 77 77);
    --aw-color-accent: rgb(0 112 243);

    --aw-color-text-heading: rgb(23 23 23);
    --aw-color-text-default: rgb(23 23 23);
    --aw-color-text-muted: rgb(77 77 77);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(23 23 23);

    --cg-ink: #171717;
    --cg-body: #4d4d4d;
    --cg-muted: #666666;
    --cg-hairline: #ebebeb;
    --cg-hairline-strong: #a1a1a1;
    --cg-canvas: #ffffff;
    --cg-canvas-soft: #fafafa;
    --cg-canvas-soft-2: #f5f5f5;
    --cg-on-primary: #ffffff;
    --cg-link: #0070f3;
    --cg-shadow-1: inset 0 0 0 1px rgb(0 0 0 / 8%);
    --cg-shadow-2: 0 1px 1px rgb(0 0 0 / 2%), 0 2px 2px rgb(0 0 0 / 4%), inset 0 0 0 1px rgb(0 0 0 / 8%);
    --cg-shadow-3: 0 2px 2px rgb(0 0 0 / 4%), 0 8px 16px -8px rgb(0 0 0 / 8%), inset 0 0 0 1px rgb(0 0 0 / 8%);

    ::selection {
      background-color: var(--cg-ink);
      color: #f2f2f2;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(245 245 245);
    --aw-color-secondary: rgb(183 183 183);
    --aw-color-accent: rgb(82 168 255);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(10 10 10);
    --aw-color-bg-page-dark: rgb(5 5 5);

    --cg-ink: #f5f5f5;
    --cg-body: #b7b7b7;
    --cg-muted: #8f8f8f;
    --cg-hairline: #2a2a2a;
    --cg-hairline-strong: #4a4a4a;
    --cg-canvas: #0a0a0a;
    --cg-canvas-soft: #111111;
    --cg-canvas-soft-2: #171717;
    --cg-on-primary: #0a0a0a;
    --cg-link: #52a8ff;
    --cg-shadow-1: inset 0 0 0 1px rgb(255 255 255 / 10%);
    --cg-shadow-2: 0 1px 1px rgb(0 0 0 / 24%), 0 2px 4px rgb(0 0 0 / 20%), inset 0 0 0 1px rgb(255 255 255 / 10%);
    --cg-shadow-3:
      0 2px 2px rgb(0 0 0 / 24%), 0 12px 28px -16px rgb(0 0 0 / 72%), inset 0 0 0 1px rgb(255 255 255 / 10%);
    color-scheme: dark;

    ::selection {
      background-color: #f5f5f5;
      color: #0a0a0a;
    }
  }

  html {
    color-scheme: light;
    scroll-behavior: smooth;
  }

  body {
    background: var(--cg-canvas);
    color: var(--cg-body);
    font-family: var(--aw-font-sans);
    font-feature-settings: 'ss01', 'ss02';
  }

  :where(h1, h2, h3, h4, h5, h6) {
    color: var(--cg-ink);
    font-family: var(--aw-font-heading);
    font-weight: 600;
  }

  :where(a, button, input, select, textarea) {
    outline-color: var(--cg-link);
  }

  :where(a):focus-visible,
  :where(button, input, select, textarea):focus-visible {
    outline: 2px solid var(--cg-link);
    outline-offset: 3px;
  }

  #header {
    min-height: 64px;
    border-bottom: 1px solid var(--cg-hairline);
    background: rgb(255 255 255 / 92%);
    color: var(--cg-ink);
    backdrop-filter: blur(16px);
  }

  .dark #header {
    background: rgb(10 10 10 / 92%);
  }

  #header > div:nth-child(2) {
    min-height: 64px;
    padding-top: 8px;
    padding-bottom: 8px;
  }

  #header nav a,
  #header nav button {
    color: var(--cg-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.28px;
  }

  #header nav a:hover,
  #header nav button:hover,
  #header nav .aw-link-active {
    color: var(--cg-ink);
    background: var(--cg-canvas-soft-2);
  }

  #header .dropdown-menu,
  #language-dropdown {
    border: 1px solid var(--cg-hairline);
    border-radius: 8px;
    background: var(--cg-canvas);
    box-shadow:
      0 1px 1px rgb(0 0 0 / 2%),
      0 8px 16px -4px rgb(0 0 0 / 6%),
      0 24px 32px -8px rgb(0 0 0 / 6%);
  }

  #header .btn {
    min-height: 32px;
    padding: 6px 12px;
    border-color: var(--cg-hairline);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  #header .btn-primary {
    border-color: var(--cg-ink);
    background: var(--cg-ink);
    color: var(--cg-on-primary);
  }

  footer {
    border-color: var(--cg-hairline) !important;
    background: var(--cg-canvas);
    color: var(--cg-body);
  }

  footer :where(a, div, span) {
    color: inherit;
  }

  footer .font-medium {
    color: var(--cg-ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .cg-page {
    background: var(--cg-canvas);
    color: var(--cg-body);
  }

  .cg-page-shell {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }

  .cg-page-hero {
    position: relative;
    overflow: hidden;
    padding: 128px 0 96px;
    text-align: center;
    background: var(--cg-canvas);
    border-bottom: 1px solid var(--cg-hairline);
  }

  .cg-page-hero-art {
    position: absolute;
    inset: 0;
    opacity: 0.28;
    pointer-events: none;
  }

  .cg-page-hero-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent, var(--cg-canvas) 88%);
  }

  .dark .cg-page-hero-art {
    opacity: 0.22;
    filter: brightness(0.72) saturate(1.08);
  }

  .cg-page-hero > .cg-page-shell {
    position: relative;
    z-index: 1;
  }

  .cg-eyebrow {
    margin: 0 0 16px;
    color: var(--cg-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
  }

  .cg-page-hero h1 {
    max-width: 920px;
    margin: 0 auto;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .cg-page-lead {
    max-width: 720px;
    margin: 24px auto 0;
    color: var(--cg-body);
    font-size: 18px;
    line-height: 28px;
  }

  .cg-page-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .cg-page-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border: 1px solid var(--cg-hairline);
    border-radius: 100px;
    background: var(--cg-canvas);
    color: var(--cg-ink);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    text-decoration: none;
    box-shadow: var(--cg-shadow-2);
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .cg-page-button:hover {
    border-color: var(--cg-hairline-strong);
    background: var(--cg-canvas-soft);
    transform: translateY(-1px);
  }

  .cg-page-button-primary {
    border-color: var(--cg-ink);
    background: var(--cg-ink);
    color: var(--cg-on-primary);
    box-shadow: none;
  }

  .cg-page-button-primary:hover {
    border-color: var(--cg-hairline-strong);
    background: var(--cg-ink);
  }

  .cg-page-section {
    padding: 96px 0;
    border-bottom: 1px solid var(--cg-hairline);
  }

  .cg-page-section-soft {
    background: var(--cg-canvas-soft);
  }

  .cg-page-section-dark {
    border-color: #171717;
    background: #171717;
    color: #d4d4d4;
  }

  .cg-page-section-dark :where(h2, h3, a) {
    color: white;
  }

  .cg-section-heading {
    max-width: 680px;
    margin-bottom: 48px;
  }

  .cg-section-heading-center {
    margin-right: auto;
    margin-left: auto;
    text-align: center;
  }

  .cg-section-heading h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .cg-section-heading > p:last-child {
    margin: 16px 0 0;
    font-size: 18px;
    line-height: 28px;
  }

  .cg-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .cg-card {
    min-height: 100%;
    padding: 32px;
    border-radius: 12px;
    background: var(--cg-canvas);
    color: var(--cg-body);
    box-shadow: var(--cg-shadow-3);
  }

  .cg-card h3 {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
    letter-spacing: -0.96px;
  }

  .cg-card p {
    margin: 0;
    line-height: 24px;
  }

  .cg-card .cg-card-meta {
    margin-bottom: 16px;
    color: var(--cg-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    line-height: 16px;
  }

  .cg-list-panel {
    border-radius: 12px;
    overflow: hidden;
    background: var(--cg-canvas);
    box-shadow: var(--cg-shadow-3);
  }

  .cg-list-row {
    display: grid;
    grid-template-columns: minmax(160px, 0.8fr) minmax(0, 2fr);
    gap: 24px;
    padding: 24px 32px;
    border-bottom: 1px solid var(--cg-hairline);
  }

  .cg-list-row:last-child {
    border-bottom: 0;
  }

  .cg-list-row strong {
    color: var(--cg-ink);
    font-weight: 500;
  }

  .cg-code-panel {
    margin: 0;
    padding: 32px;
    border-radius: 12px;
    overflow: auto;
    background: #111111;
    color: #f5f5f5;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 20px;
    box-shadow: var(--cg-shadow-3);
  }

  .cg-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 24px;
  }

  .cg-price-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 32px;
    border-radius: 12px;
    background: var(--cg-canvas);
    color: var(--cg-body);
    box-shadow: var(--cg-shadow-3);
  }

  .cg-price-card h3 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.96px;
  }

  .cg-price-disclosure {
    display: grid;
    gap: 12px;
    margin-top: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--cg-hairline);
    border-bottom: 1px solid var(--cg-hairline);
  }

  .cg-price-disclosure dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .cg-price-disclosure dl > div {
    display: grid;
    grid-template-columns: minmax(112px, 0.8fr) minmax(0, 1.2fr);
    gap: 12px;
  }

  .cg-price-disclosure dt {
    color: var(--cg-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 20px;
  }

  .cg-price-disclosure dd {
    margin: 0;
    color: var(--cg-ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
  }

  .cg-price-disclosure p {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
  }

  .cg-price-disclosure strong {
    color: var(--cg-ink);
    font-weight: 600;
  }

  .cg-pricing-terms {
    max-width: 920px;
    margin: 28px auto 0;
    color: var(--cg-muted);
    font-size: 13px;
    line-height: 20px;
    text-align: center;
  }

  .cg-price-card ul {
    display: grid;
    gap: 12px;
    margin: 32px 0;
    padding: 0;
    list-style: none;
  }

  .cg-price-card li {
    position: relative;
    padding-left: 20px;
    font-size: 14px;
    line-height: 20px;
  }

  .cg-price-card li::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--cg-link);
  }

  .cg-price-card .cg-page-button {
    width: 100%;
    margin-top: auto;
  }

  .cg-price-card-featured {
    background: #171717;
    color: #d4d4d4;
    box-shadow: none;
  }

  .cg-price-card-featured :where(h3, .cg-card-meta) {
    color: white;
  }

  .cg-price-card-featured .cg-price-disclosure {
    border-color: #404040;
  }

  .cg-price-card-featured .cg-price-disclosure :where(dd, strong) {
    color: white;
  }

  .cg-price-card-featured .cg-price-disclosure dt {
    color: #a3a3a3;
  }

  .cg-price-card-featured .cg-page-button {
    border-color: white;
    background: white;
    color: var(--cg-ink);
  }

  .cg-product-evidence {
    background: var(--cg-canvas-soft);
  }

  .cg-product-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
    padding: 20px 24px;
    border: 1px solid var(--cg-hairline);
    border-radius: 12px;
    background: var(--cg-canvas);
    box-shadow: var(--cg-shadow-2);
  }

  .cg-product-status p {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
  }

  .cg-status-badge {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    min-height: 28px;
    padding: 4px 10px;
    border: 1px solid var(--cg-hairline-strong);
    border-radius: 999px;
    background: var(--cg-canvas-soft-2);
    color: var(--cg-ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 20px;
  }

  .cg-evidence-verified {
    margin-left: auto !important;
    color: var(--cg-muted);
    font-size: 13px !important;
    white-space: nowrap;
  }

  .cg-evidence-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .cg-evidence-card {
    padding: 28px;
    border: 1px solid var(--cg-hairline);
    border-radius: 12px;
    background: var(--cg-canvas);
    box-shadow: var(--cg-shadow-2);
  }

  .cg-evidence-card h3 {
    margin: 0;
    font-size: 20px;
    line-height: 28px;
  }

  .cg-evidence-card ul {
    display: grid;
    gap: 12px;
    margin: 20px 0 0;
    padding-left: 20px;
  }

  .cg-evidence-card li {
    padding-left: 4px;
    font-size: 14px;
    line-height: 22px;
  }

  .cg-product-preview {
    margin-top: 24px;
    border: 1px solid var(--cg-hairline);
    border-radius: 12px;
    overflow: hidden;
    background: var(--cg-canvas);
    box-shadow: var(--cg-shadow-3);
  }

  .cg-product-preview-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding: 24px 28px;
    border-bottom: 1px solid var(--cg-hairline);
  }

  .cg-product-preview-heading .cg-card-meta {
    margin: 0 0 6px;
    color: var(--cg-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 20px;
  }

  .cg-product-preview-heading h3 {
    margin: 0;
    font-size: 20px;
    line-height: 28px;
    text-transform: capitalize;
  }

  .cg-product-preview-heading > p {
    max-width: 520px;
    margin: 0;
    color: var(--cg-muted);
    font-size: 14px;
    line-height: 22px;
    text-align: right;
  }

  .cg-product-preview-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--cg-hairline);
  }

  .cg-product-preview-step {
    position: relative;
    display: grid;
    gap: 8px;
    min-height: 132px;
    align-content: center;
    padding: 24px 28px;
    background: var(--cg-canvas);
  }

  .cg-product-preview-step span {
    color: var(--cg-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    line-height: 18px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .cg-product-preview-step strong {
    color: var(--cg-ink);
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
  }

  .cg-evidence-sources {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-top: 24px;
    color: var(--cg-muted);
    font-size: 14px;
    line-height: 22px;
  }

  .cg-evidence-sources > strong {
    flex: 0 0 auto;
    color: var(--cg-ink);
    font-weight: 600;
  }

  .cg-evidence-sources > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .cg-evidence-sources a {
    color: var(--cg-link);
    text-underline-offset: 3px;
  }

  .cg-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.8fr);
    gap: 64px;
    align-items: start;
  }

  .cg-form-card {
    display: grid;
    gap: 20px;
    padding: 32px;
    border-radius: 12px;
    background: var(--cg-canvas-soft);
    box-shadow: var(--cg-shadow-3);
  }

  .cg-field {
    display: grid;
    gap: 8px;
  }

  .cg-field label {
    color: var(--cg-ink);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  .cg-field label span,
  .cg-form-note {
    color: var(--cg-muted);
    font-weight: 400;
  }

  .cg-field :where(input, select, textarea) {
    width: 100%;
    border: 1px solid var(--cg-hairline);
    border-radius: 6px;
    background: var(--cg-canvas);
    color: var(--cg-ink);
    font: inherit;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 1%);
  }

  .cg-field :where(input, select) {
    min-height: 44px;
    padding: 0 12px;
  }

  .cg-field textarea {
    min-height: 152px;
    padding: 12px;
    resize: vertical;
  }

  .cg-form-card > .cg-page-button {
    width: 100%;
  }

  .cg-form-note,
  .cg-form-status {
    margin: 0;
    font-size: 12px;
    line-height: 18px;
    text-align: center;
  }

  .cg-form-note a {
    color: var(--cg-link);
    text-decoration: underline;
  }

  .cg-form-status {
    color: var(--cg-link);
  }

  .cg-prose {
    max-width: 760px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 1.75;
  }

  .cg-prose :where(h2, h3) {
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .cg-prose h2 {
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -1.28px;
  }

  .cg-prose h3 {
    font-size: 20px;
    line-height: 28px;
    letter-spacing: -0.6px;
  }

  .cg-prose a {
    color: var(--cg-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cg-prose :where(p, li, td) {
    color: var(--cg-body);
  }

  .cg-prose :where(blockquote) {
    margin: 32px 0;
    border-left: 3px solid var(--cg-hairline-strong);
    background: var(--cg-canvas-soft);
    padding: 20px 24px;
    color: var(--cg-body);
  }

  .cg-prose :where(table) {
    width: 100%;
    margin: 32px 0;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 20px;
  }

  .cg-prose :where(th, td) {
    border: 1px solid var(--cg-hairline);
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
  }

  .cg-prose :where(th) {
    background: var(--cg-canvas-soft);
    color: var(--cg-ink);
    font-weight: 500;
  }

  .cg-blog-index {
    width: min(100% - 48px, 960px);
    margin: 0 auto;
    padding: 96px 0;
  }

  .cg-blog-headline {
    max-width: 760px;
    margin-bottom: 64px;
  }

  .cg-blog-headline h1,
  .cg-blog-post h1 {
