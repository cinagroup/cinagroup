interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = copy[lang];
---

<Layout metadata={{ title: content.title, description: content.description }}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={content.eyebrow}
      title={content.heroTitle}
      lead={content.heroLead}
      primary={{ text: content.explore, href: '#products' }}
      secondary={{ text: content.contact, href: `/${lang}/contact` }}
    />

    <section id="products" class="cg-page-section" aria-labelledby="localized-home-products">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{content.productsEyebrow}</p>
          <h2 id="localized-home-products">{content.productsTitle}</h2>
          <p>{content.productsLead}</p>
        </div>
        <div class="cg-card-grid">
          {
            content.products.map((product) => (
              <article class="cg-card">
                <p class="cg-card-meta">{product.role}.</p>
                <h3>{product.name}</h3>
                <p>{product.description}</p>
                <a href={product.href}>{content.learn} →</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="localized-home-method">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{content.methodEyebrow}</p>
          <h2 id="localized-home-method">{content.methodTitle}</h2>
          <p>{content.methodLead}</p>
        </div>
        <div class="cg-card-grid">
          {
            content.methods.map((method, index) => (
              <article class="cg-card">
                <p class="cg-card-meta">0{index + 1}.</p>
                <h3>{method.title}</h3>
                <p>{method.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-dark" aria-labelledby="localized-home-next">
      <div class="cg-page-shell cg-section-heading cg-section-heading-center">
        <p class="cg-eyebrow">{content.nextEyebrow}</p>
        <h2 id="localized-home-next">{content.nextTitle}</h2>
        <p>{content.nextLead}</p>
        <div class="cg-page-actions">
          <a class="cg-page-button cg-page-button-primary" href={`/${lang}/contact`}>{content.contact}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
