---
import HeroSlider from '~/components/flexina/HeroSlider.astro';
import { Icon } from 'astro-icon/components';
import CMSImage from '~/components/CMSImage.astro';
import { getLocalizedLabel } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';
import { homeOrganizationStructuredData, loadHomeContent } from '~/emdash/home-content';
import { loadSitePresentation } from '~/emdash/site-presentation';
import { resolvePostSeoImage } from '~/emdash/post-seo-runtime';
import type { HomeLocale } from '~/data/site/home-defaults';

interface Props {
  lang: HomeLocale;
}

const { lang } = Astro.props;
const { content, isPreview, source: contentSource, cacheHint } = await loadHomeContent(lang);
if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
} else {
  Astro.cache?.set(cacheHint);
}
const presentation = await loadSitePresentation(Astro);
const seoImage = await resolvePostSeoImage(content.seo);
const contactHref = content.contactHref;
const icons = ['tabler:search', 'tabler:shield-lock', 'tabler:route', 'tabler:code', 'tabler:world'];
const label = (text: string) => getLocalizedLabel(lang, text);
const productHref = (href: string) => {
  const url = new URL(href, 'https://cinagroup.com');
  return `${url.pathname.replace(/\/+$/, '')}/${url.search}${url.hash}`;
};
---

<Layout
  metadata={{
    title: content.title,
    description: content.description,
    canonical: content.seo?.canonical,
    openGraph: seoImage ? { images: [{ url: seoImage }] } : undefined,
    robots: isPreview || content.noIndex ? { index: false, follow: false } : undefined,
    structuredData: homeOrganizationStructuredData(presentation),
  }}
>
  <div
    class="flexina-blocks"
    data-fx-home-motion
    data-marketing-template="flexina-original-port"
    data-site-content-source={contentSource}
  >
    <HeroSlider
      eyebrow={content.eyebrow}
      title={content.heroTitle}
      lead={content.heroLead}
      image={content.heroImage}
      primary={{ text: content.explore, href: content.exploreHref }}
      secondary={{ text: content.contact, href: contactHref }}
      slides={[
        {
          eyebrow: content.methodEyebrow,
          title: content.methodTitle,
          lead: content.methodLead,
          image: content.aboutImage,
        },
      ]}
    />
    <section class="fx-quick" aria-label={content.productsEyebrow}>
      <div class="container fx-quick-grid">
        {
          content.products.slice(0, 4).map((product, index) => (
            <a class="fx-quick-card" href={productHref(product.href)} data-fx-reveal data-fx-reveal-order={index}>
              <div class="fx-quick-inner">
                <span class="fx-outline-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="fx-round-icon">
                  <Icon name={icons[index % icons.length]} width={46} height={46} />
                </span>
                <>
                  <h2>{product.name}</h2>
                  <p>{product.role}</p>
                </>
                <span class="fx-round-arrow" aria-hidden="true">
                  <Icon name="tabler:arrow-up-right" width={25} height={25} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
    <section class="fx-about fx-section" data-fx-ambient>
      <div class="container fx-about-grid">
        <div class="fx-about-art" aria-hidden="true" data-fx-reveal>
          <div class="fx-about-media">
            <CMSImage
              image={content.aboutImage}
              fallback="/images/flexina/office-workspace.webp"
              class="fx-about-photo"
              alt=""
              aria-hidden="true"
              loading="lazy"
            />
          </div>
          <div class="fx-about-note">
            <Icon name="tabler:circles-relation" width={48} height={48} /><strong>{content.productsEyebrow}</strong
            ><span>{content.products.map((product) => product.name).join(' · ')}</span>
          </div>
          <CMSImage
            image={content.heroImage}
            fallback="/images/flexina/city-workspace.webp"
            class="fx-about-detail"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
        </div>
        <div class="fx-about-copy" data-fx-reveal data-fx-reveal-order="1">
          <p class="fx-eyebrow">{label('About')}</p>
          <h2 data-fx-title>{content.heroTitle}</h2><p>{content.heroLead}</p>
          <ul class="fx-about-list">
            {
              content.methods.map((method) => (
                <li>
                  <Icon name="tabler:circle-check" width={19} height={19} />
                  {method.title}
                </li>
              ))
            }
          </ul>
          <a href={content.aboutHref} class="btn btn-primary"
            ><span data-fx-button-label>{content.learn}</span><Icon
              name="tabler:arrow-up-right"
              width={20}
              height={20}
            /></a
          >
        </div>
      </div>
    </section>
    <section class="fx-products fx-section" id="products" aria-labelledby="products-title">
      <div class="container">
        <header class="fx-section-heading" data-fx-reveal>
          <p class="fx-eyebrow">{content.productsEyebrow}</p><h2 id="products-title" data-fx-title>
            {content.productsTitle}
          </h2><p>
            {content.productsLead}
          </p>
        </header>
        <div class="fx-product-grid">
          {
            content.products.map((product, index) => (
              <article class="fx-product-card" data-fx-reveal data-fx-reveal-order={index}>
                <>
                  <Icon name={icons[index % icons.length]} width={54} height={54} />
                  <h3>{product.name}</h3>
                  <p class="fx-product-role">{product.role}</p>
                  <p>{product.description}</p>
                  <a href={productHref(product.href)} class="btn btn-secondary">
                    <span data-fx-button-label>{content.learn}</span>
                    <Icon name="tabler:arrow-up-right" width={18} height={18} />
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="fx-photo-cta">
      <div class="container" data-fx-reveal>
        <p class="fx-eyebrow">{content.nextEyebrow}</p><h2>{content.nextTitle}</h2><p>{content.nextLead}</p><a
          class="btn btn-primary"
          href={contactHref}
          ><span data-fx-button-label>{content.contact}</span><Icon
            name="tabler:arrow-up-right"
            width={20}
            height={20}
          /></a
        >
      </div>
    </section>
    <section class="fx-process fx-section" id="approach" aria-labelledby="approach-title" data-fx-ambient>
      <div class="container">
        <header class="fx-section-heading" data-fx-reveal>
          <p class="fx-eyebrow">{content.methodEyebrow}</p><h2 id="approach-title" data-fx-title>
            {content.methodTitle}
          </h2><p>
            {content.methodLead}
          </p>
        </header>
        <ol class="fx-process-grid">
          {
            content.methods.map((method, index) => (
              <li data-fx-reveal data-fx-reveal-order={index}>
                <>
                  <span class="fx-process-number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3>{method.title}</h3>
                  <p>{method.description}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
    <section class="fx-final-cta">
      <div class="container" data-fx-reveal>
        <div><p>{content.nextEyebrow}</p><h2>{content.nextTitle}</h2></div><a
          class="btn btn-secondary"
          href={contactHref}
          ><span data-fx-button-label>{content.contact}</span><Icon
            name="tabler:arrow-up-right"
            width={20}
            height={20}
          /></a
        >
      </div>
    </section>
  </div>
</Layout>
