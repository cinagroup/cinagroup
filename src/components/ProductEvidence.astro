const { product, locale = 'en' } = Astro.props;
const copy = ui[locale];
const status = statusText[product];
const item = evidence[product];
const productName: Record<Product, string> = {
  cinaseek: 'CinaSeek',
  cinaclaw: 'CinaClaw',
  cinatoken: 'CinaToken',
  cinaskill: 'CinaSkill',
  cinachain: 'CinaChain',
};
const previewLabels = [copy.input, copy.control, copy.output];
const titleId = `product-evidence-${product}`;
---

<section class="cg-page-section cg-product-evidence" aria-labelledby={titleId}>
  <div class="cg-page-shell">
    <div class="cg-section-heading">
      <p class="cg-eyebrow">{copy.eyebrow}</p>
      <h2 id={titleId}>{copy.title}</h2>
      <p>{copy.intro}</p>
    </div>

    <div class="cg-product-status">
      <span class="cg-status-badge">{copy.status}: {status.label[locale]}</span>
      <p>{status.summary[locale]}</p>
      <p class="cg-evidence-verified">
        {copy.verified}: <time datetime={item.verified.date}>{item.verified.date}</time> · <a
          href={item.verified.href}
          target="_blank"
          rel="noopener noreferrer"
          lang="en">commit {item.verified.revision}</a
        >
      </p>
    </div>

    <div class="cg-evidence-grid">
      <article class="cg-evidence-card">
        <h3>{copy.implemented}</h3>
        <ul lang="en">
          {item.implemented.map((fact) => <li>{fact}</li>)}
        </ul>
      </article>
      <article class="cg-evidence-card">
        <h3>{copy.interfaces}</h3>
        <ul lang="en">
          {item.interfaces.map((fact) => <li>{fact}</li>)}
        </ul>
      </article>
    </div>

    <div class="cg-product-preview" aria-label={copy.preview}>
      <div class="cg-product-preview-heading">
        <div>
          <p class="cg-card-meta">{copy.preview}</p>
          <h3>{productName[product]}</h3>
        </div>
        <p>{copy.previewNote}</p>
      </div>
      <div class="cg-product-preview-flow">
        {
          item.preview.map((value, index) => (
            <div class="cg-product-preview-step">
              <span>{previewLabels[index]}</span>
              <strong lang="en">{value}</strong>
            </div>
          ))
        }
      </div>
    </div>

    <div class="cg-evidence-sources">
      <strong>{copy.sources}</strong>
      <div>
        {
          item.sources.map((source) => (
            <a href={source.href} target="_blank" rel="noopener noreferrer" lang={locale === 'en' ? undefined : 'en'}>
              {source.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
