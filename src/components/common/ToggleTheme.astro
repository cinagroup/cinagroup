---
import { Icon } from 'astro-icon/components';

import { UI } from 'astrowind:config';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
  iconName?: string;
}

const {
  label = 'Switch to dark mode',
  class:
    className = 'text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center',
  iconClass = 'w-6 h-6',
  iconName = 'tabler:moon',
} = Astro.props;
---

{
  !(UI.theme && UI.theme.endsWith(':only')) && (
    <button
      type="button"
      class={className}
      aria-label={label}
      aria-pressed="false"
      title={label}
      data-aw-toggle-color-scheme
    >
      <Icon name={iconName} class={`${iconClass} cg-theme-icon cg-theme-icon-moon`} />
      <Icon name="tabler:sun" class={`${iconClass} cg-theme-icon cg-theme-icon-sun`} />
    </button>
  )
}

<style>
  .cg-theme-icon-sun {
    display: none;
  }

  :global(.dark) .cg-theme-icon-moon {
    display: none;
  }

  :global(.dark) .cg-theme-icon-sun {
    display: block;
  }
</style>
