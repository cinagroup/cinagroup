---
import { UI } from 'astrowind:config';

interface Props {
  defaultTheme?: string;
}
const defaultTheme = Astro.props.defaultTheme || UI.theme || 'system';
---

<script is:inline define:vars={{ defaultTheme }}>
  function applyTheme(theme) {
    document.documentElement.classList.toggle('light', theme === 'light');
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    const matches = document.querySelectorAll('[data-aw-toggle-color-scheme] > input');

    if (matches && matches.length) {
      matches.forEach((elem) => {
        elem.checked = theme !== 'dark';
      });
    }
  }

  let storedTheme;
  try {
    storedTheme = localStorage.getItem('theme');
  } catch {
    // Apply the published default without requiring local storage.
  }
  if (storedTheme === 'system') {
    applyTheme(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  } else if ((defaultTheme && defaultTheme.endsWith(':only')) || (!storedTheme && defaultTheme !== 'system')) {
    applyTheme(defaultTheme.replace(':only', ''));
  } else if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    applyTheme('dark');
  } else {
    applyTheme('light');
  }
</script>
