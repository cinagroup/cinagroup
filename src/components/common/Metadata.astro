---
import merge from 'lodash.merge';
import { AstroSeo } from '@astrolib/seo';

import type { Props as AstroSeoProps } from '@astrolib/seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';
import { getLangFromUrl, getLanguageAlternates } from '~/i18n';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  omitCanonical = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  keywords,
  openGraph = {},
  twitter = {},
  language,
} = Astro.props;

type MetadataLanguage = NonNullable<MetaData['language']>;
const localeByLanguage: Record<MetadataLanguage, string> = {
  en: 'en_US',
  'zh-CN': 'zh_CN',
  ja: 'ja_JP',
  ko: 'ko_KR',
  ru: 'ru_RU',
  es: 'es_ES',
  pt: 'pt_BR',
  'pt-BR': 'pt_BR',
  fr: 'fr_FR',
};
const currentLocale = localeByLanguage[language || getLangFromUrl(Astro.url)];
const languageAlternates = omitCanonical
  ? []
  : getLanguageAlternates(Astro.url.pathname, new URL(String(canonical)).origin);
const shouldIgnoreTitleTemplate =
  ignoreTitleTemplate ||
  (typeof title === 'string' && Boolean(SITE?.name) && title.toLowerCase().includes(SITE.name.toLowerCase()));

const seoProps: AstroSeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: currentLocale || I18N?.language || 'en',
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: shouldIgnoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, locale: currentLocale, ...openGraph },
    twitter: twitter,
  }
);

if (omitCanonical) {
  delete seoProps.canonical;
  if (seoProps.openGraph) delete seoProps.openGraph.url;
} else if (languageAlternates.length > 0) {
  seoProps.languageAlternates = languageAlternates;
}
---

<AstroSeo {...{ ...seoProps, openGraph: await adaptOpenGraphImages(seoProps?.openGraph, Astro.site) }} />

{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
