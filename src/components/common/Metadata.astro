---
import merge from 'lodash.merge';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';
import { adaptOpenGraphImages, type OpenGraph } from '~/utils/images';
import { getLangFromUrl, getLanguageAlternates } from '~/i18n';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

interface SeoMetadata {
  title?: string;
  titleTemplate?: string;
  noindex?: boolean;
  nofollow?: boolean;
  description?: string;
  canonical?: string;
  openGraph?: OpenGraph;
  twitter?: { cardType?: string; site?: string; handle?: string };
  languageAlternates?: Array<{ hreflang: string; href: string }>;
}

const {
  title,
  ignoreTitleTemplate = false,
  omitCanonical = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  keywords,
  openGraph = {},
  twitter = {},
  language,
  alternates,
} = Astro.props;

type MetadataLanguage = NonNullable<MetaData['language']>;
const localeByLanguage: Record<MetadataLanguage, string> = {
  en: 'en_US',
  zh: 'zh_CN',
  'zh-CN': 'zh_CN',
  ja: 'ja_JP',
  ko: 'ko_KR',
  ru: 'ru_RU',
  es: 'es_ES',
  pt: 'pt_BR',
  'pt-BR': 'pt_BR',
  fr: 'fr_FR',
};
const currentLanguage = language || getLangFromUrl(Astro.url);
const currentLocale = localeByLanguage[currentLanguage];
const isChinese = currentLanguage === 'zh' || currentLanguage === 'zh-CN';
const localizedSiteName = isChinese ? '海内集团' : SITE?.name;
// Page-provided alternates (e.g. a blog post's translations) win over the
// static route matrix, which cannot know data-driven localized routes.
const languageAlternates = alternates
  ? alternates
  : omitCanonical
    ? []
    : getLanguageAlternates(Astro.url.pathname, new URL(String(canonical)).origin);
const shouldIgnoreTitleTemplate =
  ignoreTitleTemplate ||
  (typeof title === 'string' &&
    typeof localizedSiteName === 'string' &&
    title.toLowerCase().includes(localizedSiteName.toLowerCase()));

const seoProps: SeoMetadata = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: localizedSiteName,
      images: [],
      locale: currentLocale || I18N?.language || 'en',
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: isChinese ? '%s — 海内集团' : METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title,
    titleTemplate: shouldIgnoreTitleTemplate ? '%s' : undefined,
    canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description,
    openGraph: { url: canonical, locale: currentLocale, site_name: localizedSiteName, ...openGraph },
    twitter,
  }
);

if (omitCanonical) {
  delete seoProps.canonical;
  if (seoProps.openGraph) delete seoProps.openGraph.url;
} else if (languageAlternates.length > 0) {
  seoProps.languageAlternates = languageAlternates;
}

const renderedTitle = seoProps.title
  ? seoProps.titleTemplate?.replace('%s', seoProps.title) || seoProps.title
  : undefined;
const robotsContent = [
  typeof seoProps.noindex === 'boolean' ? (seoProps.noindex ? 'noindex' : 'index') : undefined,
  typeof seoProps.nofollow === 'boolean' ? (seoProps.nofollow ? 'nofollow' : 'follow') : undefined,
]
  .filter(Boolean)
  .join(',');
const renderedOpenGraph = await adaptOpenGraphImages(seoProps.openGraph, Astro.site);
---

{renderedTitle && <title>{renderedTitle}</title>}
{seoProps.description && <meta name="description" content={seoProps.description} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
{seoProps.canonical && <link rel="canonical" href={seoProps.canonical} />}
{
  seoProps.languageAlternates?.map((alternate) => (
    <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
  ))
}

{
  (renderedOpenGraph?.title || seoProps.title) && (
    <meta property="og:title" content={renderedOpenGraph?.title || seoProps.title} />
  )
}
{
  (renderedOpenGraph?.description || seoProps.description) && (
    <meta property="og:description" content={renderedOpenGraph?.description || seoProps.description} />
  )
}
{renderedOpenGraph?.url && <meta property="og:url" content={renderedOpenGraph.url} />}
{renderedOpenGraph?.type && <meta property="og:type" content={renderedOpenGraph.type} />}
{
  renderedOpenGraph?.images?.map((image) => (
    <>
      <meta property="og:image" content={image.url} />
      {image.alt && <meta property="og:image:alt" content={image.alt} />}
      {image.width && <meta property="og:image:width" content={String(image.width)} />}
      {image.height && <meta property="og:image:height" content={String(image.height)} />}
    </>
  ))
}
{renderedOpenGraph?.locale && <meta property="og:locale" content={renderedOpenGraph.locale} />}
{renderedOpenGraph?.site_name && <meta property="og:site_name" content={renderedOpenGraph.site_name} />}

{seoProps.twitter?.cardType && <meta name="twitter:card" content={seoProps.twitter.cardType} />}
{seoProps.twitter?.site && <meta name="twitter:site" content={seoProps.twitter.site} />}
{seoProps.twitter?.handle && <meta name="twitter:creator" content={seoProps.twitter.handle} />}

{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
