---
import { DEFAULT_SERVICES_COPY, type Locale } from '~/data/site/services-defaults.ts';
import { getPublishedPageCopy, getPageCopyMetadata } from '~/emdash/published-page-copy.ts';
import CinaPageHero from '~/components/CinaPageHero.astro';
import Layout from '~/layouts/PageLayout.astro';

const { lang } = Astro.props as { lang: Locale };
const page = await getPublishedPageCopy(Astro, 'page_services', 'services', DEFAULT_SERVICES_COPY[lang]);
const homeHref = `/${lang}/`;
const contactHref = `/${lang}/contact/`;
const metadata = await getPageCopyMetadata(Astro, { title: page.metadataTitle });
---

<Layout {metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={page.eyebrow}
      title={page.title}
      lead={page.lead}
      primary={{ text: page.primary, href: contactHref }}
      secondary={{ text: page.secondary, href: homeHref }}
    />
    <section class="cg-page-section" aria-labelledby="localized-services-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{page.sectionEyebrow}</p><h2 id="localized-services-title">{page.sectionTitle}</h2><p>
            {page.sectionLead}
          </p>
        </div><div class="cg-card-grid">
          {
            page.cards.map((item) => (
              <article class="cg-card">
                <>
                  <p class="cg-card-meta">{item.label}</p>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="cg-page-section cg-page-section-soft" aria-labelledby="localized-services-process">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{page.processEyebrow}</p><h2 id="localized-services-process">{page.processTitle}</h2>
        </div><div class="cg-list-panel">
          {
            page.steps.map((item, index) => (
              <div class="cg-list-row">
                <>
                  <strong>
                    {String(index + 1).padStart(2, '0')} / {item.title}
                  </strong>
                  <span>{item.description}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section class="cg-page-section cg-page-section-dark">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">Next step.</p><h2>{page.primary}</h2><div
            class="cg-page-actions"
            style="justify-content: flex-start;"
          >
            <a class="cg-page-button" href={contactHref}>{page.primary}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
