---
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post } = Astro.props;
---

<article class="cg-blog-post">
  <header class="cg-blog-post-header">
    <div class="cg-blog-post-copy">
      <p class="cg-eyebrow">Journal / {post.category?.title || 'Update'}.</p>
      <h1>{post.title}</h1>
      <p class="cg-blog-post-lead">{post.excerpt}</p>
      <p class="cg-blog-meta">
        <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        {post.author && <><span aria-hidden="true"> / </span><span>{post.author}</span></>}
        {post.category && <><span aria-hidden="true"> / </span><a href={getPermalink(post.category.slug, 'category')}>{post.category.title}</a></>}
        {post.readingTime && <><span aria-hidden="true"> / </span><span>{post.readingTime} min read</span></>}
      </p>
    </div>
    {
      post.image && (
        <div class="cg-blog-post-image">
          <Image
            src={post.image}
            class="w-full h-full object-cover"
            widths={[400, 900, 1200]}
            sizes="(max-width: 900px) 100vw, 900px"
            alt={post?.excerpt || post.title}
            width={1200}
            height={675}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }
  </header>
  <div class="cg-prose cg-blog-post-body"><slot /></div>
  <footer class="cg-blog-post-footer"><PostTags tags={post.tags} /></footer>
</article>
