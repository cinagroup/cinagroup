---
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post } = Astro.props;
const archivedUnverified = post.status === 'archived_unverified';
---

<article
  class="cg-blog-post"
  data-content-kind={archivedUnverified ? 'historical-archive' : 'editorial'}
  data-content-status={post.status}
>
  <header class="cg-blog-post-header">
    <div class="cg-blog-post-copy">
      <p class="cg-eyebrow">Journal / {post.category?.title || 'Update'}.</p>
      <h1>{post.title}</h1>
      <p class="cg-blog-post-lead">{post.excerpt}</p>
      <p class="cg-blog-meta">
        <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate, post.language)}</time>
        {post.updateDate && <><span aria-hidden="true"> / </span><span>Updated </span><time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate, post.language)}</time></>}
        {post.author && <><span aria-hidden="true"> / </span><span>{post.author}</span></>}
        {post.category && <><span aria-hidden="true"> / </span>{archivedUnverified ? <span>{post.category.title}</span> : <a href={getPermalink(post.category.slug, 'category')}>{post.category.title}</a>}</>}
        {post.readingTime && <><span aria-hidden="true"> / </span><span>{post.readingTime} min read</span></>}
      </p>
      {
        archivedUnverified && (
          <aside class="cg-briefing-notice" aria-label="Unverified historical archive notice">
            <strong>Unverified historical archive — do not rely on this item as a verified source.</strong>
            <span>
              This URL is preserved for transparency and continuity. The item came from a retired automated workflow,
              was not independently source-checked by the CinaGroup editorial team, and may contain inaccurate or
              outdated claims. Confirm every claim with current primary sources.
            </span>
          </aside>
        )
      }
    </div>
    {
      post.image && (
        <div class="cg-blog-post-image">
          <Image
            src={post.image}
            class="w-full h-full object-cover"
            widths={[400, 900, 1200]}
            sizes="(max-width: 900px) 100vw, 900px"
            alt={post?.excerpt || post.title}
            width={1200}
            height={675}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }
  </header>
  <div class="cg-prose cg-blog-post-body"><slot /></div>
  {!archivedUnverified && <footer class="cg-blog-post-footer"><PostTags tags={post.tags} /></footer>}
</article>
