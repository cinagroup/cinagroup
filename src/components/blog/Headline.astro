---
const { title = await Astro.slots.render('default'), subtitle = await Astro.slots.render('subtitle') } = Astro.props;
---

<header class="cg-blog-headline">
  <p class="cg-eyebrow">AI news / automated archive.</p>
  <h1 set:html={title} />
  {
    subtitle && <div class="cg-blog-headline-lead" set:html={subtitle} />
  }
</header>
