---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';
import { isAutomatedBriefing } from '~/utils/blog-content.js';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
const automatedBriefing = isAutomatedBriefing(post.slug);
const archivedUnverified = post.status === 'archived_unverified';
---

<article
  class:list={['cg-blog-item', { 'cg-blog-item-with-image': image }]}
  data-content-kind={archivedUnverified ? 'historical-archive-summary' : 'editorial-summary'}
  data-content-status={post.status}
>
  {
    image &&
      (link ? (
        <a class="cg-blog-image" href={link}>
          <div>
            {image && (
              <Image
                src={image}
                class="w-full h-full object-cover"
                widths={[400, 900]}
                width={900}
                sizes="(max-width: 900px) 400px, 900px"
                alt={post.title}
                aspectRatio="16:9"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        </a>
      ) : (
        <div class="cg-blog-image">
          {image && (
            <Image
              src={image}
              class="w-full h-full object-cover"
              widths={[400, 900]}
              width={900}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              aspectRatio="16:9"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      ))
  }
  <div class="cg-blog-item-copy">
    <header>
      <div class="cg-blog-meta">
        <span>
          {automatedBriefing && <><span class="cg-blog-kind">Automated · unverified</span>{' '}·{' '}</>}
          <time datetime={post.publishDate.toISOString()} class="inline-block">{getFormattedDate(post.publishDate, post.language)}</time>
          {
            post.author && (
              <>
                {' '}·{' '}
                <span>{post.author.replaceAll('-', ' ')}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}·{' '}
                {archivedUnverified ? (
                  <span>{post.category.title}</span>
                ) : (
                  <a href={getPermalink(post.category.slug, 'category')}>{post.category.title}</a>
                )}
              </>
            )
          }
        </span>
      </div>
      <h2>
        {
          link ? (
            <a
              class="cg-blog-title-link"
              href={link}
            >
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h2>
    </header>

    {post.excerpt && <p>{post.excerpt}</p>}
    {
      post.tags && Array.isArray(post.tags) ? (
        <footer class="cg-blog-tags">
          <PostTags tags={post.tags} linkable={!archivedUnverified} />
        </footer>
      ) : (
        <Fragment />
      )
    }
  </div>
</article>
