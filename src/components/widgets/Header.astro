---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import type { CallToAction } from '~/types';
import { changeLangPath, getLangFromUrl, getLocalizedLabel, languages, localizeInternalHref, type Lang } from '~/i18n';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  showLanguageSwitcher?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showLanguageSwitcher = true,
  position = 'center',
} = Astro.props;

const currentPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const currentLang = getLangFromUrl(Astro.url);

const languageOptions = Object.entries(languages).map(([lang, label]) => {
  const targetLang = lang as Lang;

  return {
    lang: targetLang,
    label,
    href: changeLangPath(Astro.url, targetLang),
  };
});

const homeHref = changeLangPath(new URL('/', Astro.url), currentLang);

const localizeHeaderHref = (href?: string) => localizeInternalHref(href, currentLang);
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0"></div>
  <div
    class:list={[
      'relative text-default py-3 px-3 sm:px-6 mx-auto w-full h-full lg:h-auto flex flex-col overflow-hidden lg:overflow-visible',
      {
        'lg:flex lg:justify-between': position !== 'center',
      },
      {
        'lg:grid lg:grid-cols-[auto_minmax(0,1fr)_auto] lg:items-center lg:gap-4': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
      <a
        class="flex items-center"
        href={homeHref}
        aria-label={currentLang === 'zh' ? '海内集团首页' : 'CinaGroup home'}
      >
        <Logo />
      </a>
      <div class="flex items-center lg:hidden">
        <ToggleMenu label={currentLang === 'zh' ? '切换菜单' : 'Toggle Menu'} controls="main-navigation" />
      </div>
    </div>
    <nav
      id="main-navigation"
      class="items-center flex-1 min-h-0 w-full lg:w-auto hidden lg:flex lg:mx-3 xl:mx-5 pb-24 lg:pb-0 text-default overflow-y-auto overflow-x-hidden lg:overflow-y-visible lg:overflow-x-auto lg:justify-self-center"
      aria-label={getLocalizedLabel(currentLang, 'Main navigation')}
    >
      <ul
        class="flex flex-col lg:flex-row lg:self-center w-full lg:w-auto text-xl lg:text-[0.9375rem] tracking-[0.01rem] font-medium lg:justify-center"
      >
        {
          links.map(({ text, href, links }, linkIndex) => (
            <li class={links?.length ? 'dropdown' : ''} {...(links?.length ? { 'data-aw-dropdown': true } : {})}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                    aria-expanded="false"
                    aria-controls={`header-dropdown-${linkIndex}`}
                    data-aw-dropdown-toggle
                  >
                    {getLocalizedLabel(currentLang, text)}{' '}
                    <Icon
                      name="tabler:chevron-down"
                      class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5"
                      aria-hidden="true"
                    />
                  </button>
                  <ul
                    id={`header-dropdown-${linkIndex}`}
                    class="dropdown-menu hidden lg:backdrop-blur-md dark:lg:bg-dark rounded lg:absolute pl-4 lg:pl-0 font-medium lg:bg-white/90 lg:min-w-[200px] drop-shadow-xl"
                    data-aw-dropdown-menu
                  >
                    {links.map(({ text: text2, href: href2 }) => {
                      const localizedHref = localizeHeaderHref(href2);
                      return (
                        <li>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                              { 'aw-link-active': localizedHref === currentPath },
                            ]}
                            href={localizedHref}
                          >
                            {getLocalizedLabel(currentLang, text2)}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': localizeHeaderHref(href) === currentPath },
                  ]}
                  href={localizeHeaderHref(href)}
                >
                  {getLocalizedLabel(currentLang, text)}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      class:list={[
        { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
        'hidden lg:self-center lg:flex items-center lg:mb-0 fixed z-10 w-full lg:w-auto lg:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 lg:p-0 lg:justify-self-end border-t border-gray-700/60 bg-page/95 backdrop-blur lg:border-0 lg:bg-transparent lg:backdrop-blur-none',
      ]}
    >
      <div class="items-center flex justify-between w-full lg:w-auto">
        <div class="flex items-center">
          {
            showToggleTheme && (
              <ToggleTheme
                label={getLocalizedLabel(currentLang, 'Switch to dark mode')}
                iconClass="w-6 h-6 lg:w-5 lg:h-5 lg:inline-block"
              />
            )
          }
          {
            showLanguageSwitcher && (
              <div class="relative ml-2">
                <button
                  type="button"
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={getLocalizedLabel(currentLang, 'Language Switcher')}
                  aria-expanded="false"
                  aria-haspopup="menu"
                  aria-controls="language-dropdown"
                  id="language-switcher"
                >
                  <Icon name="tabler:world" class="w-5 h-5" />
                  <Icon name="tabler:chevron-down" class="w-4 h-4 ml-0.5" />
                </button>
                <div
                  class="hidden absolute left-0 bottom-full mb-2 lg:bottom-auto lg:mb-0 lg:mt-2 py-2 bg-white dark:bg-gray-800 rounded-lg shadow-lg min-w-[140px] z-50"
                  id="language-dropdown"
                  role="menu"
                >
                  {languageOptions.map(({ lang, label, href }) => (
                    <a
                      href={href}
                      lang={lang}
                      role="menuitem"
                      aria-current={currentLang === lang ? 'page' : undefined}
                      class:list={[
                        'block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700',
                        currentLang === lang ? 'bg-gray-100 dark:bg-gray-700 font-semibold' : '',
                      ]}
                    >
                      {label}
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>
        <script is:inline>
          (() => {
            const initLanguageSwitcher = () => {
              const languageSwitcher = document.getElementById('language-switcher');
              const languageDropdown = document.getElementById('language-dropdown');

              if (languageSwitcher && languageDropdown && !languageSwitcher.dataset.initialized) {
                languageSwitcher.dataset.initialized = 'true';

                const closeDropdown = () => {
                  languageDropdown.classList.add('hidden');
                  languageSwitcher.setAttribute('aria-expanded', 'false');
                };

                languageSwitcher.addEventListener('click', function (e) {
                  e.stopPropagation();
                  languageDropdown.classList.toggle('hidden');
                  languageSwitcher.setAttribute(
                    'aria-expanded',
                    String(!languageDropdown.classList.contains('hidden'))
                  );
                });

                languageDropdown.addEventListener('click', function (e) {
                  e.stopPropagation();
                });

                document.addEventListener('click', function (e) {
                  if (!languageSwitcher.contains(e.target)) {
                    closeDropdown();
                  }
                });

                document.addEventListener('keydown', function (e) {
                  if (e.key === 'Escape' && !languageDropdown.classList.contains('hidden')) {
                    closeDropdown();
                    languageSwitcher.focus();
                  }
                });
              }
            };

            initLanguageSwitcher();
            document.addEventListener('astro:page-load', initLanguageSwitcher);
          })();
        </script>
        {
          actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button
                  {...btnProps}
                  text={getLocalizedLabel(currentLang, btnProps.text)}
                  class="ml-2 py-2.5 px-5.5 lg:px-6 font-semibold shadow-none text-sm w-auto"
                />
              ))}
            </span>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</header>
