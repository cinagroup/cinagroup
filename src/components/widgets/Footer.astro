---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';
import { changeLangPath, getLangFromUrl, getLocalizedLabel, localizeInternalHref } from '~/i18n';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks: Array<Link>;
  description?: string;
  footNote?: string;
  theme?: string;
}

const {
  socialLinks = [],
  secondaryLinks = [],
  links = [],
  description = '',
  footNote = '',
  theme = 'light',
} = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const homeHref = changeLangPath(new URL('/', Astro.url), currentLang);
const localizeFooterHref = (href?: string) => localizeInternalHref(href, currentLang);
const localizedName = getLocalizedLabel(currentLang, SITE?.name) ?? SITE?.name;
const localizedFootNote = currentLang === 'zh' ? '&copy; 2026 海内集团。保留所有权利。' : footNote;
---

<footer class:list={[{ dark: theme === 'dark' }, 'cg-site-footer relative not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="cg-footer-shell relative">
    <div class="cg-footer-main">
      <div class="cg-footer-brand">
        <a class="cg-footer-wordmark" href={homeHref || getHomePermalink()}>{localizedName}</a>
        {description && <p class="cg-footer-description">{getLocalizedLabel(currentLang, description)}</p>}
      </div>

      <nav class="cg-footer-nav" aria-label={getLocalizedLabel(currentLang, 'Footer navigation')}>
        {
          links.map(({ title, links }, sectionIndex) => (
            <section class="cg-footer-column" aria-labelledby={`footer-section-${sectionIndex}`}>
              <h2 id={`footer-section-${sectionIndex}`} class="cg-footer-heading">
                {getLocalizedLabel(currentLang, title)}
              </h2>
              {links && Array.isArray(links) && links.length > 0 && (
                <ul class="cg-footer-links">
                  {links.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a class="cg-footer-link" href={localizeFooterHref(href)} aria-label={ariaLabel}>
                        <Fragment set:html={getLocalizedLabel(currentLang, text)} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </nav>
    </div>

    <div class="cg-footer-bottom">
      <div class="cg-footer-meta">
        <div class="cg-footer-copyright">
          <Fragment set:html={localizedFootNote} />
        </div>
        {
          secondaryLinks.length > 0 && (
            <ul class="cg-footer-legal" aria-label={getLocalizedLabel(currentLang, 'Legal')}>
              {secondaryLinks.map(({ text, href }) => (
                <li>
                  <a class="cg-footer-link" href={localizeFooterHref(href)}>
                    <Fragment set:html={getLocalizedLabel(currentLang, text)} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        socialLinks?.length ? (
          <ul class="cg-footer-social" aria-label={getLocalizedLabel(currentLang, 'Social links')}>
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a class="cg-footer-social-link" aria-label={ariaLabel} href={href}>
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }
    </div>
  </div>
</footer>
