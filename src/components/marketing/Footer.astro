---
import { SITE, UI } from 'astrowind:config';
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import MotionPreferences from '~/components/flexina/MotionPreferences.astro';
import { loadSitePresentation } from '~/emdash/site-presentation';
import { flattenPresentationMenu } from '~/emdash/site-presentation-model';
import { footerData } from '~/navigation';
import { getLangFromUrl, getLocalizedLabel, localizeInternalHref } from '~/i18n';

const lang = getLangFromUrl(Astro.url);
const copy = {
  en: {
    home: 'CinaGroup home',
    navigation: 'Footer navigation',
    theme: 'Theme',
    light: 'Light',
    dark: 'Dark',
    system: 'System',
    top: 'Back to top',
  },
  zh: {
    home: '海内集团首页',
    navigation: '页脚导航',
    theme: '显示模式',
    light: '浅色',
    dark: '深色',
    system: '系统',
    top: '返回顶部',
  },
  ja: {
    home: 'CinaGroup ホーム',
    navigation: 'フッターナビゲーション',
    theme: '表示モード',
    light: 'ライト',
    dark: 'ダーク',
    system: 'システム',
    top: 'トップに戻る',
  },
  ko: {
    home: 'CinaGroup 홈',
    navigation: '바닥글 메뉴',
    theme: '표시 모드',
    light: '밝게',
    dark: '어둡게',
    system: '시스템',
    top: '맨 위로',
  },
  ru: {
    home: 'Главная CinaGroup',
    navigation: 'Меню внизу страницы',
    theme: 'Тема',
    light: 'Светлая',
    dark: 'Тёмная',
    system: 'Системная',
    top: 'Наверх',
  },
  es: {
    home: 'Inicio de CinaGroup',
    navigation: 'Navegación del pie de página',
    theme: 'Tema',
    light: 'Claro',
    dark: 'Oscuro',
    system: 'Sistema',
    top: 'Volver arriba',
  },
  pt: {
    home: 'Página inicial CinaGroup',
    navigation: 'Navegação do rodapé',
    theme: 'Tema',
    light: 'Claro',
    dark: 'Escuro',
    system: 'Sistema',
    top: 'Voltar ao topo',
  },
  fr: {
    home: 'Accueil CinaGroup',
    navigation: 'Navigation du pied de page',
    theme: 'Thème',
    light: 'Clair',
    dark: 'Sombre',
    system: 'Système',
    top: 'Retour en haut',
  },
}[lang];
const label = (text?: string) => getLocalizedLabel(lang, text);
const href = (url?: string) => localizeInternalHref(url, lang);
const presentation = await loadSitePresentation(Astro);
const { appearance } = presentation;
const homeWave = /^\/(?:(?:en|zh|ja|ko|ru|es|pt|fr)\/?)?$/.test(Astro.url.pathname);
// Original curves with matching commands permit smooth SVG interpolation without a theme asset.
const waveShapes = [
  'M0 70 C240 20 480 125 720 78 C960 25 1200 118 1440 60 L1440 150 L0 150 Z',
  'M0 50 C240 118 480 20 720 64 C960 125 1200 30 1440 85 L1440 150 L0 150 Z',
  'M0 88 C240 58 480 115 720 48 C960 30 1200 115 1440 65 L1440 150 L0 150 Z',
  'M0 70 C240 20 480 125 720 78 C960 25 1200 118 1440 60 L1440 150 L0 150 Z',
];
const siteName = label(presentation.siteName ?? SITE?.name) ?? 'CinaGroup';
const homeLabel = copy.home.replace(lang === 'zh' ? '海内集团' : 'CinaGroup', siteName);
const contactEmail = presentation.contactEmail ?? 'info@cinagroup.com';
const socialLinks = presentation.socialLinks ?? footerData.socialLinks;
const footerDescription = presentation.footerDescription ?? label(footerData.description);
const fallbackGroups = [
  footerData.links[0],
  footerData.links[2],
  { title: footerData.links[1].title, links: [...footerData.links[1].links, ...footerData.links[3].links] },
].map((group) => ({
  label: label(group.title),
  url: '#',
  links: group.links.map((item) => ({ label: label(item.text), url: href(item.href), target: undefined })),
}));
const groups =
  presentation.menus.footer?.map((group) => ({
    label: group.children.length ? group.label : undefined,
    url: group.url,
    links: flattenPresentationMenu(group.children.length ? group.children : [group]).filter((item) => item.url !== '#'),
  })) ?? fallbackGroups;
const legalLinks = presentation.menus['footer-legal']
  ? flattenPresentationMenu(presentation.menus['footer-legal']).filter((item) => item.url !== '#')
  : footerData.secondaryLinks.map((item) => ({ label: label(item.text), url: href(item.href), target: undefined }));
---

<footer class="site-footer fx-footer">
  {
    appearance.footerWave && (
      <svg class="fx-footer-wave" data-fx-wave aria-hidden="true" viewBox="0 0 1440 150" preserveAspectRatio="none">
        <defs>
          <linearGradient id="fx-footer-wave-surface" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--fx-primary, #03c2f6)" />
            <stop offset="1" stop-color="var(--fx-band-end, #42d7ff)" />
          </linearGradient>
        </defs>
        <path
          d={waveShapes[0]}
          fill={homeWave ? 'url(#fx-footer-wave-surface)' : 'var(--fx-wave-surface, var(--color-bg, #fff))'}
        >
          <animate
            data-fx-wave-animation
            attributeName="d"
            values={waveShapes.join(';')}
            keyTimes="0;0.333333;0.666667;1"
            keySplines="0.42 0 0.58 1;0.42 0 0.58 1;0.42 0 0.58 1"
            calcMode="spline"
            dur={`${appearance.waveDurationSeconds}s`}
            repeatCount="indefinite"
            begin="indefinite"
          />
        </path>
      </svg>
    )
  }
  <div class="fx-footer-patterns" data-fx-ambient aria-hidden="true">
    <span class="fx-footer-shape fx-footer-shape-one"></span>
    <span class="fx-footer-shape fx-footer-shape-two"></span>
  </div>
  <div class="footer-content">
    <div class="footer-brand" data-fx-reveal>
      <a href={href('/')} class="footer-logo" aria-label={homeLabel}>
        <Logo variant="dark" />
      </a>
      <p class="footer-tagline">{footerDescription}</p>
      <a class="fx-footer-email" href={`mailto:${contactEmail}`}>
        <Icon name="tabler:mail" width={18} height={18} />
        {contactEmail}
      </a>
      <div class="footer-social">
        {
          socialLinks.map((item) => (
            <a href={item.href} aria-label={item.ariaLabel}>
              <Icon name={item.icon} width={17} height={17} />
            </a>
          ))
        }
      </div>
    </div>
    <nav class="footer-links" aria-label={copy.navigation}>
      {
        groups.map((group, index) => (
          <div class="footer-col" data-fx-reveal data-fx-reveal-order={index + 1}>
            {group.label && <h3>{group.url !== '#' ? <a href={group.url}>{group.label}</a> : group.label}</h3>}
            {group.links.map((item) => (
              <a
                href={item.url}
                target={item.target}
                rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
              >
                <Icon name="tabler:chevron-right" width={13} height={13} />
                {item.label}
              </a>
            ))}
          </div>
        ))
      }
    </nav>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {siteName}</p>
    <div
      class="theme-switcher"
      data-default-theme={appearance.colorMode || UI.theme || 'system'}
      aria-label={copy.theme}
    >
      {
        (['light', 'dark', 'system'] as const).map((theme) => (
          <button type="button" class="theme-btn" data-marketing-theme={theme} aria-pressed="false">
            {copy[theme]}
          </button>
        ))
      }
    </div>
    <MotionPreferences lang={lang} />
    <div class="fx-footer-legal">
      {
        legalLinks.map((item) => (
          <a href={item.url} target={item.target} rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}>
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
{
  appearance.backToTop && (
    <button type="button" class="fx-back-to-top" aria-label={copy.top} hidden>
      <Icon name="tabler:arrow-up" width={23} height={23} />
    </button>
  )
}

<style>
  .fx-footer.site-footer {
    position: relative;
    margin-top: 0;
    overflow: hidden;
    border: 0;
    background: var(--fx-footer-bg, #0e1422);
    color: #fff;
  }
  .fx-footer-wave {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 60px;
    transform: scaleY(-1);
    pointer-events: none;
    z-index: 1;
  }
  .fx-footer-patterns {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .fx-footer-shape {
    position: absolute;
    display: block;
    width: 210px;
    height: 290px;
    border: 1px solid #ffffff12;
    border-radius: 45% 60% 30% 65%;
    background: #ffffff05;
    animation: fx-footer-drift 6s ease-in-out infinite alternate paused;
  }
  .fx-footer-shape-one {
    left: -80px;
    bottom: 70px;
    rotate: -25deg;
  }
  .fx-footer-shape-two {
    right: -70px;
    top: 100px;
    rotate: 25deg;
    animation-delay: -3s;
  }
  :global(html[data-fx-motion-enabled='true']) .fx-footer-patterns[data-fx-ambient-active='true'] .fx-footer-shape {
    animation-play-state: running;
  }
  @keyframes fx-footer-drift {
    to {
      translate: 8px -18px;
      transform: rotate(4deg);
    }
  }
  .fx-footer .footer-content {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr 1fr;
    max-width: var(--wide-width, 1252px);
    margin: 0 auto;
    padding: 96px 24px 64px;
    gap: 56px;
  }
  .fx-footer .footer-links {
    display: contents;
  }
  .fx-footer .footer-brand,
  .fx-footer .footer-col {
    min-width: 0;
  }
  .fx-footer .footer-logo {
    display: inline-flex;
    margin-bottom: 12px;
  }
  .fx-footer .footer-logo :global(img[src='/brand/cinagroup-horizontal.png']) {
    display: none;
  }
  .fx-footer .footer-logo :global(img[src='/brand/cinagroup-horizontal-white.png']) {
    display: block;
  }
  .fx-footer .footer-tagline {
    max-width: 290px;
    margin: 4px 0 20px;
    color: #b8bfce;
    font-size: 14px;
    line-height: 1.85;
  }
  .fx-footer .fx-footer-email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-size: 13px;
    line-height: 1.7;
  }
  .fx-footer .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .fx-footer .footer-social a {
    display: flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #ffffff14;
    color: #fff;
    transition: background 160ms ease;
  }
  .fx-footer .footer-social a:hover {
    background: var(--fx-primary, #03c2f6);
    color: var(--color-on-brand, #131313);
  }
  .fx-footer .footer-col h3 {
    position: relative;
    margin: 10px 0 32px;
    padding-bottom: 14px;
    color: #fff;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }
  .fx-footer .footer-col h3::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 2px;
    content: '';
    background: var(--fx-primary, #03c2f6);
  }
  .fx-footer .footer-col a {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 7px 0;
    color: #c5cad4;
    font-size: 14px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .fx-footer .footer-col a :global(svg) {
    margin-top: 5px;
    flex-shrink: 0;
  }
  .fx-footer .footer-col a:hover,
  .fx-footer .fx-footer-email:hover,
  .fx-footer .fx-footer-legal a:hover {
    color: var(--fx-link-dark, #42d7ff);
  }
  .fx-footer .footer-bottom {
    position: relative;
    display: flex;
    max-width: var(--fx-inner-width, 1204px);
    min-height: 90px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin: 0 auto;
    padding: 24px 0;
    border-top: 1px solid #ffffff21;
    color: #c5cad4;
    font-size: 12px;
    line-height: 1.6;
  }
  .fx-footer .theme-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .fx-footer .theme-btn {
    min-height: 34px;
    padding: 5px 10px;
    border: 1px solid #ffffff33;
    border-radius: 100px;
    background: transparent;
    color: #c5cad4;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .fx-footer .theme-btn:hover,
  .fx-footer .theme-btn.active {
    border-color: var(--fx-primary, #03c2f6);
    background: var(--fx-primary, #03c2f6);
    color: var(--color-on-brand, #131313);
  }
  .fx-footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .fx-footer :is(a, button):focus-visible {
    outline: 2px solid var(--fx-link-dark, #42d7ff);
    outline-offset: 4px;
  }
  .fx-back-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 90;
    display: flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--fx-link-dark, #42d7ff);
    border-radius: 50%;
    background: var(--fx-footer-bg, #0e1422);
    color: var(--fx-link-dark, #42d7ff);
    cursor: pointer;
  }
  .fx-back-to-top[hidden] {
    display: none;
  }
  .fx-back-to-top:hover {
    background: var(--fx-primary, #03c2f6);
    color: var(--color-on-brand, #131313);
  }
  .fx-back-to-top:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  @media (max-width: 1251px) {
    .fx-footer .footer-bottom {
      margin-right: 24px;
      margin-left: 24px;
    }
  }
  @media (max-width: 991px) {
    .fx-footer .footer-content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 48px;
      padding-top: 90px;
    }
    .fx-footer .footer-bottom {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 575px) {
    .fx-footer .footer-content {
      grid-template-columns: 1fr;
      padding: 80px 24px 40px;
      gap: 30px;
    }
    .fx-footer .footer-col h3 {
      margin-bottom: 18px;
    }
    .fx-footer .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }
    .fx-back-to-top {
      right: 16px;
      bottom: 16px;
      width: 44px;
      height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-footer .footer-social a {
      transition: none;
    }
  }
</style>

<script>
  import { readMotionState } from '~/components/flexina/motion-preference';

  let transientTheme: string | undefined;
  function readMarketingTheme() {
    const fallback = document.documentElement.dataset.fxDefaultColorMode || 'system';
    try {
      return localStorage.getItem('theme') || transientTheme || fallback;
    } catch {
      return transientTheme || fallback;
    }
  }

  function setupMarketingTheme() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-marketing-theme]');
    const update = (theme: string) => {
      buttons.forEach((button) => {
        const active = button.dataset.marketingTheme === theme;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };
    const stored = readMarketingTheme();
    update(stored);
    buttons.forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const theme = button.dataset.marketingTheme || 'system';
        transientTheme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch {
          // A blocked preference store must not disable the controls or motion setup.
        }
        const dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.classList.toggle('light', !dark);
        update(theme);
      });
    });
  }
  function updateBackToTop() {
    const button = document.querySelector<HTMLButtonElement>('.fx-back-to-top');
    if (button) button.hidden = window.scrollY < 400;
  }
  function setupBackToTop() {
    const button = document.querySelector<HTMLButtonElement>('.fx-back-to-top');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';
    button.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: readMotionState().enabled ? 'smooth' : 'instant',
      });
      document.querySelector<HTMLAnchorElement>('#marketing-header .site-logo')?.focus({ preventScroll: true });
    });
    updateBackToTop();
  }
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (readMarketingTheme() !== 'system') return;
    document.documentElement.classList.toggle('dark', event.matches);
    document.documentElement.classList.toggle('light', !event.matches);
  });
  window.addEventListener('scroll', updateBackToTop, { passive: true });
  setupMarketingTheme();
  setupBackToTop();
  document.addEventListener('astro:page-load', () => {
    setupMarketingTheme();
    setupBackToTop();
  });
</script>
