---
import { UI } from 'astrowind:config';
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { footerData } from '~/navigation';
import { getLangFromUrl, getLocalizedLabel, localizeInternalHref } from '~/i18n';

const lang = getLangFromUrl(Astro.url);
const copy = {
  en: {
    home: 'CinaGroup home',
    navigation: 'Footer navigation',
    theme: 'Theme',
    light: 'Light',
    dark: 'Dark',
    system: 'System',
    top: 'Back to top',
  },
  zh: {
    home: '海内集团首页',
    navigation: '页脚导航',
    theme: '显示模式',
    light: '浅色',
    dark: '深色',
    system: '系统',
    top: '返回顶部',
  },
  ja: {
    home: 'CinaGroup ホーム',
    navigation: 'フッターナビゲーション',
    theme: '表示モード',
    light: 'ライト',
    dark: 'ダーク',
    system: 'システム',
    top: 'トップに戻る',
  },
  ko: {
    home: 'CinaGroup 홈',
    navigation: '바닥글 메뉴',
    theme: '표시 모드',
    light: '밝게',
    dark: '어둡게',
    system: '시스템',
    top: '맨 위로',
  },
  ru: {
    home: 'Главная CinaGroup',
    navigation: 'Меню внизу страницы',
    theme: 'Тема',
    light: 'Светлая',
    dark: 'Тёмная',
    system: 'Системная',
    top: 'Наверх',
  },
  es: {
    home: 'Inicio de CinaGroup',
    navigation: 'Navegación del pie de página',
    theme: 'Tema',
    light: 'Claro',
    dark: 'Oscuro',
    system: 'Sistema',
    top: 'Volver arriba',
  },
  pt: {
    home: 'Página inicial CinaGroup',
    navigation: 'Navegação do rodapé',
    theme: 'Tema',
    light: 'Claro',
    dark: 'Escuro',
    system: 'Sistema',
    top: 'Voltar ao topo',
  },
  fr: {
    home: 'Accueil CinaGroup',
    navigation: 'Navigation du pied de page',
    theme: 'Thème',
    light: 'Clair',
    dark: 'Sombre',
    system: 'Système',
    top: 'Retour en haut',
  },
}[lang];
const label = (text?: string) => getLocalizedLabel(lang, text);
const href = (url?: string) => localizeInternalHref(url, lang);
const groups = [
  footerData.links[0],
  footerData.links[2],
  { title: footerData.links[1].title, links: [...footerData.links[1].links, ...footerData.links[3].links] },
];
---

<footer class="site-footer fx-footer">
  <svg class="fx-footer-wave" aria-hidden="true" viewBox="0 0 1440 60" preserveAspectRatio="none">
    <path d="M0 34 C240 62 410 58 650 25 S1140 4 1440 28 L1440 60 L0 60 Z"></path>
  </svg>
  <div class="footer-content">
    <div class="footer-brand">
      <a href={href('/')} class="footer-logo" aria-label={copy.home}>
        <Logo />
      </a>
      <p class="footer-tagline">{label(footerData.description)}</p>
      <a class="fx-footer-email" href="mailto:info@cinagroup.com">
        <Icon name="tabler:mail" width={18} height={18} />
        info@cinagroup.com
      </a>
      <div class="footer-social">
        {
          footerData.socialLinks.map((item) => (
            <a href={item.href} aria-label={item.ariaLabel}>
              <Icon name={item.icon} width={17} height={17} />
            </a>
          ))
        }
      </div>
    </div>
    <nav class="footer-links" aria-label={copy.navigation}>
      {
        groups.map((group) => (
          <div class="footer-col">
            <h3>{label(group.title)}</h3>
            {group.links.map((item) => (
              <a href={href(item.href)}>
                <Icon name="tabler:chevron-right" width={13} height={13} />
                {label(item.text)}
              </a>
            ))}
          </div>
        ))
      }
    </nav>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} CinaGroup</p>
    <div class="theme-switcher" data-default-theme={UI.theme || 'system'} aria-label={copy.theme}>
      {
        (['light', 'dark', 'system'] as const).map((theme) => (
          <button type="button" class="theme-btn" data-marketing-theme={theme} aria-pressed="false">
            {copy[theme]}
          </button>
        ))
      }
    </div>
    <div class="fx-footer-legal">
      {footerData.secondaryLinks.map((item) => <a href={href(item.href)}>{label(item.text)}</a>)}
    </div>
  </div>
</footer>
<button type="button" class="fx-back-to-top" aria-label={copy.top} hidden>
  <Icon name="tabler:arrow-up" width={23} height={23} />
</button>

<style>
  .fx-footer.site-footer {
    position: relative;
    margin-top: 64px;
    border: 0;
    background: #0e1422;
    color: #fff;
  }
  .fx-footer-wave {
    position: absolute;
    top: -49px;
    left: 0;
    width: 100%;
    height: 50px;
    fill: #0e1422;
  }
  .fx-footer .footer-content {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr 1fr;
    max-width: 1252px;
    margin: 0 auto;
    padding: 76px 24px 64px;
    gap: 56px;
  }
  .fx-footer .footer-links {
    display: contents;
  }
  .fx-footer .footer-brand,
  .fx-footer .footer-col {
    min-width: 0;
  }
  .fx-footer .footer-logo {
    display: inline-flex;
    margin-bottom: 12px;
  }
  .fx-footer .footer-logo :global(img[src='/brand/cinagroup-horizontal.png']) {
    display: none;
  }
  .fx-footer .footer-logo :global(img[src='/brand/cinagroup-horizontal-white.png']) {
    display: block;
  }
  .fx-footer .footer-tagline {
    max-width: 290px;
    margin: 4px 0 20px;
    color: #b8bfce;
    font-size: 14px;
    line-height: 1.85;
  }
  .fx-footer .fx-footer-email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-size: 13px;
    line-height: 1.7;
  }
  .fx-footer .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .fx-footer .footer-social a {
    display: flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #ffffff14;
    color: #fff;
    transition: background 160ms ease;
  }
  .fx-footer .footer-social a:hover {
    background: var(--fx-primary, #03c2f6);
    color: #131313;
  }
  .fx-footer .footer-col h3 {
    position: relative;
    margin: 10px 0 32px;
    padding-bottom: 14px;
    color: #fff;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }
  .fx-footer .footer-col h3::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 2px;
    content: '';
    background: var(--fx-primary, #03c2f6);
  }
  .fx-footer .footer-col a {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 7px 0;
    color: #c5cad4;
    font-size: 14px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .fx-footer .footer-col a :global(svg) {
    margin-top: 5px;
    flex-shrink: 0;
  }
  .fx-footer .footer-col a:hover,
  .fx-footer .fx-footer-email:hover,
  .fx-footer .fx-footer-legal a:hover {
    color: var(--fx-primary, #03c2f6);
  }
  .fx-footer .footer-bottom {
    display: flex;
    max-width: 1204px;
    min-height: 90px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0 auto;
    padding: 24px 0;
    border-top: 1px solid #ffffff21;
    color: #c5cad4;
    font-size: 12px;
    line-height: 1.6;
  }
  .fx-footer .theme-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .fx-footer .theme-btn {
    min-height: 34px;
    padding: 5px 10px;
    border: 1px solid #ffffff33;
    border-radius: 100px;
    background: transparent;
    color: #c5cad4;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .fx-footer .theme-btn:hover,
  .fx-footer .theme-btn.active {
    border-color: var(--fx-primary, #03c2f6);
    background: var(--fx-primary, #03c2f6);
    color: #131313;
  }
  .fx-footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .fx-footer :is(a, button):focus-visible {
    outline: 2px solid var(--fx-primary, #03c2f6);
    outline-offset: 4px;
  }
  .fx-back-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 90;
    display: flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--fx-primary, #03c2f6);
    border-radius: 50%;
    background: #0e1422;
    color: var(--fx-primary, #03c2f6);
    cursor: pointer;
  }
  .fx-back-to-top[hidden] {
    display: none;
  }
  .fx-back-to-top:hover {
    background: var(--fx-primary, #03c2f6);
    color: #131313;
  }
  .fx-back-to-top:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  @media (max-width: 1251px) {
    .fx-footer .footer-bottom {
      margin-right: 24px;
      margin-left: 24px;
    }
  }
  @media (max-width: 991px) {
    .fx-footer .footer-content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 48px;
      padding-top: 56px;
    }
    .fx-footer .footer-bottom {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 575px) {
    .fx-footer .footer-content {
      grid-template-columns: 1fr;
      padding: 40px 24px;
      gap: 30px;
    }
    .fx-footer .footer-col h3 {
      margin-bottom: 18px;
    }
    .fx-footer .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }
    .fx-back-to-top {
      right: 16px;
      bottom: 16px;
      width: 44px;
      height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-footer .footer-social a {
      transition: none;
    }
  }
</style>

<script>
  function setupMarketingTheme() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-marketing-theme]');
    const update = (theme: string) => {
      buttons.forEach((button) => {
        const active = button.dataset.marketingTheme === theme;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };
    const stored =
      localStorage.getItem('theme') ||
      document.querySelector<HTMLElement>('.theme-switcher')?.dataset.defaultTheme ||
      'system';
    update(stored);
    buttons.forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const theme = button.dataset.marketingTheme || 'system';
        localStorage.setItem('theme', theme);
        const dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.classList.toggle('light', !dark);
        update(theme);
      });
    });
  }
  function updateBackToTop() {
    const button = document.querySelector<HTMLButtonElement>('.fx-back-to-top');
    if (button) button.hidden = window.scrollY < 400;
  }
  function setupBackToTop() {
    const button = document.querySelector<HTMLButtonElement>('.fx-back-to-top');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';
    button.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      });
      document.querySelector<HTMLAnchorElement>('#marketing-header .site-logo')?.focus({ preventScroll: true });
    });
    updateBackToTop();
  }
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (localStorage.getItem('theme') !== 'system') return;
    document.documentElement.classList.toggle('dark', event.matches);
    document.documentElement.classList.toggle('light', !event.matches);
  });
  window.addEventListener('scroll', updateBackToTop, { passive: true });
  setupMarketingTheme();
  setupBackToTop();
  document.addEventListener('astro:page-load', () => {
    setupMarketingTheme();
    setupBackToTop();
  });
</script>
