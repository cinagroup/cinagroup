---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { SITE } from 'astrowind:config';
import { loadSitePresentation } from '~/emdash/site-presentation';
import { flattenPresentationMenu, type PresentationMenuItem } from '~/emdash/site-presentation-model';
import { footerData, headerData } from '~/navigation';
import { changeLangPath, getLangFromUrl, getLocalizedLabel, languages, localizeInternalHref, type Lang } from '~/i18n';

interface Props {
  languageAlternates?: Array<{ hreflang: string; href: string }>;
}

const { languageAlternates = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = {
  en: {
    pricing: 'Pricing',
    home: 'CinaGroup home',
    follow: 'Follow us',
    email: 'Email',
    menu: 'Main navigation',
    language: 'Language',
  },
  zh: { pricing: '价格', home: '海内集团首页', follow: '关注我们', email: '邮箱', menu: '主导航', language: '语言' },
  ja: {
    pricing: '料金',
    home: 'CinaGroup ホーム',
    follow: 'フォローする',
    email: 'メール',
    menu: 'メインナビゲーション',
    language: '言語',
  },
  ko: { pricing: '가격', home: 'CinaGroup 홈', follow: '팔로우', email: '이메일', menu: '주 메뉴', language: '언어' },
  ru: {
    pricing: 'Стоимость',
    home: 'Главная CinaGroup',
    follow: 'Мы в соцсетях',
    email: 'Почта',
    menu: 'Главное меню',
    language: 'Язык',
  },
  es: {
    pricing: 'Precios',
    home: 'Inicio de CinaGroup',
    follow: 'Síguenos',
    email: 'Correo',
    menu: 'Navegación principal',
    language: 'Idioma',
  },
  pt: {
    pricing: 'Preços',
    home: 'Página inicial CinaGroup',
    follow: 'Siga-nos',
    email: 'E-mail',
    menu: 'Navegação principal',
    language: 'Idioma',
  },
  fr: {
    pricing: 'Tarifs',
    home: 'Accueil CinaGroup',
    follow: 'Nous suivre',
    email: 'E-mail',
    menu: 'Navigation principale',
    language: 'Langue',
  },
}[lang];
const label = (text: string) => getLocalizedLabel(lang, text);
const href = (url?: string) => localizeInternalHref(url, lang);
const alternates = new Map(languageAlternates.map((item) => [item.hreflang, item.href]));
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (url: string) => (url.replace(/\/+$/, '') || '/') === currentPath;
const presentation = await loadSitePresentation(Astro);
const siteName = getLocalizedLabel(lang, presentation.siteName ?? SITE?.name) ?? 'CinaGroup';
const homeLabel = copy.home.replace(lang === 'zh' ? '海内集团' : 'CinaGroup', siteName);
const contactEmail = presentation.contactEmail ?? 'info@cinagroup.com';
const socialLinks = presentation.socialLinks ?? footerData.socialLinks;
const primaryItems: PresentationMenuItem[] = presentation.menus.primary ?? [
  ...headerData.links.map((group) => ({
    label: label(group.text) ?? group.text,
    url: '#',
    children: group.links.map((item) => ({
      label: label(item.text) ?? item.text,
      url: href(item.href) ?? '#',
      children: [],
    })),
  })),
  { label: copy.pricing, url: href('/pricing/') ?? '#', children: [] },
];
const groupLinks = (group: PresentationMenuItem) =>
  flattenPresentationMenu([...(group.url === '#' ? [] : [{ ...group, children: [] }]), ...group.children]).filter(
    (item) => item.url !== '#'
  );
const ctaLabel = presentation.headerCtaLabel ?? label('Contact');
const ctaHref = presentation.headerCtaHref ?? href('/contact/');
---

<header class="site-header fx-header" id="marketing-header">
  <a href={href('/')} class="site-logo fx-header-logo" aria-label={homeLabel}>
    <Logo variant="light" />
  </a>
  <div class="fx-header-body">
    <div class="fx-topbar">
      <div class="fx-topbar-social">
        <span>{copy.follow}:</span>
        {
          socialLinks.map((item) => (
            <a href={item.href} aria-label={item.ariaLabel}>
              <Icon name={item.icon} width={15} height={15} />
            </a>
          ))
        }
      </div>
      <a href={`mailto:${contactEmail}`} class="fx-topbar-contact">
        <Icon name="tabler:mail" width={17} height={17} />
        <span>{copy.email}: <strong>{contactEmail}</strong></span>
      </a>
    </div>
    <div class="nav fx-header-main">
      <nav class="nav-links" aria-label={copy.menu}>
        {
          primaryItems.map((group) =>
            group.children.length ? (
              <details class="nav-group">
                <summary>
                  {group.label}
                  <Icon name="tabler:chevron-down" width={13} height={13} />
                </summary>
                <div class="nav-dropdown">
                  {groupLinks(group).map((item) => (
                    <a
                      href={item.url}
                      target={item.target}
                      rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                      aria-current={isCurrent(item.url) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={group.url}
                target={group.target}
                rel={group.target === '_blank' ? 'noopener noreferrer' : undefined}
                aria-current={isCurrent(group.url) ? 'page' : undefined}
              >
                {group.label}
              </a>
            )
          )
        }
      </nav>
      <div class="nav-actions">
        <details class="nav-group language-menu">
          <summary aria-label={`${copy.language}: ${languages[lang]}`}>
            <Icon name="tabler:world" width={19} height={19} />
            <span class="fx-language-label">{languages[lang]}</span>
            <Icon name="tabler:chevron-down" width={13} height={13} class="fx-language-chevron" />
          </summary>
          <div class="nav-dropdown">
            {
              Object.entries(languages).map(([locale, text]) => (
                <a
                  href={alternates.get(locale) ?? changeLangPath(Astro.url, locale as Lang)}
                  hreflang={locale}
                  lang={locale}
                  aria-current={locale === lang ? 'true' : undefined}
                >
                  {text}
                </a>
              ))
            }
          </div>
        </details>
        <a href={ctaHref} class="nav-cta fx-header-cta">
          {ctaLabel}
          <Icon name="tabler:arrow-up-right" width={18} height={18} />
        </a>
        <details class="mobile-menu">
          <summary aria-label={copy.menu}><Icon name="tabler:menu-2" width={25} height={25} /></summary>
          <nav class="mobile-links" aria-label={copy.menu}>
            {
              primaryItems.map((group) =>
                group.children.length ? (
                  <div class="fx-mobile-group">
                    <h3>{group.label}</h3>
                    {groupLinks(group).map((item) => (
                      <a
                        href={item.url}
                        target={item.target}
                        rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                        aria-current={isCurrent(item.url) ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                ) : (
                  <a
                    class="fx-mobile-pricing"
                    href={group.url}
                    target={group.target}
                    rel={group.target === '_blank' ? 'noopener noreferrer' : undefined}
                    aria-current={isCurrent(group.url) ? 'page' : undefined}
                  >
                    {group.label}
                  </a>
                )
              )
            }
            <a class="fx-mobile-pricing" href={ctaHref}>{ctaLabel}</a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  .fx-header.site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    width: 100%;
    min-height: 120px;
    background: var(--color-bg, #fff);
    color: var(--color-text, #131313);
    border: 0;
    box-shadow: 0 2px 12px #00000009;
  }
  .fx-header .fx-header-logo {
    position: relative;
    display: flex;
    width: 224px;
    min-width: 224px;
    align-items: center;
    padding: 20px 24px;
    background: none;
    isolation: isolate;
  }
  .fx-header .fx-header-logo :global(img[src='/brand/cinagroup-horizontal.png']) {
    display: block;
  }
  .fx-header .fx-header-logo :global(img[src='/brand/cinagroup-horizontal-white.png']) {
    display: none;
  }
  .fx-header-logo::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--fx-primary, #03c2f6);
    clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
  }
  .fx-header-body {
    flex: 1;
    min-width: 0;
  }
  .fx-topbar {
    display: flex;
    height: 40px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0 30px;
    border-bottom: 1px solid var(--color-border, #dedede);
    font-size: 12px;
  }
  .fx-topbar-social,
  .fx-topbar-contact {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .fx-topbar-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 28px;
  }
  .fx-topbar-contact {
    gap: 8px;
    white-space: nowrap;
  }
  .fx-topbar-contact strong {
    font-weight: 500;
  }
  .fx-topbar-social a:hover,
  .fx-topbar-contact:hover {
    color: var(--fx-primary, #03c2f6);
  }
  .fx-header .fx-header-main {
    position: static;
    max-width: none;
    min-height: 80px;
    height: 80px;
    padding: 0 0 0 30px;
    margin: 0;
    gap: 12px;
  }
  .fx-header .nav-links {
    display: flex;
    flex: 1;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(12px, 1.7vw, 26px);
    margin: 0;
  }
  .fx-header .nav-links > a,
  .fx-header .nav-group summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    color: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
    list-style: none;
  }
  .fx-header .nav-links > a:hover,
  .fx-header .nav-group summary:hover,
  .fx-header a[aria-current='page'] {
    color: var(--fx-primary, #03c2f6);
  }
  .fx-header .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0;
  }
  .fx-header .nav-group {
    position: relative;
  }
  .fx-header summary {
    cursor: pointer;
  }
  .fx-header summary::-webkit-details-marker {
    display: none;
  }
  .fx-header .nav-dropdown {
    position: absolute;
    top: calc(100% + 18px);
    left: -16px;
    z-index: 2;
    width: max-content;
    min-width: 250px;
    max-width: min(350px, calc(100vw - 32px));
    padding: 12px 16px;
    border: 1px solid var(--color-border, #dedede);
    border-top: 3px solid var(--fx-primary, #03c2f6);
    border-radius: 0;
    background: var(--color-bg, #fff);
    box-shadow: 0 12px 26px #00000018;
  }
  .fx-header .nav-dropdown a {
    display: block;
    padding: 10px 0;
    border-radius: 0;
    color: var(--color-text, #131313);
    font-size: 13px;
    line-height: 1.6;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .fx-header .nav-dropdown a:hover,
  .fx-header .nav-dropdown a[aria-current] {
    color: var(--fx-primary, #03c2f6);
    background: transparent;
  }
  .fx-header .language-menu .nav-dropdown {
    right: 0;
    left: auto;
    min-width: 170px;
  }
  .fx-header .nav-actions > .fx-header-cta {
    display: inline-flex;
    height: 80px;
    min-width: 174px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 28px 0 42px;
    border-radius: 0;
    background: var(--fx-primary, #03c2f6);
    color: #131313;
    font-size: 14px;
    font-weight: 600;
    clip-path: polygon(13% 0, 100% 0, 100% 100%, 0 100%);
    transition: background 160ms ease;
  }
  .fx-header .fx-header-cta:hover {
    background: var(--fx-primary-hover, #42d7ff);
  }
  .fx-header .mobile-menu {
    display: none;
  }
  .fx-header :is(a, summary):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  @media (min-width: 1200px) {
    .fx-header.site-header {
      min-height: 133px;
    }
    .fx-header .fx-header-logo {
      width: 16.666666vw;
      min-width: 224px;
    }
    .fx-topbar {
      height: 52px;
      font-size: 14px;
    }
    .fx-header .fx-header-main,
    .fx-header .nav-actions > .fx-header-cta {
      height: 81px;
      min-height: 81px;
    }
    .fx-header .nav-links > a,
    .fx-header .nav-group summary {
      font-size: 16px;
    }
  }
  @media (min-width: 992px) {
    .fx-header.site-header.fx-header-scrolled {
      min-height: 80px;
      /* Preserve document flow so collapsing the sticky bar does not move the scroll threshold. */
      margin-bottom: 40px;
    }
    .fx-header.fx-header-scrolled .fx-topbar {
      display: none;
    }
    .fx-header.fx-header-scrolled .fx-header-logo {
      height: 80px;
      padding-top: 12px;
      padding-bottom: 12px;
    }
    .fx-header.fx-header-scrolled .fx-header-main,
    .fx-header.fx-header-scrolled .nav-actions > .fx-header-cta {
      height: 80px;
      min-height: 80px;
    }
  }
  @media (min-width: 1200px) {
    .fx-header.site-header.fx-header-scrolled {
      margin-bottom: 53px;
    }
  }
  @media (min-width: 992px) and (max-width: 1199px) {
    .fx-header .fx-header-logo {
      width: 204px;
      min-width: 204px;
      padding-left: 17px;
      padding-right: 17px;
    }
    .fx-header .fx-header-main {
      padding-left: 16px;
    }
    .fx-header .nav-links {
      gap: 12px;
    }
    .fx-header .nav-links > a,
    .fx-header .nav-group summary {
      font-size: 12px;
      gap: 4px;
    }
    .fx-header .nav-actions {
      gap: 12px;
    }
    .fx-header .nav-actions > .fx-header-cta {
      min-width: 130px;
      padding-right: 18px;
      padding-left: 30px;
      font-size: 12px;
    }
    .fx-language-chevron {
      display: none;
    }
  }
  @media (max-width: 991px) {
    .fx-header.site-header {
      min-height: 80px;
    }
    .fx-header .fx-header-logo {
      width: 205px;
      min-width: 205px;
      padding: 12px 16px;
    }
    .fx-topbar,
    .fx-header .nav-links,
    .fx-header .nav-actions > .fx-header-cta {
      display: none;
    }
    .fx-header .fx-header-main {
      justify-content: flex-end;
      padding: 0 14px 0 0;
    }
    .fx-header .nav-actions {
      gap: 6px;
      margin-left: auto;
    }
    .fx-header .language-menu summary,
    .fx-header .mobile-menu > summary {
      display: flex;
      width: 42px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--color-border, #dedede);
      border-radius: 4px;
      list-style: none;
    }
    .fx-language-label,
    .fx-language-chevron {
      display: none;
    }
    .fx-header .mobile-menu {
      display: block;
    }
    .fx-header .mobile-links {
      position: absolute;
      top: 80px;
      right: 0;
      left: 0;
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      padding: 16px 24px 24px;
      border-bottom: 3px solid var(--fx-primary, #03c2f6);
      background: var(--color-bg, #fff);
      box-shadow: 0 14px 24px #00000015;
    }
    .fx-mobile-group {
      padding: 14px 0;
      border-bottom: 1px solid var(--color-border, #dedede);
    }
    .fx-header .mobile-links h3 {
      margin: 0 0 6px;
      color: var(--color-text, #131313);
      font-size: 15px;
      font-weight: 600;
    }
    .fx-header .mobile-links a {
      display: block;
      padding: 8px 0;
      color: var(--color-text, #131313);
      font-size: 14px;
      line-height: 1.7;
      overflow-wrap: anywhere;
    }
    .fx-header .mobile-links a:hover,
    .fx-header .mobile-links a[aria-current='page'] {
      color: var(--fx-primary, #03c2f6);
    }
    .fx-header .mobile-links .fx-mobile-pricing {
      padding-top: 18px;
      font-weight: 600;
    }
    .fx-header .language-menu .nav-dropdown {
      top: calc(100% + 18px);
      right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-header .fx-header-cta {
      transition: none;
    }
  }
</style>

<script>
  const desktopHeaderQuery = matchMedia('(min-width: 992px)');
  function updateMarketingHeaderScroll() {
    document
      .getElementById('marketing-header')
      ?.classList.toggle('fx-header-scrolled', desktopHeaderQuery.matches && window.scrollY > 52);
  }
  const headerScrollWindow = window as Window & { cinaFlexinaHeaderScrollBound?: boolean };
  if (!headerScrollWindow.cinaFlexinaHeaderScrollBound) {
    window.addEventListener('scroll', updateMarketingHeaderScroll, { passive: true });
    desktopHeaderQuery.addEventListener('change', updateMarketingHeaderScroll);
    headerScrollWindow.cinaFlexinaHeaderScrollBound = true;
  }
  function setupMarketingNavigation() {
    updateMarketingHeaderScroll();
    const header = document.getElementById('marketing-header');
    if (!header || header.dataset.bound) return;
    header.dataset.bound = 'true';
    const menus = header.querySelectorAll<HTMLDetailsElement>('details');
    menus.forEach((menu) =>
      menu.addEventListener('toggle', () => {
        if (!menu.open) return;
        menus.forEach((other) => {
          if (other !== menu) other.open = false;
        });
      })
    );
    header.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const menu = Array.from(menus).find((item) => item.open);
      if (!menu) return;
      event.preventDefault();
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
    header.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menus.forEach((menu) => {
          menu.open = false;
        });
      })
    );
  }
  document.addEventListener('click', (event) => {
    const header = document.getElementById('marketing-header');
    if (!header || header.contains(event.target as Node)) return;
    header.querySelectorAll<HTMLDetailsElement>('details').forEach((menu) => {
      menu.open = false;
    });
  });
  setupMarketingNavigation();
  document.addEventListener('astro:page-load', setupMarketingNavigation);
</script>
