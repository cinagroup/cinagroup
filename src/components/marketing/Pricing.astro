---
import PricingDisclosure from '~/components/PricingDisclosure.astro';
import { sanitizeHref } from 'emdash';
import type { PricingValue } from './types';

interface Props {
  value: PricingValue;
}

const { value } = Astro.props;
const { anchor_id, headline, plans: rawPlans } = value;

const plans = rawPlans.map((plan) => ({
  ...plan,
  features: (plan.features ?? '')
    .split('\n')
    .map((s) => s.trim())
    .filter(Boolean),
  cta: {
    label: plan.cta_label,
    url: sanitizeHref(plan.cta_url),
  },
}));
---

<section class="pricing section flexina-pricing" id={anchor_id || undefined}>
  <div class="container">
    {
      headline && (
        <header class="section-header pricing-header">
          <h2 class="section-headline">{headline}</h2>
        </header>
      )
    }
    <div class="pricing-grid">
      {
        plans.map((plan) => (
          <article class:list={['pricing-card', { 'pricing-highlighted': plan.highlighted }]}>
            {plan.badge && <div class="pricing-badge">{plan.badge}</div>}
            <div class="pricing-plan-header">
              <h3 class="pricing-name">{plan.name}</h3>
              {plan.price && (
                <div class="pricing-price">
                  <span class="pricing-amount">{plan.price}</span>
                  {plan.period && <span class="pricing-period">{plan.period}</span>}
                </div>
              )}
              {plan.description && <p class="pricing-description">{plan.description}</p>}
            </div>
            {plan.quote && <PricingDisclosure {...plan.quote} />}
            <ul class="pricing-features">
              {plan.features.map((feature) => (
                <li>
                  <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
            <a
              href={plan.cta.url}
              class:list={[
                'btn',
                'btn-lg',
                'pricing-cta',
                { 'btn-primary': plan.highlighted, 'btn-secondary': !plan.highlighted },
              ]}
            >
              {plan.cta.label}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .flexina-pricing {
    font-family: var(--font-family-body);
  }

  .pricing-header {
    margin-bottom: 48px;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
    align-items: stretch;
  }

  .pricing-card {
    position: relative;
    min-width: 0;
    padding: 48px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow-wrap: anywhere;
    transition:
      border-color 250ms ease,
      box-shadow 250ms ease;
  }

  .pricing-highlighted,
  .pricing-card:hover,
  .pricing-card:focus-within {
    border-color: var(--color-brand);
    box-shadow: 0 17px 39px rgba(6, 33, 101, 0.15);
  }

  .pricing-badge {
    position: absolute;
    top: 0;
    left: 50%;
    max-width: calc(100% - 32px);
    transform: translate(-50%, -50%);
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-on-brand);
    background: var(--color-brand);
    border-radius: 100px;
    text-align: center;
  }

  .pricing-plan-header {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .pricing-name {
    font-family: var(--font-family-heading);
    font-size: 24px;
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 16px;
  }

  .pricing-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
  }

  .pricing-amount {
    color: var(--color-brand);
    font-family: var(--font-family-heading);
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
  }

  .pricing-period {
    font-size: 16px;
    color: var(--color-muted);
  }

  .pricing-description {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .pricing-card :global(.cg-price-disclosure) {
    min-width: 0;
    line-height: 1.7;
  }

  .pricing-card :global(.cg-price-disclosure dl) {
    grid-template-columns: minmax(0, 1fr);
  }

  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pricing-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 16px;
    line-height: 1.7;
  }

  .check-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-brand);
    margin-top: 4px;
  }

  .pricing-cta {
    width: 100%;
    margin-top: 6px;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (max-width: 991px) {
    .pricing-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pricing-card {
      padding: 30px;
    }
  }

  @media (max-width: 575px) {
    .pricing-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .pricing-card {
      padding: 24px;
    }

    .pricing-header {
      margin-bottom: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-card {
      transition: none;
    }
  }
</style>
