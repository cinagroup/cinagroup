const subjectValues = [
  'product-workflow',
  'search-knowledge',
  'automation',
  'api-model-gateway',
  'infrastructure-delivery',
  'other',
] as const;

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const content = copy[lang];
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || '0x4AAAAAAEigqtYgQBcKUhpa';
---

<form
  id="contact-form"
  class="cg-form-card"
  action="/api/contact"
  method="POST"
  enctype="application/x-www-form-urlencoded"
  accept-charset="UTF-8"
  data-contact-submission
  data-sending={content.sending}
  data-success={content.success}
  data-reference={content.reference}
  data-error={content.error}
  data-error-summary={content.errorSummary}
  data-field-error={content.fieldError}
  data-network={content.network}
  aria-busy="false"
>
  <input type="hidden" name="locale" value={lang} />
  <input type="hidden" name="submission_id" value="" />

  <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
    <label for={`contact-website-${lang}`}>Website</label>
    <input id={`contact-website-${lang}`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cg-field">
    <label for={`contact-name-${lang}`}>{content.name}</label>
    <input
      id={`contact-name-${lang}`}
      name="name"
      type="text"
      autocomplete="name"
      minlength="2"
      maxlength="100"
      aria-describedby={`contact-name-error-${lang}`}
      required
    />
    <p
      id={`contact-name-error-${lang}`}
      class="m-0 text-sm text-red-700 dark:text-red-300"
      data-field-error-for="name"
      hidden
    >
    </p>
  </div>
  <div class="cg-field">
    <label for={`contact-email-${lang}`}>{content.email}</label>
    <input
      id={`contact-email-${lang}`}
      name="email"
      type="email"
      autocomplete="email"
      maxlength="254"
      aria-describedby={`contact-email-error-${lang}`}
      required
    />
    <p
      id={`contact-email-error-${lang}`}
      class="m-0 text-sm text-red-700 dark:text-red-300"
      data-field-error-for="email"
      hidden
    >
    </p>
  </div>
  <div class="cg-field">
    <label for={`contact-company-${lang}`}>{content.company} <span>({content.optional})</span></label>
    <input
      id={`contact-company-${lang}`}
      name="company"
      type="text"
      autocomplete="organization"
      maxlength="120"
      aria-describedby={`contact-company-error-${lang}`}
    />
    <p
      id={`contact-company-error-${lang}`}
      class="m-0 text-sm text-red-700 dark:text-red-300"
      data-field-error-for="company"
      hidden
    >
    </p>
  </div>
  <div class="cg-field">
    <label for={`contact-subject-${lang}`}>{content.subject}</label>
    <select id={`contact-subject-${lang}`} name="subject" aria-describedby={`contact-subject-error-${lang}`} required>
      <option value="">{content.choose}</option>
      {subjectValues.map((value, index) => <option value={value}>{content.subjects[index]}</option>)}
    </select>
    <p
      id={`contact-subject-error-${lang}`}
      class="m-0 text-sm text-red-700 dark:text-red-300"
      data-field-error-for="subject"
      hidden
    >
    </p>
  </div>
  <div class="cg-field">
    <label for={`contact-message-${lang}`}>{content.message}</label>
    <textarea
      id={`contact-message-${lang}`}
      name="message"
      rows="7"
      minlength="20"
      maxlength="4000"
      aria-describedby={`contact-message-error-${lang}`}
      required></textarea>
    <p
      id={`contact-message-error-${lang}`}
      class="m-0 text-sm text-red-700 dark:text-red-300"
      data-field-error-for="message"
      hidden
    >
    </p>
  </div>
  <div
    class="cf-turnstile"
    data-sitekey={turnstileSiteKey}
    data-action="contact"
    data-language={lang}
    role="group"
    aria-label={content.challenge}
    data-contact-turnstile
  >
  </div>
  <button class="cg-page-button cg-page-button-primary" type="submit">{content.submit}</button>
  <p class="cg-form-note">
    {content.noteBefore}
    <a href="/privacy/">{content.privacy}</a>
    {content.and}
    <a href="/terms/">{content.terms}</a>{content.noteAfter}
  </p>
  <noscript>
    <p class="cg-form-note">{content.noScript} <a href="mailto:info@cinagroup.com">info@cinagroup.com</a>.</p>
  </noscript>
  <p class="cg-form-note">{content.direct}</p>
  <p class="cg-form-status" role="status" aria-live="polite" tabindex="-1" data-contact-status hidden></p>
</form>

<script>
  const resetContactTurnstile = (form: HTMLFormElement) => {
    const widget = form.querySelector('[data-contact-turnstile]');
    const turnstile = (
      window as Window & {
        turnstile?: { reset(container?: string | HTMLElement): void };
      }
    ).turnstile;
    if (widget instanceof HTMLElement && turnstile) turnstile.reset(widget);
  };

  const initializeContactForms = () => {
    document.querySelectorAll('form[data-contact-submission]').forEach((element) => {
      if (!(element instanceof HTMLFormElement) || element.dataset.initialized === 'true') return;
      element.dataset.initialized = 'true';

      element.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!element.reportValidity()) return;

        const status = element.querySelector('[data-contact-status]');
        const button = element.querySelector('button[type="submit"]');
        const submissionId = element.elements.namedItem('submission_id');
        if (!(status instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;

        if (submissionId instanceof HTMLInputElement && !submissionId.value && 'randomUUID' in crypto) {
          submissionId.value = crypto.randomUUID();
        }

        const fieldErrorNodes = [...element.querySelectorAll('[data-field-error-for]')].filter(
          (node) => node instanceof HTMLElement
        );
        element.querySelectorAll('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));
        fieldErrorNodes.forEach((node) => {
          node.hidden = true;
          node.textContent = '';
        });
        status.setAttribute('role', 'status');
        status.hidden = false;
        status.textContent = element.dataset.sending || '';
        element.setAttribute('aria-busy', 'true');
        button.disabled = true;

        try {
          const body = new URLSearchParams();
          new FormData(element).forEach((value, key) => {
            if (typeof value === 'string') body.append(key, value);
          });
          const response = await fetch(element.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
            },
            body: body.toString(),
          });
          const payload = await response.json().catch(() => null);

          if (!response.ok || !payload?.ok) {
            const fields = payload?.error?.fields;
            const visibleLabels: string[] = [];
            if (fields && typeof fields === 'object' && !Array.isArray(fields)) {
              Object.keys(fields).forEach((fieldName) => {
                const field = element.elements.namedItem(fieldName);
                if (
                  field instanceof HTMLInputElement ||
                  field instanceof HTMLSelectElement ||
                  field instanceof HTMLTextAreaElement
                ) {
                  if (field.type === 'hidden') return;
                  field.setAttribute('aria-invalid', 'true');
                  const label = field.labels?.[0]?.textContent?.trim() || fieldName;
                  visibleLabels.push(label);
                  const errorNode = fieldErrorNodes.find((node) => node.dataset.fieldErrorFor === fieldName);
                  if (errorNode) {
                    errorNode.hidden = false;
                    errorNode.textContent = `${label}: ${element.dataset.fieldError || ''}`;
                  }
                }
              });
            }
            status.setAttribute('role', 'alert');
            status.textContent = visibleLabels.length
              ? `${element.dataset.errorSummary || ''} ${visibleLabels.join(', ')}`
              : element.dataset.error || '';
            resetContactTurnstile(element);
            status.focus();
            return;
          }

          status.setAttribute('role', 'status');
          status.textContent = `${element.dataset.success || ''} ${element.dataset.reference || ''}: ${payload.submissionId}`;
          element.reset();
          resetContactTurnstile(element);
        } catch {
          status.setAttribute('role', 'alert');
          status.textContent = element.dataset.network || '';
          resetContactTurnstile(element);
          status.focus();
        } finally {
          element.setAttribute('aria-busy', 'false');
          button.disabled = false;
        }
      });
    });
  };

  initializeContactForms();
  document.addEventListener('astro:page-load', initializeContactForms);
</script>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
