---
import { DEFAULT_PRICING_COPY, DEFAULT_PRICING_DISCLOSURES, type Locale } from '~/data/site/pricing-defaults.ts';
import { getPublishedPageCopy, getPageCopyMetadata } from '~/emdash/published-page-copy.ts';
import CinaPageHero from '~/components/CinaPageHero.astro';
import Pricing from '~/components/marketing/Pricing.astro';
import Layout from '~/layouts/PageLayout.astro';

const { lang } = Astro.props as { lang: Locale };
const page = await getPublishedPageCopy(Astro, 'page_pricing', 'pricing', DEFAULT_PRICING_COPY[lang]);
const details = DEFAULT_PRICING_DISCLOSURES[lang];
const contactHref = `/${lang}/contact/`;
const servicesHref = `/${lang}/services/`;
const metadata = await getPageCopyMetadata(Astro, { title: page.metadataTitle });
---

<Layout {metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={page.eyebrow}
      title={page.title}
      lead={page.lead}
      primary={{ text: page.primary, href: contactHref }}
      secondary={{ text: page.secondary, href: servicesHref }}
    />

    <Pricing
      value={{
        anchor_id: 'localized-pricing-title',
        headline: page.sectionTitle,
        plans: page.cards.map((card, index) => ({
          name: card.label,
          description: `${card.title} ${card.description}`,
          features: card.items.join('\n'),
          cta_label: page.primary,
          cta_url: contactHref,
          highlighted: index === 1,
          quote: { ...details.cards[index], labels: details.labels },
        })),
      }}
    />
    <p class="cg-pricing-terms">{details.disclaimer}</p>
    <section class="cg-page-section cg-page-section-soft" aria-labelledby="localized-factors-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{page.factorsEyebrow}</p><h2 id="localized-factors-title">{page.factorsTitle}</h2>
        </div><div class="cg-list-panel">
          {
            page.factors.map((factor) => (
              <div class="cg-list-row">
                <>
                  <strong>{factor.title}</strong>
                  <span>{factor.description}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
