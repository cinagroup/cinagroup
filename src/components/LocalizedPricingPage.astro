const { lang } = Astro.props as { lang: Locale };
const page = content[lang];
const details = transparency[lang];
const contactHref = `/${lang}/contact/`;
const servicesHref = `/${lang}/services/`;
---

<Layout metadata={{ title: page.metadataTitle }}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={page.eyebrow}
      title={page.title}
      lead={page.lead}
      primary={{ text: page.primary, href: contactHref }}
      secondary={{ text: page.secondary, href: servicesHref }}
    />
    <section class="cg-page-section" aria-labelledby="localized-pricing-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">{page.sectionEyebrow}</p><h2 id="localized-pricing-title">{page.sectionTitle}</h2><p>
            {page.sectionLead}
          </p>
        </div><div class="cg-pricing-grid">
          {
            page.cards.map((card, index) => (
              <article class:list={['cg-price-card', { 'cg-price-card-featured': index === 1 }]}>
                <>
                  <p class="cg-card-meta">{card.label}</p>
                  <h3>{card.title}</h3>
                  <p>{card.description}</p>
                  <PricingDisclosure
                    budget={details.cards[index].budget}
                    timeline={details.cards[index].timeline}
                    included={details.cards[index].included}
                    excluded={details.cards[index].excluded}
                    labels={details.labels}
                  />
                  <ul>
                    {card.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <a class:list={['cg-page-button', { 'cg-page-button-primary': index !== 1 }]} href={contactHref}>
                    {page.primary}
                  </a>
                </>
              </article>
            ))
          }
        </div>
        <p class="cg-pricing-terms">{details.disclaimer}</p>
      </div>
    </section>
    <section class="cg-page-section cg-page-section-soft" aria-labelledby="localized-factors-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{page.factorsEyebrow}</p><h2 id="localized-factors-title">{page.factorsTitle}</h2>
        </div><div class="cg-list-panel">
          {
            page.factors.map((factor) => (
              <div class="cg-list-row">
                <>
                  <strong>{factor.title}</strong>
                  <span>{factor.description}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
