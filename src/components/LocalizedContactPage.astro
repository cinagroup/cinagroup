---
import { DEFAULT_CONTACT_COPY, type Locale } from '~/data/site/contact-defaults.ts';
import { getPublishedPageCopy, getPageCopyMetadata } from '~/emdash/published-page-copy.ts';
import CinaPageHero from '~/components/CinaPageHero.astro';
import ContactSubmissionForm from '~/components/ContactSubmissionForm.astro';
import Layout from '~/layouts/PageLayout.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = await getPublishedPageCopy(Astro, 'page_contact', 'contact', DEFAULT_CONTACT_COPY[lang]);
const metadata = await getPageCopyMetadata(Astro, { title: content.title, description: content.description });
---

<Layout {metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={content.eyebrow}
      title={content.heroTitle}
      lead={content.heroLead}
      primary={{ text: content.email, href: '#contact-form' }}
      secondary={{ text: content.services, href: `/${lang}/services/` }}
    />

    <section class="cg-page-section" aria-labelledby="localized-contact-context">
      <div class="cg-page-shell cg-contact-grid">
        <div>
          <div class="cg-section-heading">
            <p class="cg-eyebrow">{content.contextEyebrow}</p>
            <h2 id="localized-contact-context">{content.contextTitle}</h2>
            <p>{content.contextLead}</p>
          </div>
          <div class="cg-list-panel">
            {
              content.items.map(([label, description]) => (
                <div class="cg-list-row">
                  <>
                    <strong>{label}</strong>
                    <span>{description}</span>
                  </>
                </div>
              ))
            }
          </div>
        </div>
        <ContactSubmissionForm lang={lang} />
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="localized-contact-direct">
      <div class="cg-page-shell cg-section-heading cg-section-heading-center">
        <p class="cg-eyebrow">{content.directEyebrow}</p>
        <h2 id="localized-contact-direct">{content.directTitle}</h2>
        <p>{content.directLead}</p>
        <div class="cg-page-actions">
          <a class="cg-page-button cg-page-button-primary" href="mailto:info@cinagroup.com">{content.email}</a>
        </div>
        <p class="cg-form-note">
          <a href={`/${lang}/privacy/`}>{content.privacy}</a> · <a href={`/${lang}/terms/`}>{content.terms}</a>
        </p>
      </div>
    </section>
  </div>
</Layout>
