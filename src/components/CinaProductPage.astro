---
import CinaPageHero from '~/components/CinaPageHero.astro';
import ProductEvidence from '~/components/ProductEvidence.astro';
import Layout from '~/layouts/PageLayout.astro';
import type { MetaData } from '~/types';
import { PRODUCT_PAGE_TEXT_DEFAULTS } from '~/data/site/english-page-defaults';
import type { EnglishTextCopy } from '~/emdash/english-page-text-model';

export interface Props {
  product: 'cinaseek' | 'cinaclaw' | 'cinatoken' | 'cinaskill' | 'cinachain';
  metadata: MetaData;
  pageText?: EnglishTextCopy<typeof PRODUCT_PAGE_TEXT_DEFAULTS>;
  eyebrow: string;
  title: string;
  lead: string;
  primary: { text: string; href: string };
  secondary?: { text: string; href: string };
  capabilities: Array<{ label: string; title: string; description: string }>;
  workflow: Array<{ title: string; description: string }>;
  workflowTitle: string;
  workflowLead: string;
  codeLabel: string;
  code: string;
  principles: Array<{ title: string; description: string }>;
}

const { pageText = PRODUCT_PAGE_TEXT_DEFAULTS } = Astro.props;
const copy = pageText;

const {
  product,
  metadata,
  eyebrow,
  title,
  lead,
  primary,
  secondary,
  capabilities,
  workflow,
  workflowTitle,
  workflowLead,
  codeLabel,
  code,
  principles,
} = Astro.props;
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <CinaPageHero {eyebrow} {title} {lead} {primary} {secondary} />

    <ProductEvidence {product} />

    <section class="cg-page-section" aria-labelledby="capabilities-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.shared_capabilities_eyebrow}</p>
          <h2 id="capabilities-title">{copy.shared_capabilities_heading}</h2>
          <p>
            These are reference workflow patterns, not a promise that every capability is enabled in every release or
            deployment. Start with the smallest useful workflow and confirm current availability against the evidence
            above.
          </p>
        </div>
        <div class="cg-card-grid">
          {
            capabilities.map((item) => (
              <article class="cg-card">
                <p class="cg-card-meta">{item.label}</p>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="workflow-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.shared_workflow_eyebrow}</p>
          <h2 id="workflow-title">{workflowTitle}</h2>
          <p>{workflowLead}</p>
        </div>
        <div class="cg-list-panel">
          {
            workflow.map((item, index) => (
              <div class="cg-list-row">
                <strong>
                  {String(index + 1).padStart(2, '0')} / {item.title}
                </strong>
                <span>{item.description}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-dark" aria-labelledby="technical-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{codeLabel}</p>
          <h2 id="technical-title">{copy.shared_technical_heading}</h2>
          <p>{copy.shared_technical_paragraph}</p>
        </div>
        <pre class="cg-code-panel"><code>{code}</code></pre>
      </div>
    </section>

    <section class="cg-page-section" aria-labelledby="principles-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">{copy.shared_principles_eyebrow}</p>
          <h2 id="principles-title">{copy.shared_principles_heading}</h2>
        </div>
        <div class="cg-card-grid">
          {
            principles.map((item) => (
              <article class="cg-card">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="product-cta-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">{copy.shared_product_cta_eyebrow}</p>
          <h2 id="product-cta-title">{copy.shared_product_cta_heading}</h2>
          <p>
            {copy.shared_product_cta_paragraph}
          </p>
          <div class="cg-page-actions">
            <a class="cg-page-button cg-page-button-primary" href="/contact/">{copy.shared_product_cta_link_label}</a>
            <a class="cg-page-button" href="/">{copy.shared_product_cta_link_label_2}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
