---
import { SITE } from 'astrowind:config';
import { getLangFromUrl, getLocalizedLabel } from '~/i18n';

export interface Props {
  imageAlt?: string;
}

const localizedName = getLocalizedLabel(getLangFromUrl(Astro.url), SITE?.name) ?? SITE?.name;
const { imageAlt = localizedName ?? 'CinaGroup' } = Astro.props;
---

<div class="flex shrink-0 items-center">
  <img
    src="/brand/cinagroup-horizontal.png"
    alt={imageAlt}
    class="block h-14 w-auto object-contain dark:hidden"
    width="832"
    height="288"
  />
  <img
    src="/brand/cinagroup-horizontal-white.png"
    alt={imageAlt}
    class="hidden h-14 w-auto object-contain dark:block"
    width="832"
    height="288"
  />
</div>
