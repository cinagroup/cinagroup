---
import { sanitizeHref } from 'emdash';
import { getLangFromUrl, localizeInternalHref } from '~/i18n';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  primary?: { text: string; href: string };
  secondary?: { text: string; href: string };
}

const { eyebrow, title, lead, primary, secondary } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const breadcrumbLabels = {
  en: { home: 'Home', navigation: 'Breadcrumb' },
  zh: { home: '首页', navigation: '面包屑导航' },
  ja: { home: 'ホーム', navigation: 'パンくずリスト' },
  ko: { home: '홈', navigation: '탐색 경로' },
  ru: { home: 'Главная', navigation: 'Навигационная цепочка' },
  es: { home: 'Inicio', navigation: 'Ruta de navegación' },
  pt: { home: 'Início', navigation: 'Navegação estrutural' },
  fr: { home: 'Accueil', navigation: 'Fil d’Ariane' },
}[lang];
const homeHref = getPermalink(localizeInternalHref('/', lang) || '/');
// Existing titles may contain line-break markup. Render their text through Astro's escaping.
const stripMarkup = (text: string) => text.replace(/<br\s*\/?\s*>/gi, ' ').replace(/<[^>]*>/g, '');
const headline = stripMarkup(title);
const primaryHref = primary ? sanitizeHref(getPermalink(primary.href)) : undefined;
const secondaryHref = secondary ? sanitizeHref(getPermalink(secondary.href)) : undefined;
---

<section class="flexina-page-title" id="page-title" aria-labelledby="page-headline">
  <div class="page-title-content">
    {eyebrow && <p class="page-title-eyebrow">{eyebrow}</p>}
    <h1 id="page-headline">{headline}</h1>
    {lead && <p class="page-title-lead">{lead}</p>}
    <nav class="page-breadcrumb" aria-label={breadcrumbLabels.navigation}>
      <ol>
        <li><a href={homeHref}>{breadcrumbLabels.home}</a></li>
        <li class="breadcrumb-divider" aria-hidden="true">/</li>
        <li aria-current="page">{headline}</li>
      </ol>
    </nav>
    {
      (primary || secondary) && (
        <div class="page-title-actions">
          {primary && (
            <a href={primaryHref} class="btn btn-primary btn-lg">
              {primary.text}
            </a>
          )}
          {secondary && (
            <a href={secondaryHref} class="btn btn-secondary btn-lg">
              {secondary.text}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .flexina-page-title {
    position: relative;
    isolation: isolate;
    padding: 70px 24px;
    color: #ffffff;
    background: #101821;
    text-align: center;
    font-family: var(--font-family-body);
  }

  .flexina-page-title::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(rgba(10, 18, 29, 0.78), rgba(10, 18, 29, 0.88)),
      url('/images/flexina/city-workspace.webp') center / cover no-repeat;
  }

  .page-title-content {
    width: 100%;
    max-width: var(--wide-width);
    margin: 0 auto;
  }

  .page-title-eyebrow {
    margin: 0 auto 16px;
    color: var(--color-brand);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .flexina-page-title h1 {
    max-width: 1000px;
    margin: 0 auto;
    color: #ffffff;
    font-family: var(--font-family-heading);
    font-size: clamp(36px, 4.3vw, 56px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .page-title-lead {
    max-width: 780px;
    margin: 20px auto 0;
    color: #ffffff;
    font-size: 18px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .page-breadcrumb {
    max-width: 100%;
    width: fit-content;
    margin: 24px auto 0;
    padding: 12px 30px;
    border-radius: 100px;
    color: #161b23;
    background: #ffffff;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.6;
  }

  .page-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-breadcrumb li {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .page-breadcrumb a {
    color: #161b23;
    text-decoration: none;
  }

  .page-breadcrumb a:hover,
  .page-breadcrumb a:focus-visible,
  .breadcrumb-divider {
    color: var(--color-brand);
  }

  .page-breadcrumb a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .page-title-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 28px;
  }

  .page-title-actions .btn {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .page-title-actions .btn-secondary {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.65);
    background: transparent;
  }

  .page-title-actions .btn-secondary:hover,
  .page-title-actions .btn-secondary:focus-visible {
    color: #161b23;
    border-color: #ffffff;
    background: #ffffff;
  }

  @media (max-width: 575px) {
    .flexina-page-title {
      padding-right: 20px;
      padding-left: 20px;
    }

    .page-title-lead {
      font-size: 16px;
    }

    .page-breadcrumb {
      padding: 12px 20px;
      border-radius: 24px;
    }
  }
</style>
