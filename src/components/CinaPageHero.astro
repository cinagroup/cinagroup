---
import Hero from '~/components/marketing/Hero.astro';
import { getPermalink } from '~/utils/permalinks';
export interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  primary?: { text: string; href: string };
  secondary?: { text: string; href: string };
}
const { title, lead, primary, secondary } = Astro.props;
// Some existing source headings use line-break markup; the template renders plain text safely.
const headline = title.replace(/<br\s*\/?\s*>/gi, ' ').replace(/<[^>]*>/g, '');
---

<Hero
  value={{
    anchor_id: 'page-title',
    headline,
    subheadline: lead,
    centered: true,
    primary_cta_label: primary?.text,
    primary_cta_url: primary ? getPermalink(primary.href) : undefined,
    secondary_cta_label: secondary?.text,
    secondary_cta_url: secondary ? getPermalink(secondary.href) : undefined,
  }}
/>
