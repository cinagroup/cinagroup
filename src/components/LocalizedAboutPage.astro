---
import { DEFAULT_ABOUT_COPY } from '~/data/site/about-defaults.ts';
import { getPublishedPageCopy, getPageCopyMetadata } from '~/emdash/published-page-copy.ts';
import CinaPageHero from '~/components/CinaPageHero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { localizeInternalHref, type Lang } from '~/i18n';

type LocalizedLang = Exclude<Lang, 'en'>;

interface Props {
  lang: LocalizedLang;
}

const { lang } = Astro.props;
const content = await getPublishedPageCopy(Astro, 'page_about', 'about', DEFAULT_ABOUT_COPY[lang]);
const route = (path: string) => localizeInternalHref(path, lang) || path;
const products = [
  { slug: 'cinaseek', name: 'CinaSeek' },
  { slug: 'cinaclaw', name: 'CinaClaw' },
  { slug: 'cinatoken', name: 'CinaToken' },
  { slug: 'cinaskill', name: 'CinaSkill' },
  { slug: 'cinachain', name: 'CinaChain' },
] as const;
const metadata = await getPageCopyMetadata(Astro, {
  title: content.title,
  description: content.description,
  language: lang,
});
---

<Layout {metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={content.eyebrow}
      title={content.heroTitle}
      lead={content.lead}
      primary={{ text: content.services, href: route('/services/') }}
      secondary={{ text: content.contact, href: route('/contact/') }}
    />

    <section class="cg-page-section" aria-labelledby={`${lang}-about-mission`}>
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{content.missionEyebrow}</p>
          <h2 id={`${lang}-about-mission`}>{content.missionTitle}</h2>
          <p>{content.missionText}</p>
        </div>
        <div class="cg-card-grid">
          {
            content.principles.map((principle) => (
              <article class="cg-card">
                <p class="cg-card-meta">{principle.label}</p>
                <h3>{principle.title}</h3>
                <p>{principle.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby={`${lang}-about-products`}>
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{content.productsEyebrow}</p>
          <h2 id={`${lang}-about-products`}>{content.productsTitle}</h2>
          <p>{content.productsText}</p>
        </div>
        <div class="cg-list-panel">
          {
            products.map(({ slug, name }) => (
              <a class="cg-list-row" href={route(`/${slug}/`)}>
                <strong>{name}</strong>
                <span>{content.productDescriptions[slug]}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-dark" aria-labelledby={`${lang}-about-next`}>
      <div class="cg-page-shell cg-section-heading cg-section-heading-center">
        <p class="cg-eyebrow">{content.nextEyebrow}</p>
        <h2 id={`${lang}-about-next`}>{content.nextTitle}</h2>
        <p>{content.nextText}</p>
        <div class="cg-page-actions">
          <a class="cg-page-button cg-page-button-primary" href={route('/contact/')}>{content.contact}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
