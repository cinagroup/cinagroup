---
import { defaultProductCopy, type Locale, type Product } from '~/data/site/product-defaults.ts';
import { getPublishedPageCopy, getPageCopyMetadata } from '~/emdash/published-page-copy.ts';
import CinaPageHero from '~/components/CinaPageHero.astro';
import ProductEvidence from '~/components/ProductEvidence.astro';
import Layout from '~/layouts/PageLayout.astro';

const codeByProduct: Record<Product, string> = {
  cinaseek: 'gadget_example { sandbox = "isolated"; gatekeeper = "scoped"; review = true; }',
  cinaclaw: 'gateway_example { mode = "local-first"; channel = "configured"; pairing = true; }',
  cinatoken: 'gateway_example { route = "policy"; budget = "example-team"; trace = true; }',
  cinaskill: 'skill_example { contract = "SKILL.md"; source = "workspace"; precedence = "documented"; }',
  cinachain: 'testnet_mint_example { network = "base-sepolia"; asset = "test-only"; review = true; }',
};

const illustrativeLabel: Record<Locale, string> = {
  zh: '仅用于说明的虚构示例，并非真实客户或生产环境配置。',
  ja: '参考用の架空例です。実在の顧客・本番設定ではありません。',
  ko: '참고용 가상 예시입니다. 실제 고객 또는 프로덕션 구성이 아닙니다.',
  ru: 'Иллюстративный условный пример. Это не клиентская и не production-конфигурация.',
  es: 'Ejemplo ficticio solo como referencia; no es una configuración de cliente ni de producción.',
  pt: 'Exemplo fictício apenas para referência; não é uma configuração de cliente nem de produção.',
  fr: 'Exemple fictif à titre indicatif ; ce n’est ni une configuration client ni une configuration de production.',
};

const { lang, product } = Astro.props as { lang: Locale; product: Product };
const page = await getPublishedPageCopy(Astro, 'page_products', product, defaultProductCopy(lang, product));
const item = page;
const homeHref = `/${lang}/`;
const contactHref = `/${lang}/contact/`;
const metadata = await getPageCopyMetadata(Astro, { title: item.title, description: item.lead });
---

<Layout {metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={item.eyebrow}
      title={item.title}
      lead={`${item.lead} ${page.scenarioQualifier}`}
      primary={{ text: page.contact, href: contactHref }}
      secondary={{ text: page.stack, href: homeHref }}
    />
    <ProductEvidence {product} locale={lang} />
    <section class="cg-page-section" aria-labelledby="localized-product-capabilities">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{page.capabilitiesEyebrow}</p><h2 id="localized-product-capabilities">
            {page.capabilitiesTitle}
          </h2><p>{page.capabilitiesLead}</p>
        </div><div class="cg-card-grid">
          {
            item.capabilities.map((capability, index) => (
              <article class="cg-card">
                <>
                  <p class="cg-card-meta">{String(index + 1).padStart(2, '0')}</p>
                  <h3>{capability.title}</h3>
                  <p>{capability.description}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="cg-page-section cg-page-section-soft" aria-labelledby="localized-product-workflow">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{page.workflowEyebrow}</p><h2 id="localized-product-workflow">{page.workflowTitle}</h2>
        </div><div class="cg-list-panel">
          {
            page.steps.map((step, index) => (
              <div class="cg-list-row">
                <>
                  <strong>
                    {String(index + 1).padStart(2, '0')} / {step.title}
                  </strong>
                  <span>{step.description}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section class="cg-page-section cg-page-section-dark">
      <div class="cg-page-shell">
        <p class="cg-card-meta">{illustrativeLabel[lang]}</p>
        <pre class="cg-code-panel" aria-label={illustrativeLabel[lang]}><code>{codeByProduct[product]}</code></pre>
      </div>
    </section>
    <section class="cg-page-section">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">{page.nextEyebrow}</p><h2>{page.nextTitle}</h2><div class="cg-page-actions">
            <a class="cg-page-button cg-page-button-primary" href={contactHref}>{page.contact}</a><a
              class="cg-page-button"
              href={homeHref}>{page.stack}</a
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
