const { lang, product } = Astro.props as { lang: Locale; product: Product };
const page = content[lang];
const item = page.products[product];
const homeHref = `/${lang}/`;
const contactHref = `/${lang}/contact/`;
---

<Layout metadata={{ title: item.title, description: item.lead }}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={item.eyebrow}
      title={item.title}
      lead={`${item.lead} ${page.scenarioQualifier}`}
      primary={{ text: page.contact, href: contactHref }}
      secondary={{ text: page.stack, href: homeHref }}
    />
    <ProductEvidence {product} locale={lang} />
    <section class="cg-page-section" aria-labelledby="localized-product-capabilities">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{page.capabilitiesEyebrow}</p><h2 id="localized-product-capabilities">
            {page.capabilitiesTitle}
          </h2><p>{page.capabilitiesLead}</p>
        </div><div class="cg-card-grid">
          {
            item.capabilities.map((capability, index) => (
              <article class="cg-card">
                <>
                  <p class="cg-card-meta">{String(index + 1).padStart(2, '0')}</p>
                  <h3>{capability.title}</h3>
                  <p>{capability.description}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section class="cg-page-section cg-page-section-soft" aria-labelledby="localized-product-workflow">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{page.workflowEyebrow}</p><h2 id="localized-product-workflow">{page.workflowTitle}</h2>
        </div><div class="cg-list-panel">
          {
            page.steps.map((step, index) => (
              <div class="cg-list-row">
                <>
                  <strong>
                    {String(index + 1).padStart(2, '0')} / {step.title}
                  </strong>
                  <span>{step.description}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section class="cg-page-section cg-page-section-dark">
      <div class="cg-page-shell">
        <p class="cg-card-meta">{illustrativeLabel[lang]}</p>
        <pre class="cg-code-panel" aria-label={illustrativeLabel[lang]}><code>{codeByProduct[product]}</code></pre>
      </div>
    </section>
    <section class="cg-page-section">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">{page.nextEyebrow}</p><h2>{page.nextTitle}</h2><div class="cg-page-actions">
            <a class="cg-page-button cg-page-button-primary" href={contactHref}>{page.contact}</a><a
              class="cg-page-button"
              href={homeHref}>{page.stack}</a
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
