---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <section class="cg-page-hero" aria-labelledby="document-title">
      <div class="cg-page-shell">
        <p class="cg-eyebrow">CinaGroup / legal.</p>
        <h1 id="document-title">{frontmatter.title}</h1>
      </div>
    </section>
    <section class="cg-page-section">
      <div class="cg-page-shell">
        <article class="cg-prose">
          <slot />
        </article>
      </div>
    </section>
  </div>
</Layout>
