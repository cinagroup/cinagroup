---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/marketing/Header.astro';
import Footer from '~/components/marketing/Footer.astro';

import type { MetaData } from '~/types';
import { getLangFromUrl } from '~/i18n';

export interface Props {
  metadata?: MetaData;
  /** Page-provided hreflang alternates forwarded to the header language switcher. */
  languageAlternates?: Array<{ hreflang: string; href: string }>;
}

const { metadata, languageAlternates } = Astro.props;
const skipLabel = getLangFromUrl(Astro.url) === 'zh' ? '跳到主要内容' : 'Skip to content';
---

<Layout metadata={metadata}>
  <a href="#main-content" class="skip-link">
    {skipLabel}
  </a>
  <slot name="announcement" />
  <slot name="header">
    <Header languageAlternates={languageAlternates} />
  </slot>
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <slot name="footer">
    <Footer />
  </slot>
</Layout>
