---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaSkill — Reusable capability format for CinaClaw',
  description:
    'CinaSkill describes focused SKILL.md-based capabilities used with CinaClaw workspaces; it is not presented as a standalone hosted service.',
};

const code = `skill "release-check" {
  contract    = "SKILL.md"
  permissions = "explicit"
  resources   = ["runbook", "verification"]
  version     = "visible"
}`;
---

<CinaProductPage
  product="cinaskill"
  {metadata}
  eyebrow="CinaSkill / integrated capability format."
  title="Package focused instructions and resources for reuse in CinaClaw."
  lead="CinaSkill is the SKILL.md-based capability format used by bundled, managed, and workspace skills in CinaClaw. It does not claim a separate hosted service or standalone release."
  primary={{ text: 'Map a reusable capability', href: '/contact/' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    {
      label: 'Contract.',
      title: 'Keep the entry point explicit.',
      description: 'Use SKILL.md to describe when the capability applies, what it needs, and how it should operate.',
    },
    {
      label: 'Scope.',
      title: 'Focus on one repeatable job.',
      description: 'Separate a useful capability from unrelated workflows, permissions, and tools.',
    },
    {
      label: 'Resources.',
      title: 'Attach only required support files.',
      description: 'Reference runbooks, templates, scripts, or examples that the skill actually needs.',
    },
    {
      label: 'Location.',
      title: 'Load from documented skill sources.',
      description: 'Use bundled, managed, or workspace skill directories according to the CinaClaw setup.',
    },
    {
      label: 'Review.',
      title: 'Make permissions inspectable.',
      description: 'State the tools, external systems, and side effects the capability can require.',
    },
    {
      label: 'Maintain.',
      title: 'Keep loading order and version visible.',
      description: 'Document the workspace location, version, and runtime or resource assumptions the capability carries.',
    },
  ]}
  workflowTitle="Move one recurring job into a reviewable skill contract."
  workflowLead="A reference skill starts with a real task, narrows the required resources and permissions, and is tested inside its intended CinaClaw workspace."
  workflow={[
    {
      title: 'Define the trigger',
      description: 'Write the task and the conditions under which the skill should be selected.',
    },
    {
      title: 'Specify the contract',
      description: 'Describe required inputs, instructions, tools, resources, and expected output in SKILL.md.',
    },
    {
      title: 'Test in one workspace',
      description: 'Exercise the skill with representative inputs and review any tool or permission boundary.',
    },
    {
      title: 'Version and maintain',
      description: 'Keep compatibility, supporting resources, and workspace loading behavior clear as the workflow changes.',
    },
  ]}
  codeLabel="Illustrative skill contract."
  {code}
  principles={[
    { title: 'One clear job.', description: 'A skill should remain small enough for its behavior and permissions to be reviewed.' },
    { title: 'Explicit resources.', description: 'Supporting files and tools should be present because the task requires them.' },
    { title: 'No standalone claim.', description: 'CinaSkill is described as a format integrated with CinaClaw, not an independent hosted product.' },
  ]}
/>
