---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaSkill — Package reusable capabilities for teams and assistants',
  description: 'CinaSkill helps teams define, review, version, and reuse task-specific capabilities across products and workflows.',
};

const code = `skill "support-handoff" {
  input    = "reviewed-case"
  action   = "prepare-handoff"
  owner    = "support-lead"
  version  = "1.0"
}`;
---

<CinaProductPage
  {metadata}
  eyebrow="CinaSkill / reusable capabilities."
  title="Package repeatable capabilities without hiding their boundaries."
  lead="CinaSkill helps teams define, review, version, and reuse task-specific capabilities across products, assistants, and operational workflows."
  primary={{ text: 'Plan a skill workflow', href: '/contact' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    { label: 'Define.', title: 'Give each skill one clear job.', description: 'Document the inputs, action, output, and operating boundary before packaging the capability.' },
    { label: 'Review.', title: 'Inspect behavior before reuse.', description: 'Make permissions, dependencies, and review points visible to the teams adopting the skill.' },
    { label: 'Version.', title: 'Change capabilities deliberately.', description: 'Track compatible changes and preserve a stable contract for the workflows that depend on them.' },
    { label: 'Compose.', title: 'Combine small skills into workflows.', description: 'Reuse focused capabilities across products without turning one skill into an opaque all-purpose agent.' },
    { label: 'Own.', title: 'Keep responsibility visible.', description: 'Assign maintainers and support expectations so reusable capabilities do not become abandoned dependencies.' },
    { label: 'Measure.', title: 'Learn from real workflow use.', description: 'Use adoption, failures, and review feedback to improve the skill where it matters.' },
  ]}
  workflowTitle="Move from a task boundary to a reusable capability."
  workflowLead="A useful skill is small enough to understand, explicit enough to review, and stable enough to reuse."
  workflow={[
    { title: 'Define the contract', description: 'Specify the inputs, output, permissions, and owner for one task.' },
    { title: 'Test the behavior', description: 'Exercise representative cases and confirm the review and failure paths.' },
    { title: 'Package and version', description: 'Publish the capability with a stable contract and clear compatibility notes.' },
    { title: 'Adopt and observe', description: 'Use the skill in a real workflow and improve it from operator feedback.' },
  ]}
  codeLabel="Skill contract."
  {code}
  principles={[
    { title: 'Small by design.', description: 'A skill should solve one task well and compose cleanly with other capabilities.' },
    { title: 'Reviewable by default.', description: 'Permissions, dependencies, and expected behavior stay visible to adopters.' },
    { title: 'Owned over time.', description: 'Versioning and maintenance responsibility are part of the product surface.' },
  ]}
/>
