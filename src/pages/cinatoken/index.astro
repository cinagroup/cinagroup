---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaToken — Open-source AI gateway',
  description:
    'CinaToken is a self-hosted AI gateway with model routing, API keys, budgets, accounting, audit, and documented multimodal interfaces.',
};

const code = `gateway "team" {
  protocol = "responses-api"
  route    = "approved-models"
  budget   = "enforced"
  audit    = true
}`;
---

<CinaProductPage
  product="cinatoken"
  {metadata}
  eyebrow="CinaToken / open-source, self-hosted AI gateway."
  title="Route model access through one governed gateway."
  lead="CinaToken combines provider routing, API keys, model policy, budgets, accounting, and audit with local, Docker, database, and Cloudflare deployment paths. This page does not claim a managed-service SLA."
  primary={{ text: 'Plan a gateway evaluation', href: '/contact/' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    {
      label: 'Route.',
      title: 'Expose unified model interfaces.',
      description: 'Connect applications through documented Chat Completions, Responses, image, audio, embedding, Realtime, Claude, and Gemini routes.',
    },
    {
      label: 'Keys.',
      title: 'Issue controlled downstream access.',
      description: 'Keep provider credentials behind the gateway and manage user-facing API keys from the administration layer.',
    },
    {
      label: 'Policy.',
      title: 'Select approved providers and models.',
      description: 'Route by explicit provider, model, task, availability, and policy configuration.',
    },
    {
      label: 'Budget.',
      title: 'Apply recurring usage boundaries.',
      description: 'Use the project’s budget, accounting, status, and model-access controls for governed consumption.',
    },
    {
      label: 'Audit.',
      title: 'Retain operational evidence.',
      description: 'Inspect routing, policy, usage, and accounting through the documented console and management APIs.',
    },
    {
      label: 'Deploy.',
      title: 'Choose a supported hosting path.',
      description: 'Run locally, in Docker, with supported databases, or through the documented Cloudflare deployment path.',
    },
  ]}
  workflowTitle="Move one application through a governed model route."
  workflowLead="A reference rollout starts with one protocol, provider route, downstream key, budget rule, and observable request."
  workflow={[
    {
      title: 'Choose the interface',
      description: 'Select the documented protocol and confirm the application request shape.',
    },
    {
      title: 'Configure a provider route',
      description: 'Add the provider credential securely and restrict the route to the intended models.',
    },
    {
      title: 'Issue a downstream key',
      description: 'Create the user or application identity with its applicable model and budget boundaries.',
    },
    {
      title: 'Verify usage and audit',
      description: 'Send a test request, then confirm routing, response, accounting, and trace evidence.',
    },
  ]}
  codeLabel="Illustrative gateway policy."
  {code}
  principles={[
    { title: 'Self-hosted control.', description: 'Operators choose the hosting path, providers, keys, and data stores.' },
    { title: 'Protocol clarity.', description: 'Applications should use only interfaces documented by the active release.' },
    { title: 'Observable spend.', description: 'Routing, usage, budgets, and accounting should remain visible to operators.' },
  ]}
/>
