---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaToken — One gateway for model access and policy',
  description: 'CinaToken gives builders a single layer for model routing, credentials, usage policy, request traces, and cost boundaries.',
};

const code = `gateway "coding-assistant" {
  route    = "task-aware"
  budget   = "team-limit"
  fallback = "approved-model"
  trace    = true
}`;
---

<CinaProductPage
  {metadata}
  eyebrow="CinaToken / model gateway."
  title="Control model access, usage, and spend from one gateway."
  lead="CinaToken gives builders one routing layer for model access, credentials, policy, request traces, and cost boundaries."
  primary={{ text: 'Plan a gateway workflow', href: '/contact' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    { label: 'Access.', title: 'Centralize credential boundaries.', description: 'Keep provider credentials behind one controlled service instead of distributing them across every application.' },
    { label: 'Route.', title: 'Match requests to approved models.', description: 'Select providers and models by task, policy, availability, or product requirements.' },
    { label: 'Limit.', title: 'Make usage boundaries visible.', description: 'Apply team, application, and environment limits before a request leaves the gateway.' },
    { label: 'Trace.', title: 'Preserve request context.', description: 'Record the routing decision, policy result, and response metadata needed for review and operations.' },
    { label: 'Fallback.', title: 'Handle provider failure deliberately.', description: 'Define approved fallback behavior rather than letting applications improvise during an incident.' },
    { label: 'Measure.', title: 'Connect usage to product decisions.', description: 'Give teams the data they need to tune quality, latency, and cost without exposing credentials.' },
  ]}
  workflowTitle="Apply policy before the request reaches a provider."
  workflowLead="A gateway workflow should make access, route selection, limits, fallback, and traceability explicit."
  workflow={[
    { title: 'Authenticate the application', description: 'Verify the calling product, environment, and permitted gateway scope.' },
    { title: 'Evaluate policy', description: 'Check the task, model allow-list, usage boundary, and required data handling.' },
    { title: 'Route the request', description: 'Send the request to an approved model with a defined fallback path.' },
    { title: 'Record the outcome', description: 'Return the response while preserving the trace and usage metadata operators need.' },
  ]}
  codeLabel="Gateway policy."
  {code}
  principles={[
    { title: 'Credentials stay contained.', description: 'Applications use gateway-scoped access instead of handling provider secrets directly.' },
    { title: 'Policies are visible.', description: 'Model, budget, and fallback rules should be easy to inspect and change.' },
    { title: 'Decisions are traceable.', description: 'Routing outcomes should support debugging, governance, and cost review.' },
  ]}
/>
