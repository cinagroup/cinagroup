---
import { ENGLISH_PAGE_DEFAULTS } from '~/data/site/english-page-defaults';
import { loadEnglishPageText } from '~/emdash/english-page-text';
import { getPageCopyMetadata } from '~/emdash/published-page-copy';

const copy = await loadEnglishPageText(Astro, 'cinaseek', ENGLISH_PAGE_DEFAULTS.cinaseek);

import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = await getPageCopyMetadata(Astro, {
  title: copy.metadata_title,
  description: copy.metadata_description,
});

const code = `gadget "planning-workspace" {
  sandbox = "isolated"
  access  = ["introduced-resources"]
  actions = "review-required"
}`;
---

<CinaProductPage
  pageText={copy}
  product="cinaseek"
  {metadata}
  eyebrow={copy.hero_eyebrow}
  title={copy.hero_title}
  lead={copy.hero_lead}
  primary={{ text: copy.hero_primary_text, href: '/contact/' }}
  secondary={{ text: copy.hero_secondary_text, href: '/' }}
  capabilities={[
    {
      label: copy.capabilities_1_label,
      title: copy.capabilities_1_title,
      description: copy.capabilities_1_description,
    },
    {
      label: copy.capabilities_2_label,
      title: copy.capabilities_2_title,
      description: copy.capabilities_2_description,
    },
    {
      label: copy.capabilities_3_label,
      title: copy.capabilities_3_title,
      description: copy.capabilities_3_description,
    },
    {
      label: copy.capabilities_4_label,
      title: copy.capabilities_4_title,
      description: copy.capabilities_4_description,
    },
    {
      label: copy.capabilities_5_label,
      title: copy.capabilities_5_title,
      description: copy.capabilities_5_description,
    },
    {
      label: copy.capabilities_6_label,
      title: copy.capabilities_6_title,
      description: copy.capabilities_6_description,
    },
  ]}
  workflowTitle={copy.hero_workflow_title}
  workflowLead={copy.hero_workflow_lead}
  workflow={[
    {
      title: copy.workflow_1_title,
      description: copy.workflow_1_description,
    },
    {
      title: copy.workflow_2_title,
      description: copy.workflow_2_description,
    },
    {
      title: copy.workflow_3_title,
      description: copy.workflow_3_description,
    },
    {
      title: copy.workflow_4_title,
      description: copy.workflow_4_description,
    },
  ]}
  codeLabel="Illustrative Gadget contract."
  {code}
  principles={[
    {
      title: copy.principles_1_title,
      description: copy.principles_1_description,
    },
    {
      title: copy.principles_2_title,
      description: copy.principles_2_description,
    },
    {
      title: copy.principles_3_title,
      description: copy.principles_3_description,
    },
  ]}
/>
