---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaSeek — Search across the work your team already has',
  description:
    'CinaSeek helps teams search documents, product context, support history, and operating knowledge from one focused workflow.',
};

const code = `search "release-readiness" {
  sources = ["docs", "support", "runbooks"]
  answer  = "source-backed"
  review  = "required"
}`;
---

<CinaProductPage
  {metadata}
  eyebrow="CinaSeek / enterprise search."
  title="Find operational knowledge without building another portal."
  lead="CinaSeek gives teams a focused search layer across documents, product notes, support history, and internal references."
  primary={{ text: 'Discuss a search workflow', href: '/contact' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    {
      label: 'Connect.',
      title: 'Bring relevant sources together.',
      description:
        'Define the document sets, knowledge stores, and operational references that belong in one search scope.',
    },
    {
      label: 'Retrieve.',
      title: 'Search by the work in front of you.',
      description:
        'Start from a support question, product decision, or operating task instead of browsing another folder tree.',
    },
    {
      label: 'Ground.',
      title: 'Keep answers tied to sources.',
      description: 'Make the supporting references visible so people can check context before acting.',
    },
    {
      label: 'Scope.',
      title: 'Separate audiences and access.',
      description: 'Shape search boundaries around teams, projects, and the information they are permitted to use.',
    },
    {
      label: 'Review.',
      title: 'Keep judgment in the loop.',
      description: 'Use search to prepare evidence and next steps while people retain the final decision.',
    },
    {
      label: 'Improve.',
      title: 'Learn from missing answers.',
      description: 'Turn unanswered queries and weak sources into a practical backlog for better knowledge operations.',
    },
  ]}
  workflowTitle="Move from a question to a source-backed answer."
  workflowLead="A compact search workflow keeps the query, retrieval scope, citations, and review step visible."
  workflow={[
    {
      title: 'Frame the question',
      description: 'Capture the user intent, team context, and decision the answer needs to support.',
    },
    {
      title: 'Search approved sources',
      description: 'Retrieve only from the collections and access boundaries configured for that workflow.',
    },
    {
      title: 'Assemble the answer',
      description: 'Present the concise answer together with the supporting references and uncertainty.',
    },
    {
      title: 'Review and refine',
      description: 'Let the user confirm the result, open the source, or tighten the query without losing context.',
    },
  ]}
  codeLabel="Search contract."
  {code}
  principles={[
    { title: 'Source visibility.', description: 'Answers should make it easy to see where important facts came from.' },
    {
      title: 'Clear boundaries.',
      description: 'Search scopes, access rules, and retention choices should be explicit.',
    },
    {
      title: 'Useful feedback.',
      description: 'Low-confidence results and missing knowledge should become actionable signals.',
    },
  ]}
/>
