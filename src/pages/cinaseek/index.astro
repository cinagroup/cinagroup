---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaSeek — Secure AI productivity environment',
  description:
    'CinaSeek is an early-access environment for AI agents and sandboxed personal apps built on Cloudflare Workers and workerd.',
};

const code = `gadget "planning-workspace" {
  sandbox = "isolated"
  access  = ["introduced-resources"]
  actions = "review-required"
}`;
---

<CinaProductPage
  product="cinaseek"
  {metadata}
  eyebrow="CinaSeek / early-access AI productivity environment."
  title="Build and run private AI-assisted apps inside capability-based sandboxes."
  lead="CinaSeek combines agent chat, personal applications called Gadgets, and scoped Gatekeepers. The project is early access; production readiness depends on the release and deployment configuration."
  primary={{ text: 'Discuss an early-access evaluation', href: '/contact/' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    {
      label: 'Agent.',
      title: 'Work through an agent chat UI.',
      description:
        'Ask an agent to complete tasks or build a focused personal application for the work in front of you.',
    },
    {
      label: 'Build.',
      title: 'Create private Gadgets.',
      description: 'Generate small applications whose client and server run in isolated, per-user boundaries.',
    },
    {
      label: 'Share.',
      title: 'Collaborate through explicit sharing.',
      description:
        'Keep each Gadget private by default, then grant access to named users or through a deliberate share link.',
    },
    {
      label: 'Scope.',
      title: 'Introduce only approved resources.',
      description: 'Use Gatekeepers to narrow authorization to the specific external resources a user intended.',
    },
    {
      label: 'Review.',
      title: 'Inspect actions before release.',
      description: 'Log external actions and preserve human approval for operations with side effects.',
    },
    {
      label: 'Deploy.',
      title: 'Develop locally, deploy through the documented path.',
      description: 'Use workerd for local development and the documented Cloudflare path for production deployment.',
    },
  ]}
  workflowTitle="Move from a request to a sandboxed personal app."
  workflowLead="A reference evaluation keeps the requested job, generated Gadget, introduced resources, and review queue visible."
  workflow={[
    {
      title: 'Define the job',
      description: 'Describe the result, intended users, data sensitivity, and external resources required.',
    },
    {
      title: 'Build the Gadget',
      description: 'Let the agent generate the focused client/server application inside its isolated workspace.',
    },
    {
      title: 'Introduce resources',
      description: 'Connect only the approved external resources through Gatekeepers and explicit capabilities.',
    },
    {
      title: 'Review and share',
      description: 'Inspect queued side effects, test the result, and choose whether to keep it private or share it.',
    },
  ]}
  codeLabel="Illustrative Gadget contract."
  {code}
  principles={[
    {
      title: 'Capability boundaries.',
      description: 'Agents and Gadgets begin without ambient access to external resources.',
    },
    {
      title: 'Private by default.',
      description: 'Each Gadget runs in an isolated boundary and is shared only through an explicit user action.',
    },
    {
      title: 'Visible review.',
      description: 'Actions with side effects should remain logged and available for human approval.',
    },
  ]}
/>
