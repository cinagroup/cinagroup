---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaChain — Connected infrastructure for application workflows',
  description:
    'CinaChain supports applications that need verifiable state, connected services, and explicit release controls.',
};

const code = `release "connected-service" {
  state    = "verified"
  contract = "checked"
  owner    = "assigned"
  promote  = "reviewed"
}`;
---

<CinaProductPage
  {metadata}
  eyebrow="CinaChain / connected infrastructure."
  title="Connect application state without obscuring how it moves."
  lead="CinaChain supports teams that need verifiable state, connected services, and a clear path from application workflow to reviewed release."
  primary={{ text: 'Discuss an infrastructure path', href: '/contact' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    {
      label: 'Model.',
      title: 'Define the state that matters.',
      description: 'Start with the records, events, and ownership rules the application actually needs to coordinate.',
    },
    {
      label: 'Connect.',
      title: 'Link services through clear contracts.',
      description: 'Keep application, service, and infrastructure boundaries explicit so teams can change them safely.',
    },
    {
      label: 'Verify.',
      title: 'Check important transitions.',
      description: 'Validate the data and conditions required before a workflow advances to its next state.',
    },
    {
      label: 'Observe.',
      title: 'Make system state inspectable.',
      description: 'Expose the status, owner, and supporting context operators need to understand what is happening.',
    },
    {
      label: 'Release.',
      title: 'Promote changes deliberately.',
      description:
        'Use review gates and staged delivery for changes that affect connected applications or shared state.',
    },
    {
      label: 'Recover.',
      title: 'Plan for reversibility.',
      description: 'Design ownership, retries, and recovery paths before the system becomes difficult to operate.',
    },
  ]}
  workflowTitle="Move connected services through explicit states."
  workflowLead="Treat state, validation, ownership, and release as visible parts of the product rather than hidden infrastructure details."
  workflow={[
    {
      title: 'Define the state model',
      description: 'Document the records, transitions, and ownership boundaries the workflow needs.',
    },
    {
      title: 'Connect the services',
      description: 'Link application actions to the smallest set of stable service contracts.',
    },
    {
      title: 'Validate the transition',
      description: 'Check inputs, permissions, and current state before committing a change.',
    },
    {
      title: 'Review the release',
      description: 'Promote the change with observable status and a defined recovery path.',
    },
  ]}
  codeLabel="Release contract."
  {code}
  principles={[
    {
      title: 'Explicit state.',
      description: 'Important transitions should be inspectable and understandable to operators.',
    },
    {
      title: 'Stable contracts.',
      description: 'Application and infrastructure boundaries should remain clear as the system evolves.',
    },
    {
      title: 'Safe change.',
      description: 'Review, observability, and recovery belong in the delivery path from the beginning.',
    },
  ]}
/>
