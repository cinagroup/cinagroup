---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaChain — Base Sepolia Web3 collection beta',
  description:
    'CinaChain is a beta Web3 collection project configured for Base Sepolia testnet, with NFT gallery, minting, wallet, and Cloudflare edge surfaces.',
};

const code = `mint "testnet-collection" {
  network   = "base-sepolia"
  phase     = "whitelist-or-public"
  assetType = "testnet-only"
}`;
---

<CinaProductPage
  product="cinachain"
  {metadata}
  eyebrow="CinaChain / Base Sepolia beta."
  title="Evaluate a Web3 collection flow with testnet assets."
  lead="CinaChain’s repository includes an NFT DApp, portal, documentation, smart contracts, and Cloudflare edge services. The current release scope is Base Sepolia testnet; documented domains are not proof of a live production deployment."
  primary={{ text: 'Discuss a testnet evaluation', href: '/contact/' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    {
      label: 'Browse.',
      title: 'Render an NFT collection gallery.',
      description: 'Display collection assets with documented multi-gateway IPFS image fallback.',
    },
    {
      label: 'Wallet.',
      title: 'Connect a Base Sepolia wallet.',
      description: 'Use Reown AppKit with wagmi and viem against one explicit test network.',
    },
    {
      label: 'Mint.',
      title: 'Exercise whitelist or public mint phases.',
      description: 'Run the repository’s Merkle-tree whitelist and public-phase paths with testnet assets.',
    },
    {
      label: 'Admin.',
      title: 'Operate documented collection controls.',
      description: 'Use the included admin surfaces for whitelist management and contract operations.',
    },
    {
      label: 'Edge.',
      title: 'Separate Pages and Worker surfaces.',
      description: 'Keep portal, DApp, docs, billing, and whitelist units explicit in the Cloudflare release topology.',
    },
    {
      label: 'Verify.',
      title: 'Treat deployment claims as evidence-based.',
      description: 'Run quality gates and verify custom domains and live revisions after each release.',
    },
  ]}
  workflowTitle="Move a testnet mint through explicit checks."
  workflowLead="A reference evaluation keeps the selected network, wallet, phase, contract state, and explorer result visible."
  workflow={[
    {
      title: 'Select Base Sepolia',
      description: 'Confirm the configured test network and testnet-only asset scope before connecting a wallet.',
    },
    {
      title: 'Connect the wallet',
      description: 'Establish the Reown AppKit connection and display the expected account and network.',
    },
    {
      title: 'Validate the mint phase',
      description: 'Check whitelist eligibility or public-phase state before submitting the test transaction.',
    },
    {
      title: 'Review the transaction',
      description: 'Inspect the Base Sepolia result and confirm gallery metadata through the configured storage paths.',
    },
  ]}
  codeLabel="Illustrative testnet contract."
  {code}
  principles={[
    {
      title: 'Testnet honesty.',
      description: 'Beta and Base Sepolia scope should stay visible wherever the product is described.',
    },
    {
      title: 'Visible contracts.',
      description: 'Network, mint phase, contract, and explorer links should remain inspectable.',
    },
    {
      title: 'Verified releases.',
      description: 'Repository configuration must be paired with post-deploy domain and revision checks.',
    },
  ]}
/>
