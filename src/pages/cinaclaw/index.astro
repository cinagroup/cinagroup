---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaClaw — Local-first personal AI assistant',
  description:
    'CinaClaw is an open-source personal AI assistant with a local-first Gateway, channel adapters, skills, and companion apps.',
};

const code = `assistant "local" {
  gateway  = "self-hosted"
  channels = ["webchat", "configured-adapters"]
  dmPolicy = "pairing"
}`;
---

<CinaProductPage
  product="cinaclaw"
  {metadata}
  eyebrow="CinaClaw / open-source personal AI assistant."
  title="Run an assistant through your own local-first Gateway."
  lead="CinaClaw provides an installable CLI, Gateway, Control UI, messaging adapters, skills, and optional companion apps. Channel access and model credentials remain configuration the operator controls."
  primary={{ text: 'Plan a CinaClaw setup', href: '/contact/' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    {
      label: 'Onboard.',
      title: 'Install through the guided CLI.',
      description: 'Configure the Gateway, workspace, models, channels, and skills from a documented onboarding path.',
    },
    {
      label: 'Gateway.',
      title: 'Keep the control plane local-first.',
      description: 'Run sessions, channels, tools, and events through a Gateway under the operator’s control.',
    },
    {
      label: 'Channels.',
      title: 'Connect documented messaging adapters.',
      description: 'Use WebChat or configure supported adapters such as Telegram, Slack, Discord, Signal, and others.',
    },
    {
      label: 'Access.',
      title: 'Pair unknown direct-message senders.',
      description:
        'Keep the default pairing policy for common messaging channels unless the operator explicitly changes it.',
    },
    {
      label: 'Skills.',
      title: 'Load focused workspace capabilities.',
      description: 'Use bundled, managed, or workspace skills with explicit instructions and supporting resources.',
    },
    {
      label: 'Apps.',
      title: 'Add optional companion surfaces.',
      description: 'Connect documented Windows, macOS, Linux, iOS, or Android surfaces when the setup requires them.',
    },
  ]}
  workflowTitle="Move from install to one deliberately configured assistant path."
  workflowLead="A reference setup confirms the local Gateway, one model, one channel, and the applicable access policy before expanding."
  workflow={[
    {
      title: 'Run onboarding',
      description: 'Install the CLI and configure the Gateway, workspace, model authentication, and daemon mode.',
    },
    {
      title: 'Connect one channel',
      description: 'Start with WebChat or one supported adapter and keep its inbound access policy explicit.',
    },
    {
      title: 'Add a focused skill',
      description: 'Introduce only the instructions and tools required for the first job.',
    },
    {
      title: 'Verify and operate',
      description: 'Check Gateway status, exercise the channel, and use the security runbook before remote exposure.',
    },
  ]}
  codeLabel="Illustrative local configuration."
  {code}
  principles={[
    {
      title: 'Operator control.',
      description: 'The operator chooses the models, channels, tools, access policies, and exposure path.',
    },
    {
      title: 'Secure defaults.',
      description: 'Pairing, allowlists, sandbox settings, and exposure guidance should be reviewed before use.',
    },
    {
      title: 'Incremental setup.',
      description: 'Validate one model, channel, and skill path before adding more integrations.',
    },
  ]}
/>
