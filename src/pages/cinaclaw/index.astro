---
import CinaProductPage from '~/components/CinaProductPage.astro';

const metadata = {
  title: 'CinaClaw — Reviewable workflow automation',
  description:
    'CinaClaw helps teams turn repeatable operational work into assistant-led workflows with visible review points.',
};

const code = `workflow "support-triage" {
  intake   = "classify"
  context  = "gather"
  draft    = "prepare"
  approval = "human"
}`;
---

<CinaProductPage
  {metadata}
  eyebrow="CinaClaw / workflow assistant."
  title="Move repeated work into dependable, reviewable flows."
  lead="CinaClaw helps teams triage requests, gather context, prepare next actions, and keep recurring work moving without hiding the review step."
  primary={{ text: 'Plan an automation workflow', href: '/contact' }}
  secondary={{ text: 'View the full stack', href: '/' }}
  capabilities={[
    {
      label: 'Intake.',
      title: 'Turn requests into structured work.',
      description: 'Normalize messages, forms, and events into a clear task with the context the workflow needs.',
    },
    {
      label: 'Context.',
      title: 'Gather the right evidence first.',
      description: 'Pull relevant search results, account details, and operating notes before drafting an action.',
    },
    {
      label: 'Draft.',
      title: 'Prepare a useful next step.',
      description: 'Create a response, summary, checklist, or action proposal that a person can inspect quickly.',
    },
    {
      label: 'Review.',
      title: 'Place approval where it matters.',
      description: 'Require human confirmation for sensitive, external, destructive, or high-impact actions.',
    },
    {
      label: 'Route.',
      title: 'Send work to the right system.',
      description: 'Connect approved outputs to the tools and owners already responsible for the process.',
    },
    {
      label: 'Audit.',
      title: 'Keep the workflow explainable.',
      description: 'Preserve inputs, decisions, approvals, and outcomes so operators can understand what happened.',
    },
  ]}
  workflowTitle="Keep automation legible from intake to approval."
  workflowLead="A good workflow exposes its inputs, context, proposed action, and owner instead of collapsing everything into one opaque step."
  workflow={[
    {
      title: 'Classify the request',
      description: 'Identify the workflow type, urgency, ownership, and information still needed.',
    },
    {
      title: 'Gather context',
      description: 'Retrieve relevant knowledge and system state within the permitted scope.',
    },
    { title: 'Prepare the action', description: 'Draft the next step and explain what the workflow used to reach it.' },
    {
      title: 'Review and release',
      description: 'Route the proposal to the right person before any external or high-impact action.',
    },
  ]}
  codeLabel="Workflow contract."
  {code}
  principles={[
    {
      title: 'Human control.',
      description: 'Approval points remain visible and proportionate to the impact of the action.',
    },
    {
      title: 'Small workflows.',
      description: 'Each automation should do one operational job clearly before it grows.',
    },
    {
      title: 'Traceable outcomes.',
      description: 'Operators should be able to inspect the path from request to result.',
    },
  ]}
/>
