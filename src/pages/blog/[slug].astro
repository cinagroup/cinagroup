---
import { getEmDashEntry } from 'emdash';
import { env } from 'cloudflare:workers';
import type { Fetcher } from '@cloudflare/workers-types';

import EmDashPost from '~/components/blog/EmDashPost.astro';
import { findLegacyArticle, isPublicPostSlug, publicPostFromEntry } from '~/emdash/public-post';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug || !isPublicPostSlug(slug)) return new Response('Not found', { status: 404 });

// `run_worker_first` and a dynamic route must not replace a legacy prerendered article.
// The assets binding applies the existing trailing-slash and redirect behavior.
const legacyAsset = await findLegacyArticle(Astro.request, (env as unknown as { ASSETS: Fetcher }).ASSETS);
if (legacyAsset) return legacyAsset;

const { entry, error, isPreview, fallbackLocale } = await getEmDashEntry('posts', slug, { locale: 'en' });
if (error) {
  console.error('Unable to read published EmDash post', error);
  return new Response('Content unavailable', { status: 500 });
}

const post = publicPostFromEntry(entry, 'en', slug, { isPreview, fallbackLocale });
if (!post) return new Response('Not found', { status: 404 });
---

<EmDashPost post={post} />
