---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';

const heroSystemImage = '~/assets/images/cinagroup-system-hero-v1.png';

const metadata = {
  title: 'CinaGroup | Search, automation, APIs, and infrastructure',
  ignoreTitleTemplate: true,
  description:
    'CinaGroup helps teams solve work across search, workflow automation, model access, reusable skills, and chain-connected infrastructure.',
  keywords: [
    'CinaGroup',
    'CinaSeek',
    'CinaClaw',
    'CinaSkill',
    'CinaToken',
    'CinaChain',
    'enterprise search',
    'workflow automation',
    'model gateway',
    'developer infrastructure',
  ],
  openGraph: {
    type: 'website',
    locale: 'en_US',
    site_name: 'CinaGroup',
    description: 'Tools for teams building with search, automation, APIs, and infrastructure.',
    images: [{ url: heroSystemImage, width: 1200, height: 626 }],
  },
  twitter: {
    cardType: 'summary_large_image',
  },
  structuredData: {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'CinaGroup',
    url: 'https://cinagroup.com',
    logo: 'https://cinagroup.com/favicon.svg',
    description: 'Tools for teams building with search, automation, APIs, and infrastructure.',
    sameAs: ['https://github.com/cinagroup', 'https://x.com/cinagroup'],
  },
};

const capabilityTabs = [
  {
    label: 'Find',
    title: 'Search the work that is already done.',
    text: 'Connect knowledge, docs, and operating notes so teams can find the answer before creating another meeting.',
  },
  {
    label: 'Automate',
    title: 'Move repeated work into dependable flows.',
    text: 'Turn support, review, and operations tasks into auditable workflows that still leave people in control.',
  },
  {
    label: 'Connect',
    title: 'Route models, APIs, and infrastructure cleanly.',
    text: 'Give builders one place to manage access, costs, releases, and the systems that sit behind the product.',
  },
];

const scenarioRows = [
  {
    label: 'Enterprise search',
    product: 'CinaSeek',
    title: 'Find operational knowledge without building another portal.',
    text: 'CinaSeek gives teams a search layer across documents, product notes, support history, and internal references.',
    href: '/cinaseek',
    cta: 'Explore CinaSeek',
    visualTitle: 'Knowledge index',
    visualRows: ['docs/handbook.md', 'support/escalations', 'product/release-notes', 'runbooks/search'],
    output: 'Answer ready in 1 source-backed view',
  },
  {
    label: 'Workflow automation',
    product: 'CinaClaw',
    title: 'Turn repeatable work into assistant-led workflows.',
    text: 'CinaClaw helps teams triage requests, prepare next actions, and keep recurring operations moving without losing review control.',
    href: '/cinaclaw',
    cta: 'Explore CinaClaw',
    visualTitle: 'Automation run',
    visualRows: ['intake classified', 'context gathered', 'draft action prepared', 'human review queued'],
    output: '4 steps completed, 1 waiting on approval',
  },
  {
    label: 'Model gateway',
    product: 'CinaToken',
    title: 'Control model access, usage, and spend from one gateway.',
    text: 'CinaToken gives builders a single routing layer for model access, API keys, usage policy, and cost visibility.',
    href: '/cinatoken',
    cta: 'Explore CinaToken',
    visualTitle: 'Gateway policy',
    visualRows: ['route: coding tasks', 'limit: team budget', 'fallback: secondary model', 'log: request trace'],
    output: 'Policy applied before request leaves the app',
  },
  {
    label: 'Infrastructure',
    product: 'CinaChain + CinaSkill',
    title: 'Ship connected services with reusable skills behind them.',
    text: 'CinaChain and CinaSkill support teams that need trusted infrastructure, reusable capabilities, and a path from prototype to production.',
    href: '/cinachain',
    cta: 'Explore infrastructure',
    visualTitle: 'Release path',
    visualRows: ['skill packaged', 'service linked', 'contract checked', 'release promoted'],
    output: 'Prototype moved to a production route',
  },
];

const productRows = [
  ['CinaSeek', 'Search layer', 'Find answers across internal knowledge and live product context.', '/cinaseek'],
  [
    'CinaClaw',
    'Workflow assistant',
    'Coordinate repeatable operational work with reviewable next actions.',
    '/cinaclaw',
  ],
  ['CinaToken', 'Model gateway', 'Manage model routing, API keys, policy, logs, and cost boundaries.', '/cinatoken'],
  ['CinaSkill', 'Reusable skills', 'Package task-specific abilities for teams, robots, and operators.', '/cinaskill'],
  [
    'CinaChain',
    'Connected infrastructure',
    'Support applications that need chain-aware services and reliable rails.',
    '/cinachain',
  ],
];

const proofItems = [
  'Start with one product and expand only when the workflow demands it.',
  'Keep human review, auditability, and cost boundaries visible.',
  'Connect search, automation, gateway, skill, and infrastructure layers without locking teams into one path.',
];

const releaseCode = `workflow "support-review" {
  search     = "CinaSeek"
  action     = "CinaClaw"
  gateway    = "CinaToken"
  skills     = ["triage", "handoff"]
  release    = "reviewed"
}`;
---

<Layout metadata={metadata}>
  <div class="cg-home">
    <section class="cg-hero" aria-labelledby="home-title">
      <div class="cg-hero-art" aria-hidden="true">
        <Image
          src={heroSystemImage}
          alt=""
          width={1672}
          height={941}
          widths={[640, 960, 1280, 1672]}
          sizes="100vw"
          layout="fullWidth"
          format="webp"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          style="width: 100%; height: 100%; object-fit: cover; object-position: center top;"
        />
      </div>
      <div class="cg-shell cg-hero-shell">
        <p class="cg-system-line">Search. Automate. Connect. Ship.</p>
        <h1 id="home-title">Tools for teams building search, automation, APIs, and infrastructure.</h1>
        <p class="cg-hero-copy">
          CinaGroup brings five product lines into one practical stack for teams that need answers, workflows, model
          access, reusable skills, and connected services.
        </p>
        <div class="cg-actions" aria-label="Primary actions">
          <a class="cg-button cg-button-primary" href="#scenarios">See the workflows</a>
          <a class="cg-button cg-button-secondary" href="/contact">Talk to us</a>
        </div>
        <div class="cg-preview" aria-label="CinaGroup workflow preview">
          <div class="cg-preview-top">
            <span>cinagroup/workflow</span>
            <span>ready</span>
          </div>
          <div class="cg-preview-grid">
            {
              capabilityTabs.map((item) => (
                <article>
                  <span>{item.label}</span>
                  <strong>{item.title}</strong>
                  <p>{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="scenarios" class="cg-section cg-section-white" aria-labelledby="scenario-title">
      <div class="cg-shell">
        <div class="cg-section-heading">
          <p class="cg-mono">Start with the problem.</p>
          <h2 id="scenario-title">Choose the path that matches the work in front of you.</h2>
          <p>
            Start from the job your team needs to finish. Each path shows the product, workflow, and next step without
            forcing a platform-wide commitment.
          </p>
        </div>

        <div class="cg-scenarios">
          {
            scenarioRows.map((item, index) => (
              <article class={`cg-scenario ${index % 2 === 1 ? 'cg-scenario-reverse' : ''}`}>
                <div class="cg-scenario-copy">
                  <p class="cg-mono">{item.label}</p>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  <a href={item.href}>{item.cta}</a>
                </div>
                <div class="cg-product-frame" aria-label={`${item.product} product preview`}>
                  <div class="cg-product-title">
                    <span>{item.product}</span>
                    <span>{item.visualTitle}</span>
                  </div>
                  <div class="cg-product-list">
                    {item.visualRows.map((row) => (
                      <div>
                        <span aria-hidden="true" />
                        <code>{row}</code>
                      </div>
                    ))}
                  </div>
                  <div class="cg-product-output">{item.output}</div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-section cg-section-soft" aria-labelledby="stack-title">
      <div class="cg-shell cg-stack-layout">
        <div>
          <p class="cg-mono">Product stack.</p>
          <h2 id="stack-title">One group, five routes into production.</h2>
        </div>
        <div class="cg-product-table">
          {
            productRows.map(([name, role, description, href]) => (
              <a href={href}>
                <span>{name}</span>
                <span>{role}</span>
                <span>{description}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-dark-band" aria-labelledby="delivery-title">
      <div class="cg-shell cg-dark-grid">
        <div>
          <p class="cg-mono">Delivery model.</p>
          <h2 id="delivery-title">Keep the system understandable as it grows.</h2>
          <p>
            Teams can start with one workflow, then add search, routing, skills, or infrastructure as the product gets
            more serious.
          </p>
          <div class="cg-actions">
            <a class="cg-button cg-button-invert" href="/contact">Plan a workflow</a>
            <a class="cg-button cg-button-dark-secondary" href="/blog">Read the notes</a>
          </div>
        </div>
        <div class="cg-code-panel" aria-label="Release checklist preview">
          <div class="cg-code-top">
            <span>release.config</span>
            <span>main</span>
          </div>
          <pre><code>{releaseCode}</code></pre>
        </div>
      </div>
    </section>

    <section class="cg-section cg-section-white" aria-labelledby="proof-title">
      <div class="cg-shell cg-proof">
        <div>
          <p class="cg-mono">Operating principles.</p>
          <h2 id="proof-title">A practical stack without unnecessary complexity.</h2>
        </div>
        <div class="cg-proof-list">
          {proofItems.map((item) => <p>{item}</p>)}
        </div>
      </div>
    </section>

    <section class="cg-cta" aria-labelledby="cta-title">
      <div class="cg-shell">
        <h2 id="cta-title">Tell us what your team is trying to move.</h2>
        <p>
          We will help map the right entry point, whether that is search, an operational workflow, model routing, or
          infrastructure.
        </p>
        <div class="cg-actions">
          <a class="cg-button cg-button-primary" href="/contact">Contact CinaGroup</a>
          <a class="cg-button cg-button-secondary" href="/pricing">View pricing</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .cg-home {
    --cg-ink: #171717;
    --cg-body: #4d4d4d;
    --cg-muted: #888888;
    --cg-hairline: #ebebeb;
    --cg-canvas: #ffffff;
    --cg-soft: #fafafa;
    --cg-soft-2: #f5f5f5;
    --cg-link: #0070f3;
    color: var(--cg-ink);
    background: var(--cg-soft);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    font-feature-settings:
      'ss01' 1,
      'ss02' 1;
  }

  .cg-shell {
    width: min(100% - 32px, 1200px);
    margin: 0 auto;
  }

  .cg-hero {
    position: relative;
    overflow: hidden;
    background: var(--cg-canvas);
    border-bottom: 1px solid var(--cg-hairline);
  }

  .cg-hero-art {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cg-hero-art :global(img) {
    display: block;
  }

  .cg-hero-shell {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 760px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 96px 0 80px;
    text-align: center;
  }

  .cg-system-line,
  .cg-mono {
    margin: 0 0 16px;
    color: var(--cg-muted);
    font-family: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0;
  }

  .cg-hero h1,
  .cg-section h2,
  .cg-dark-band h2,
  .cg-cta h2 {
    margin: 0;
    max-width: 920px;
    color: var(--cg-ink);
    font-size: 48px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .cg-hero-copy {
    max-width: 710px;
    margin: 24px 0 0;
    color: var(--cg-body);
    font-size: 18px;
    line-height: 28px;
  }

  .cg-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .cg-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 100px;
    padding: 0 18px;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .cg-button:hover {
    transform: translateY(-1px);
  }

  .cg-button:focus-visible,
  .cg-scenario-copy a:focus-visible,
  .cg-product-table a:focus-visible {
    outline: 3px solid rgba(0, 112, 243, 0.35);
    outline-offset: 4px;
  }

  .cg-button-primary {
    background: var(--cg-ink);
    color: #ffffff;
  }

  .cg-button-secondary {
    border: 1px solid var(--cg-hairline);
    background: var(--cg-canvas);
    color: var(--cg-ink);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.02),
      0 2px 2px rgba(0, 0, 0, 0.04);
  }

  .cg-preview {
    width: min(100%, 1040px);
    margin-top: 72px;
    overflow: hidden;
    border: 1px solid var(--cg-hairline);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.86);
    text-align: left;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.03),
      0 8px 24px -16px rgba(0, 0, 0, 0.16),
      inset 0 0 0 1px rgba(0, 0, 0, 0.02);
    backdrop-filter: blur(18px);
  }

  .cg-preview-top,
  .cg-product-title,
  .cg-code-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--cg-hairline);
    padding: 12px 16px;
    color: var(--cg-muted);
    font-family: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    line-height: 16px;
  }

  .cg-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cg-preview-grid article {
    min-height: 230px;
    padding: 28px;
    border-right: 1px solid var(--cg-hairline);
  }

  .cg-preview-grid article:last-child {
    border-right: 0;
  }

  .cg-preview-grid span {
    color: var(--cg-link);
    font-family: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    line-height: 16px;
  }

  .cg-preview-grid strong {
    display: block;
    margin-top: 18px;
    color: var(--cg-ink);
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
  }

  .cg-preview-grid p,
  .cg-section-heading p,
  .cg-scenario-copy p,
  .cg-dark-band p,
  .cg-cta p {
    margin: 12px 0 0;
    color: var(--cg-body);
    font-size: 16px;
    line-height: 24px;
  }

  .cg-section {
    padding: 96px 0;
  }

  .cg-section-white {
    background: var(--cg-canvas);
  }

  .cg-section-soft {
    background: var(--cg-soft);
    border-top: 1px solid var(--cg-hairline);
    border-bottom: 1px solid var(--cg-hairline);
  }

  .cg-section-heading {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .cg-section h2,
  .cg-dark-band h2,
  .cg-cta h2 {
    max-width: 760px;
    font-size: 32px;
    line-height: 40px;
  }

  .cg-scenarios {
    display: grid;
    gap: 48px;
  }

  .cg-scenario {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: 64px;
    padding: 48px 0;
    border-top: 1px solid var(--cg-hairline);
  }

  .cg-scenario-reverse .cg-scenario-copy {
    order: 2;
  }

  .cg-scenario h3 {
    margin: 0;
    color: var(--cg-ink);
    font-size: 32px;
    font-weight: 600;
    line-height: 40px;
    letter-spacing: 0;
  }

  .cg-scenario-copy a {
    display: inline-flex;
    margin-top: 24px;
    color: var(--cg-link);
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
    text-decoration: none;
  }

  .cg-scenario-copy a:hover {
    text-decoration: underline;
  }

  .cg-product-frame {
    overflow: hidden;
    border: 1px solid var(--cg-hairline);
    border-radius: 12px;
    background: var(--cg-canvas);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.03),
      0 8px 16px -12px rgba(0, 0, 0, 0.14),
      inset 0 0 0 1px rgba(0, 0, 0, 0.02);
  }

  .cg-product-list {
    display: grid;
    gap: 0;
    padding: 12px 0;
  }

  .cg-product-list div {
    display: grid;
    grid-template-columns: 12px 1fr;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid var(--cg-hairline);
    padding: 14px 18px;
  }

  .cg-product-list div:last-child {
    border-bottom: 0;
  }

  .cg-product-list span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #0070f3;
  }

  .cg-product-list code {
    color: var(--cg-ink);
    font-family: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 20px;
  }

  .cg-product-output {
    margin: 0 16px 16px;
    border-radius: 8px;
    background: var(--cg-soft);
    padding: 16px;
    color: var(--cg-body);
    font-size: 14px;
    line-height: 20px;
  }

  .cg-stack-layout {
    display: grid;
    grid-template-columns: 0.42fr 0.58fr;
    gap: 72px;
    align-items: start;
  }

  .cg-product-table {
    border-top: 1px solid var(--cg-hairline);
  }

  .cg-product-table a {
    display: grid;
    grid-template-columns: 0.8fr 0.8fr 1.4fr;
    gap: 24px;
    border-bottom: 1px solid var(--cg-hairline);
    padding: 20px 0;
    color: inherit;
    text-decoration: none;
  }

  .cg-product-table a:hover span:first-child {
    color: var(--cg-link);
  }

  .cg-product-table span {
    color: var(--cg-body);
    font-size: 14px;
    line-height: 20px;
  }

  .cg-product-table span:first-child {
    color: var(--cg-ink);
    font-weight: 500;
  }

  .cg-dark-band {
    background: var(--cg-ink);
    color: #ffffff;
    padding: 96px 0;
  }

  .cg-dark-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: center;
  }

  .cg-dark-band h2,
  .cg-dark-band p {
    color: #ffffff;
  }

  .cg-dark-band p {
    max-width: 620px;
    color: rgba(255, 255, 255, 0.72);
  }

  .cg-button-invert {
    background: #ffffff;
    color: var(--cg-ink);
  }

  .cg-button-dark-secondary {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    color: #ffffff;
  }

  .cg-code-panel {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    background: #050505;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.28),
      0 24px 48px -28px rgba(0, 0, 0, 0.72);
  }

  .cg-code-top {
    border-bottom-color: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.52);
  }

  .cg-code-panel pre {
    margin: 0;
    overflow-x: auto;
    padding: 28px;
  }

  .cg-code-panel code {
    color: #ededed;
    font-family: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 22px;
  }

  .cg-proof {
    display: grid;
    grid-template-columns: 0.42fr 0.58fr;
    gap: 72px;
  }

  .cg-proof-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--cg-hairline);
  }

  .cg-proof-list p {
    margin: 0;
    border-bottom: 1px solid var(--cg-hairline);
    padding: 20px 0;
    color: var(--cg-body);
    font-size: 16px;
    line-height: 24px;
  }

  .cg-cta {
    border-top: 1px solid var(--cg-hairline);
    background: var(--cg-soft);
    padding: 96px 0;
    text-align: center;
  }

  .cg-cta .cg-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cg-cta p {
    max-width: 660px;
  }

  @media (max-width: 900px) {
    .cg-hero-shell {
      min-height: auto;
      padding: 80px 0 64px;
    }

    .cg-hero h1 {
      font-size: 40px;
      line-height: 44px;
    }

    .cg-preview-grid,
    .cg-scenario,
    .cg-stack-layout,
    .cg-dark-grid,
    .cg-proof {
      grid-template-columns: 1fr;
    }

    .cg-preview-grid article {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--cg-hairline);
    }

    .cg-preview-grid article:last-child {
      border-bottom: 0;
    }

    .cg-scenario,
    .cg-dark-grid,
    .cg-stack-layout,
    .cg-proof {
      gap: 32px;
    }

    .cg-scenario-reverse .cg-scenario-copy {
      order: 0;
    }

    .cg-product-table a {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  @media (max-width: 560px) {
    .cg-shell {
      width: min(100% - 24px, 1200px);
    }

    .cg-hero h1 {
      font-size: 36px;
      line-height: 40px;
    }

    .cg-section h2,
    .cg-dark-band h2,
