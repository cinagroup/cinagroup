---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getBlogListLanguageAlternates, getStaticPathsBlogList } from '~/utils/blog';
import { getCanonical } from '~/utils/permalinks';
import { getBlogStrings } from '~/i18n/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const strings = getBlogStrings('en');
const languageAlternates =
  currentPage === 1 ? await getBlogListLanguageAlternates(new URL(String(getCanonical('/'))).origin) : [];

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `${strings.listTitle}${currentPage > 1 ? strings.pageSuffix(currentPage) : ''}`,
  description: strings.listDescription,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
  alternates: languageAlternates,
};
---

<Layout metadata={metadata} languageAlternates={languageAlternates}>
  <section class="cg-blog-index" data-blog-collection="index">
    <Headline subtitle={strings.listSubtitle(page.total)}>{strings.listTitle}</Headline>
    <BlogList posts={page.data} />
    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      prevText={strings.newerPosts}
      nextText={strings.olderPosts}
    />
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
  </section>
</Layout>
