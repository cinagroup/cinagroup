---
import { ENGLISH_PAGE_DEFAULTS } from '~/data/site/english-page-defaults';
import { loadEnglishPageText } from '~/emdash/english-page-text';
import { getPageCopyMetadata } from '~/emdash/published-page-copy';

const copy = await loadEnglishPageText(Astro, 'services', ENGLISH_PAGE_DEFAULTS.services);

import CinaPageHero from '~/components/CinaPageHero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = await getPageCopyMetadata(Astro, {
  title: copy.metadata_title,
  description: copy.metadata_description,
});

const services = [
  {
    label: copy.services_1_label,
    title: copy.services_1_title,
    description: copy.services_1_description,
  },
  {
    label: copy.services_2_label,
    title: copy.services_2_title,
    description: copy.services_2_description,
  },
  {
    label: copy.services_3_label,
    title: copy.services_3_title,
    description: copy.services_3_description,
  },
  {
    label: copy.services_4_label,
    title: copy.services_4_title,
    description: copy.services_4_description,
  },
  {
    label: copy.services_5_label,
    title: copy.services_5_title,
    description: copy.services_5_description,
  },
  {
    label: copy.services_6_label,
    title: copy.services_6_title,
    description: copy.services_6_description,
  },
];
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={copy.hero_eyebrow}
      title={copy.hero_title}
      lead={copy.hero_lead}
      primary={{ text: copy.hero_primary_text, href: '/contact' }}
      secondary={{ text: copy.hero_secondary_text, href: '/' }}
    />

    <section class="cg-page-section" aria-labelledby="services-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.services_eyebrow}</p>
          <h2 id="services-title">{copy.services_heading}</h2>
          <p>
            {copy.services_paragraph}
          </p>
        </div>
        <div class="cg-card-grid">
          {
            services.map((item) => (
              <article class="cg-card">
                <>
                  <p class="cg-card-meta">{item.label}</p>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="delivery-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.delivery_eyebrow}</p>
          <h2 id="delivery-title">{copy.delivery_heading}</h2>
          <p>
            {copy.delivery_paragraph}
          </p>
        </div>
        <div class="cg-list-panel">
          <div class="cg-list-row">
            <strong>{copy.delivery_item_label}</strong><span>{copy.delivery_item_description}</span>
          </div>
          <div class="cg-list-row">
            <strong>{copy.delivery_item_label_2}</strong><span>{copy.delivery_item_description_2}</span>
          </div>
          <div class="cg-list-row">
            <strong>{copy.delivery_item_label_3}</strong><span>{copy.delivery_item_description_3}</span>
          </div>
          <div class="cg-list-row">
            <strong>{copy.delivery_item_label_4}</strong><span>{copy.delivery_item_description_4}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-dark" aria-labelledby="scope-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.scope_eyebrow}</p>
          <h2 id="scope-title">{copy.scope_heading}</h2>
          <p>
            {copy.scope_paragraph}
          </p>
        </div>
        <pre
          class="cg-code-panel"><code>{`brief {
  user        = "who needs the outcome"
  workflow    = "what they are trying to finish"
  systems     = ["current sources", "current tools"]
  constraints = ["access", "risk", "delivery"]
  acceptance  = "observable evidence"
}`}</code></pre>
      </div>
    </section>

    <section class="cg-page-section" aria-labelledby="services-cta-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">{copy.services_cta_eyebrow}</p>
          <h2 id="services-cta-title">{copy.services_cta_heading}</h2>
          <p>
            {copy.services_cta_paragraph}
          </p>
          <div class="cg-page-actions">
            <a class="cg-page-button cg-page-button-primary" href="/contact/">{copy.services_cta_link_label}</a><a
              class="cg-page-button"
              href="/pricing/">{copy.services_cta_link_label_2}</a
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
