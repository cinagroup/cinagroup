---
import CinaPageHero from '~/components/CinaPageHero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services — Product, workflow, and platform delivery',
  description:
    'CinaGroup helps teams audit, design, implement, and harden search, automation, model gateway, and connected infrastructure workflows.',
};

const services = [
  {
    label: '01 / Discover',
    title: 'Product and workflow audit.',
    description:
      'Map the current user journey, systems, content, constraints, and failure points before deciding what to build.',
  },
  {
    label: '02 / Find',
    title: 'Search and knowledge design.',
    description:
      'Define source boundaries, retrieval flows, citations, access rules, and feedback loops for operational search.',
  },
  {
    label: '03 / Automate',
    title: 'Assistant-led workflow design.',
    description:
      'Turn repeatable work into small flows with clear inputs, context gathering, review points, and outcomes.',
  },
  {
    label: '04 / Connect',
    title: 'API and model gateway integration.',
    description:
      'Create understandable service boundaries for credentials, routing, policy, traces, and application integration.',
  },
  {
    label: '05 / Ship',
    title: 'Implementation and release hardening.',
    description:
      'Move from approved design to tested code, observable delivery, deployment checks, and a defined recovery path.',
  },
  {
    label: '06 / Improve',
    title: 'Operational follow-through.',
    description:
      'Use support signals, usage evidence, and workflow outcomes to prioritize the next practical improvement.',
  },
];
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow="Services / from current state to reviewed release."
      title="Make the next product change understandable before it becomes expensive."
      lead="CinaGroup helps teams audit, design, implement, and harden search, automation, gateway, and connected infrastructure workflows."
      primary={{ text: 'Discuss the work', href: '/contact' }}
      secondary={{ text: 'Explore the product stack', href: '/' }}
    />

    <section class="cg-page-section" aria-labelledby="services-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">Service areas.</p>
          <h2 id="services-title">Start with the job, not a generic package.</h2>
          <p>
            Each engagement is scoped around a real workflow and the systems, risks, and review points that make it
            succeed.
          </p>
        </div>
        <div class="cg-card-grid">
          {
            services.map((item) => (
              <article class="cg-card">
                <>
                  <p class="cg-card-meta">{item.label}</p>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="delivery-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">Delivery path.</p>
          <h2 id="delivery-title">Evidence at every handoff.</h2>
          <p>
            We keep the current state, proposed change, implementation boundary, and acceptance evidence visible
            throughout the work.
          </p>
        </div>
        <div class="cg-list-panel">
          <div class="cg-list-row">
            <strong>01 / Audit</strong><span
              >Capture the live experience, source architecture, content risks, accessibility issues, and measurable
              technical constraints.</span
            >
          </div>
          <div class="cg-list-row">
            <strong>02 / Shape</strong><span
              >Translate the findings into a prioritized design and implementation scope tied to user and business
              outcomes.</span
            >
          </div>
          <div class="cg-list-row">
            <strong>03 / Build</strong><span
              >Deliver in reviewable increments with shared patterns, realistic content, and explicit integration
              boundaries.</span
            >
          </div>
          <div class="cg-list-row">
            <strong>04 / Verify</strong><span
              >Run static checks, responsive QA, interaction tests, deployment checks, and production sampling before
              handoff.</span
            >
          </div>
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-dark" aria-labelledby="scope-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">A useful brief.</p>
          <h2 id="scope-title">Bring one workflow and its constraints.</h2>
          <p>
            A strong starting brief names the user, current systems, desired outcome, sensitive actions, deployment
            target, and evidence required for acceptance.
          </p>
        </div>
        <pre
          class="cg-code-panel"><code>{`brief {
  user        = "who needs the outcome"
  workflow    = "what they are trying to finish"
  systems     = ["current sources", "current tools"]
  constraints = ["access", "risk", "delivery"]
  acceptance  = "observable evidence"
}`}</code></pre>
      </div>
    </section>

    <section class="cg-page-section" aria-labelledby="services-cta-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">Next step.</p>
          <h2 id="services-cta-title">Start with the smallest valuable scope.</h2>
          <p>
            Share the workflow that is slow, unclear, fragile, or expensive. We will help identify the first useful
            slice.
          </p>
          <div class="cg-page-actions">
            <a class="cg-page-button cg-page-button-primary" href="/contact">Contact CinaGroup</a><a
              class="cg-page-button"
              href="/pricing">How scoping works</a
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
