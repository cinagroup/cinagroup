---
import CinaPageHero from '~/components/CinaPageHero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Pricing — Scope the work before the quote',
  description:
    'CinaGroup prices work around the workflow, systems, risk, and acceptance evidence required—not a generic template plan.',
};

const engagements = [
  {
    label: 'Focused audit',
    title: 'Understand the current state.',
    note: 'Best for a product, page group, workflow, or technical surface that needs evidence-backed priorities.',
    items: [
      'Source and live-state review',
      'UX, content, accessibility, and technical findings',
      'Prioritized recommendations',
      'Acceptance criteria for the next step',
    ],
    featured: false,
  },
  {
    label: 'Implementation sprint',
    title: 'Deliver one coherent change.',
    note: 'Best when the target, constraints, and desired outcome are understood well enough to build and verify.',
    items: [
      'Design and implementation scope',
      'Shared component and content work',
      'Responsive and interaction QA',
      'Build, deployment, and production checks',
    ],
    featured: true,
  },
  {
    label: 'Ongoing engineering',
    title: 'Improve a system over time.',
    note: 'Best for products that need iterative delivery, integration work, operational follow-through, and release discipline.',
    items: [
      'Prioritized delivery queue',
      'Incremental design and engineering',
      'Integration and deployment support',
      'Recurring review and optimization',
    ],
    featured: false,
  },
];
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow="Pricing / clear scope before commitment."
      title="Price the work around the outcome, not a template."
      lead="The right scope depends on the workflow, systems, risk, integration depth, and evidence required for acceptance. We make those inputs visible before quoting."
      primary={{ text: 'Request a scoped conversation', href: '/contact' }}
      secondary={{ text: 'Review services', href: '/services' }}
    />

    <section class="cg-page-section" aria-labelledby="engagements-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">Engagement shapes.</p>
          <h2 id="engagements-title">Three ways to start.</h2>
          <p>
            These are working shapes, not fixed bundles. The scope is confirmed against the actual product and delivery
            environment.
          </p>
        </div>
        <div class="cg-pricing-grid">
          {
            engagements.map((engagement) => (
              <article class:list={['cg-price-card', { 'cg-price-card-featured': engagement.featured }]}>
                <p class="cg-card-meta">{engagement.label}</p>
                <h3>{engagement.title}</h3>
                <p>{engagement.note}</p>
                <ul>
                  {engagement.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <a class:list={['cg-page-button', { 'cg-page-button-primary': !engagement.featured }]} href="/contact">
                  Scope this work
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="scope-factors-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">What shapes the quote.</p>
          <h2 id="scope-factors-title">Make the cost drivers explicit.</h2>
        </div>
        <div class="cg-list-panel">
          <div class="cg-list-row">
            <strong>Workflow breadth</strong><span
              >Number of user journeys, page archetypes, roles, locales, and states included in the acceptance scope.</span
            >
          </div>
          <div class="cg-list-row">
            <strong>System depth</strong><span
              >Existing architecture, data sources, APIs, authentication, infrastructure, and migration requirements.</span
            >
          </div>
          <div class="cg-list-row">
            <strong>Risk and review</strong><span
              >Security, privacy, legal, financial, destructive, or externally visible actions that need stronger
              controls.</span
            >
          </div>
          <div class="cg-list-row">
            <strong>Delivery evidence</strong><span
              >Automated checks, browser coverage, environments, deployment targets, production validation, and
              documentation.</span
            >
          </div>
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-dark" aria-labelledby="pricing-process-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">Before a quote.</p>
          <h2 id="pricing-process-title">A short discovery reduces expensive assumptions.</h2>
          <p>
            We confirm the current state, desired outcome, in-scope systems, exclusions, dependencies, and acceptance
            evidence before proposing the work.
          </p>
        </div>
        <div class="cg-page-actions" style="justify-content: flex-start;">
          <a class="cg-page-button" href="/contact">Start the conversation</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
