---
import { ENGLISH_PAGE_DEFAULTS } from '~/data/site/english-page-defaults';
import { loadEnglishPageText } from '~/emdash/english-page-text';
import { getPageCopyMetadata } from '~/emdash/published-page-copy';

const copy = await loadEnglishPageText(Astro, 'pricing', ENGLISH_PAGE_DEFAULTS.pricing);

import CinaPageHero from '~/components/CinaPageHero.astro';
import Pricing from '~/components/marketing/Pricing.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = await getPageCopyMetadata(Astro, {
  title: copy.metadata_title,
  description: copy.metadata_description,
});

const engagements = [
  {
    label: copy.engagements_1_label,
    title: copy.engagements_1_title,
    note: copy.engagements_1_note,
    items: [
      copy.engagements_1_items_1,
      copy.engagements_1_items_2,
      copy.engagements_1_items_3,
      copy.engagements_1_items_4,
    ],
    budget: 'Written quote after scope confirmation',
    timeline: 'Usually 1–3 weeks',
    included: 'The agreed review surface, findings, a readout, and prioritized next steps.',
    excluded: 'Implementation, third-party testing fees, travel, and paid tools unless written into scope.',
    featured: false,
  },
  {
    label: copy.engagements_2_label,
    title: copy.engagements_2_title,
    note: copy.engagements_2_note,
    items: [
      copy.engagements_2_items_1,
      copy.engagements_2_items_2,
      copy.engagements_2_items_3,
      copy.engagements_2_items_4,
    ],
    budget: 'Written quote after scope confirmation',
    timeline: 'Usually 4–10 weeks',
    included: 'One agreed outcome, implementation, review, QA, and release evidence for the named environments.',
    excluded: 'New product areas, ongoing operations, external licenses, data migration, and support outside scope.',
    featured: true,
  },
  {
    label: copy.engagements_3_label,
    title: copy.engagements_3_title,
    note: copy.engagements_3_note,
    items: [
      copy.engagements_3_items_1,
      copy.engagements_3_items_2,
      copy.engagements_3_items_3,
      copy.engagements_3_items_4,
    ],
    budget: 'Written quote after scope confirmation',
    timeline: 'Monthly planning; often a 3-month initial window',
    included: 'An agreed capacity band, prioritized delivery queue, recurring review, and release support.',
    excluded: 'Unused capacity rollover, vendor charges, 24/7 support, hardware, travel, and unplanned major projects.',
    featured: false,
  },
];
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={copy.hero_eyebrow}
      title={copy.hero_title}
      lead={copy.hero_lead}
      primary={{ text: copy.hero_primary_text, href: '/contact/' }}
      secondary={{ text: copy.hero_secondary_text, href: '/services/' }}
    />

    <Pricing
      value={{
        anchor_id: 'engagements-title',
        headline: copy.value_headline,
        plans: engagements.map((engagement) => ({
          name: engagement.label,
          description: `${engagement.title} ${engagement.note}`,
          features: engagement.items.join('\n'),
          cta_label: copy.value_plans_cta_label,
          cta_url: '/contact/',
          highlighted: engagement.featured,
          quote: {
            budget: engagement.budget,
            timeline: engagement.timeline,
            included: engagement.included,
            excluded: engagement.excluded,
          },
        })),
      }}
    />
    <p class="cg-pricing-terms">
      All engagements are proposal-based. After scope, dependencies, acceptance criteria, and delivery location are
      confirmed, the written proposal will state the quote, currency, applicable taxes, and any third-party charges
      before work begins.
    </p>
    <section class="cg-page-section cg-page-section-soft" aria-labelledby="scope-factors-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.scope_factors_eyebrow}</p>
          <h2 id="scope-factors-title">{copy.scope_factors_heading}</h2>
        </div>
        <div class="cg-list-panel">
          <div class="cg-list-row">
            <strong>{copy.scope_factors_item_label}</strong><span>{copy.scope_factors_item_description}</span>
          </div>
          <div class="cg-list-row">
            <strong>{copy.scope_factors_item_label_2}</strong><span>{copy.scope_factors_item_description_2}</span>
          </div>
          <div class="cg-list-row">
            <strong>{copy.scope_factors_item_label_3}</strong><span>{copy.scope_factors_item_description_3}</span>
          </div>
          <div class="cg-list-row">
            <strong>{copy.scope_factors_item_label_4}</strong><span>{copy.scope_factors_item_description_4}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-dark" aria-labelledby="pricing-process-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.pricing_process_eyebrow}</p>
          <h2 id="pricing-process-title">{copy.pricing_process_heading}</h2>
          <p>
            {copy.pricing_process_paragraph}
          </p>
        </div>
        <div class="cg-page-actions" style="justify-content: flex-start;">
          <a class="cg-page-button" href="/contact/">{copy.pricing_process_link_label}</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
