---
import { getEmDashEntry } from 'emdash';
import { env } from 'cloudflare:workers';

import EmDashPost from '~/components/blog/EmDashPost.astro';
import { findLegacyArticle, isPublicPostLocale, isPublicPostSlug, publicPostFromEntry, type AssetFetcher } from '~/emdash/public-post';

export const prerender = false;

const locale = Astro.params.lang;
const slug = Astro.params.slug;
if (!locale || locale === 'en' || !isPublicPostLocale(locale) || !slug || !isPublicPostSlug(slug)) {
  return new Response('Not found', { status: 404 });
}

// Preserve every prerendered localized legacy article before consulting the CMS.
const legacyAsset = await findLegacyArticle(Astro.request, (env as unknown as { ASSETS: AssetFetcher }).ASSETS);
if (legacyAsset) return legacyAsset;

const { entry, error, isPreview, fallbackLocale } = await getEmDashEntry('posts', slug, { locale });
if (error) {
  console.error('Unable to read published EmDash post', error);
  return new Response('Content unavailable', { status: 500 });
}

const post = publicPostFromEntry(entry, locale, slug, { isPreview, fallbackLocale });
if (!post) return new Response('Not found', { status: 404 });
---

<EmDashPost post={post} />
