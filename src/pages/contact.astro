---
import CinaPageHero from '~/components/CinaPageHero.astro';
import ContactSubmissionForm from '~/components/ContactSubmissionForm.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact CinaGroup — Start with one workflow',
  description: 'Tell CinaGroup about the user, workflow, systems, constraints, and outcome you want to improve.',
};
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow="Contact / start with the work."
      title="Tell us what your team is trying to move."
      lead="Share the user, workflow, current systems, constraints, and outcome. We will use that context to identify a sensible first scope."
      primary={{ text: 'Start an inquiry', href: '#contact-form' }}
      secondary={{ text: 'Review services', href: '/services/' }}
    />

    <section class="cg-page-section" aria-labelledby="contact-form-title">
      <div class="cg-page-shell cg-contact-grid">
        <div>
          <div class="cg-section-heading">
            <p class="cg-eyebrow">A useful first message.</p>
            <h2 id="contact-form-title">Give us enough context to respond usefully.</h2>
            <p>
              A submission is confirmed only after it has been securely recorded. Keep the returned reference for
              follow-up.
            </p>
          </div>
          <div class="cg-list-panel">
            <div class="cg-list-row">
              <strong>User</strong><span>Who needs the outcome, and what are they trying to finish?</span>
            </div>
            <div class="cg-list-row">
              <strong>Current state</strong><span>What product, page, workflow, or system exists today?</span>
            </div>
            <div class="cg-list-row">
              <strong>Constraints</strong><span
                >What access, timing, integration, risk, or deployment boundaries matter?</span
              >
            </div>
            <div class="cg-list-row">
              <strong>Acceptance</strong><span>What observable evidence would show that the change worked?</span>
            </div>
          </div>
        </div>

        <ContactSubmissionForm lang="en" />
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="other-routes-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">Other routes.</p><h2 id="other-routes-title">Follow the work in public.</h2>
        </div><div class="cg-card-grid">
          <article class="cg-card">
            <p class="cg-card-meta">Email.</p><h3>info@cinagroup.com</h3><p>
              Use email for product, service, partnership, and support conversations.
            </p>
          </article><article class="cg-card">
            <p class="cg-card-meta">GitHub.</p><h3>github.com/cinagroup</h3><p>
              Review public repositories, releases, and technical work.
            </p>
          </article><article class="cg-card">
            <p class="cg-card-meta">Updates.</p><h3>CinaGroup blog.</h3><p>
              Read product notes, engineering updates, and operating guidance.
            </p>
          </article>
        </div>
      </div>
    </section>
  </div>
</Layout>
