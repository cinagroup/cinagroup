---
import CinaPageHero from '~/components/CinaPageHero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact CinaGroup — Start with one workflow',
  description: 'Tell CinaGroup about the user, workflow, systems, constraints, and outcome you want to improve.',
};
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow="Contact / start with the work."
      title="Tell us what your team is trying to move."
      lead="Share the user, workflow, current systems, constraints, and outcome. We will use that context to identify a sensible first scope."
      primary={{ text: 'Email info@cinagroup.com', href: 'mailto:info@cinagroup.com' }}
      secondary={{ text: 'Review services', href: '/services' }}
    />

    <section class="cg-page-section" aria-labelledby="contact-form-title">
      <div class="cg-page-shell cg-contact-grid">
        <div>
          <div class="cg-section-heading">
            <p class="cg-eyebrow">A useful first message.</p>
            <h2 id="contact-form-title">Give us enough context to respond usefully.</h2>
            <p>The form opens a draft in your email app. This website does not submit or store the message.</p>
          </div>
          <div class="cg-list-panel">
            <div class="cg-list-row">
              <strong>User</strong><span>Who needs the outcome, and what are they trying to finish?</span>
            </div>
            <div class="cg-list-row">
              <strong>Current state</strong><span>What product, page, workflow, or system exists today?</span>
            </div>
            <div class="cg-list-row">
              <strong>Constraints</strong><span
                >What access, timing, integration, risk, or deployment boundaries matter?</span
              >
            </div>
            <div class="cg-list-row">
              <strong>Acceptance</strong><span>What observable evidence would show that the change worked?</span>
            </div>
          </div>
        </div>

        <form
          class="cg-form-card"
          action="mailto:info@cinagroup.com"
          method="POST"
          enctype="text/plain"
          data-contact-form
        >
          <div class="cg-field">
            <label for="name">Name</label><input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="cg-field">
            <label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="cg-field">
            <label for="company">Company or team <span>(optional)</span></label><input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
            />
          </div>
          <div class="cg-field">
            <label for="subject">Area</label><select id="subject" name="subject" required
              ><option value="">Choose an area</option><option value="Product workflow">Product workflow</option><option
                value="Search and knowledge">Search and knowledge</option
              ><option value="Automation">Automation</option><option value="API and model gateway"
                >API and model gateway</option
              ><option value="Infrastructure and delivery">Infrastructure and delivery</option><option value="Other"
                >Other</option
              ></select
            >
          </div>
          <div class="cg-field">
            <label for="message">Workflow and desired outcome</label><textarea
              id="message"
              name="message"
              rows="7"
              required></textarea>
          </div>
          <button class="cg-page-button cg-page-button-primary" type="submit">Open email draft</button>
          <p class="cg-form-note">
            By continuing, you choose what to send through your email provider. Read the <a href="/privacy"
              >Privacy Policy</a
            > and <a href="/terms">Terms of Service</a>.
          </p>
          <p id="contact-form-status" class="cg-form-status" aria-live="polite" hidden></p>
        </form>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="other-routes-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">Other routes.</p><h2 id="other-routes-title">Follow the work in public.</h2>
        </div><div class="cg-card-grid">
          <article class="cg-card">
            <p class="cg-card-meta">Email.</p><h3>info@cinagroup.com</h3><p>
              Use email for product, service, partnership, and support conversations.
            </p>
          </article><article class="cg-card">
            <p class="cg-card-meta">GitHub.</p><h3>github.com/cinagroup</h3><p>
              Review public repositories, releases, and technical work.
            </p>
          </article><article class="cg-card">
            <p class="cg-card-meta">Updates.</p><h3>CinaGroup blog.</h3><p>
              Read product notes, engineering updates, and operating guidance.
            </p>
          </article>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    (() => {
      const initContactForm = () => {
        const form = /** @type {HTMLFormElement | null} */ (document.querySelector('form[data-contact-form]'));
        if (!form || form.dataset.initialized) return;
        form.dataset.initialized = 'true';
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const data = new FormData(form);
          const subject = `[CinaGroup] ${String(data.get('subject') || 'Project inquiry')}`;
          const body = [
            `Name: ${String(data.get('name') || '')}`,
            `Email: ${String(data.get('email') || '')}`,
            `Company or team: ${String(data.get('company') || 'Not provided')}`,
            '',
            String(data.get('message') || ''),
          ].join('\n');
          const status = document.getElementById('contact-form-status');
          if (status) {
            status.hidden = false;
            status.textContent = 'Your email draft is opening. If nothing happens, email info@cinagroup.com directly.';
          }
          window.location.href = `mailto:info@cinagroup.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        });
      };
      initContactForm();
      document.addEventListener('astro:page-load', initContactForm);
    })();
  </script>
</Layout>
