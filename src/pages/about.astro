---
import { ENGLISH_PAGE_DEFAULTS } from '~/data/site/english-page-defaults';
import { loadEnglishPageText } from '~/emdash/english-page-text';
import { getPageCopyMetadata } from '~/emdash/published-page-copy';

const copy = await loadEnglishPageText(Astro, 'about', ENGLISH_PAGE_DEFAULTS.about);

import CinaPageHero from '~/components/CinaPageHero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = await getPageCopyMetadata(Astro, {
  title: copy.metadata_title,
  description: copy.metadata_description,
});
---

<Layout metadata={metadata}>
  <div class="cg-page">
    <CinaPageHero
      eyebrow={copy.hero_eyebrow}
      title={copy.hero_title}
      lead={copy.hero_lead}
      primary={{ text: copy.hero_primary_text, href: '/#scenarios' }}
      secondary={{ text: copy.hero_secondary_text, href: '/contact' }}
    />

    <section class="cg-page-section" aria-labelledby="mission-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.mission_eyebrow}</p>
          <h2 id="mission-title">{copy.mission_heading}</h2>
          <p>
            {copy.mission_paragraph}
          </p>
        </div>
        <div class="cg-card-grid">
          <article class="cg-card">
            <p class="cg-card-meta">{copy.mission_card_label}</p><h3>{copy.mission_heading_2}</h3><p>
              {copy.mission_paragraph_2}
            </p>
          </article>
          <article class="cg-card">
            <p class="cg-card-meta">{copy.mission_card_label_2}</p><h3>{copy.mission_heading_3}</h3><p>
              {copy.mission_paragraph_3}
            </p>
          </article>
          <article class="cg-card">
            <p class="cg-card-meta">{copy.mission_card_label_3}</p><h3>{copy.mission_heading_4}</h3><p>
              {copy.mission_paragraph_4}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-soft" aria-labelledby="stack-map-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.stack_map_eyebrow}</p>
          <h2 id="stack-map-title">{copy.stack_map_heading}</h2>
          <p>
            {copy.stack_map_paragraph}
          </p>
        </div>
        <div class="cg-list-panel">
          <a class="cg-list-row" href="/cinaseek/"
            ><strong>{copy.stack_map_item_label}</strong><span>{copy.stack_map_item_description}</span></a
          >
          <a class="cg-list-row" href="/cinaclaw/"
            ><strong>{copy.stack_map_item_label_2}</strong><span>{copy.stack_map_item_description_2}</span></a
          >
          <a class="cg-list-row" href="/cinatoken/"
            ><strong>{copy.stack_map_item_label_3}</strong><span>{copy.stack_map_item_description_3}</span></a
          >
          <a class="cg-list-row" href="/cinaskill/"
            ><strong>{copy.stack_map_item_label_4}</strong><span>{copy.stack_map_item_description_4}</span></a
          >
          <a class="cg-list-row" href="/cinachain/"
            ><strong>{copy.stack_map_item_label_5}</strong><span>{copy.stack_map_item_description_5}</span></a
          >
        </div>
      </div>
    </section>

    <section class="cg-page-section cg-page-section-dark" aria-labelledby="working-model-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading">
          <p class="cg-eyebrow">{copy.working_model_eyebrow}</p>
          <h2 id="working-model-title">{copy.working_model_heading}</h2>
          <p>
            {copy.working_model_paragraph}
          </p>
        </div>
        <pre
          class="cg-code-panel"><code>{`delivery {
  current_state = "captured"
  target        = "agreed"
  change        = "reviewable"
  evidence      = "observable"
}`}</code></pre>
      </div>
    </section>

    <section class="cg-page-section" aria-labelledby="about-cta-title">
      <div class="cg-page-shell">
        <div class="cg-section-heading cg-section-heading-center">
          <p class="cg-eyebrow">{copy.about_cta_eyebrow}</p><h2 id="about-cta-title">{copy.about_cta_heading}</h2><p>
            {copy.about_cta_paragraph}
          </p><div class="cg-page-actions">
            <a class="cg-page-button cg-page-button-primary" href="/contact/">{copy.about_cta_link_label}</a><a
              class="cg-page-button"
              href="/services/">{copy.about_cta_link_label_2}</a
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
