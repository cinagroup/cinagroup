{
  "name": "@cinagroup/cinagroup",
  "version": "1.0.0",
  "description": "CinaGroup official website — built with Astro 5 and Tailwind CSS",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/clean-dist.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "audit:build": "node scripts/audit-build.mjs",
    "audit:blog": "node scripts/audit-blog-structured-data.mjs",
    "audit:blog:source": "node scripts/audit-blog-structured-data.mjs --source-only",
    "audit:content": "node scripts/audit-content-governance.mjs",
    "audit:content:source": "node scripts/audit-content-governance.mjs --source-only",
    "audit:evidence": "node scripts/audit-public-evidence.mjs",
    "audit:evidence:source": "node scripts/audit-public-evidence.mjs --source-only",
    "audit:i18n": "node scripts/audit-i18n-routes.mjs",
    "audit:source": "npm run audit:blog:source && npm run audit:content:source && npm run audit:evidence:source && npm run audit:i18n",
    "check:cloudflare": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --include-runtime false --check && tsc -p functions/tsconfig.json --noEmit && wrangler pages functions build --outdir .wrangler/functions-build",
    "test:contact": "node --test tests/contact-core.test.mjs",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.2",
    "@astrolib/analytics": "^0.6.1",
    "@astrolib/seo": "^1.0.0-beta.8",
    "@fontsource-variable/inter": "^5.2.6",
    "astro": "^5.12.9",
    "astro-embed": "^0.9.0",
    "astro-icon": "^1.1.5",
    "limax": "4.1.0",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.3",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/tailwind": "^5.1.5",
    "@cloudflare/workers-types": "5.20260830.1",
    "@eslint/js": "^9.33.0",
    "@iconify-json/flat-color-icons": "^1.2.1",
    "@iconify-json/tabler": "^1.2.20",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "astro-compress": "2.3.8",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.3.0",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "0.34.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "unist-util-visit": "^5.0.0",
    "wrangler": "4.127.1"
  }
}
